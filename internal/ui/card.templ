package ui

import "strings"

type CardProps struct {
	Accent  string
	Attrs   templ.Attributes
}

templ Card(p CardProps) {
	<div class={ cx("rounded-xl border border-sand-200 bg-white dark:border-zinc-700 dark:bg-zinc-900 p-5 overflow-hidden", cardAccent(p.Accent)) } { p.Attrs... }>
		{ children... }
	</div>
}

func cardAccent(accent string) string {
	if strings.TrimSpace(accent) == "" {
		return ""
	}
	return cx("border-t-4", accent)
}
