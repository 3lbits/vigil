package ui

type TableProps struct {
	Attrs templ.Attributes
}

type THeadProps struct {
	Attrs templ.Attributes
}

type TrProps struct {
	Attrs templ.Attributes
}

type ThProps struct {
	Attrs templ.Attributes
}

type TdProps struct {
	Attrs templ.Attributes
}

templ Table(p TableProps) {
	<table class="w-full border-collapse text-[13px]" { p.Attrs... }>
		{ children... }
	</table>
}

templ THead(p THeadProps) {
	<thead class="bg-sand-50 dark:bg-zinc-900" { p.Attrs... }>
		{ children... }
	</thead>
}

templ Tr(p TrProps) {
	<tr class="border-t border-sand-200 dark:border-zinc-700 hover:bg-sand-50/50 dark:hover:bg-zinc-800/50" { p.Attrs... }>
		{ children... }
	</tr>
}

templ Th(p ThProps) {
	<th class="px-3 py-2 text-left font-medium text-sand-700 dark:text-zinc-300" { p.Attrs... }>
		{ children... }
	</th>
}

templ Td(p TdProps) {
	<td class="px-3 py-2 align-top text-sand-800 dark:text-zinc-200" { p.Attrs... }>
		{ children... }
	</td>
}

templ TableNew(label string) {
	<div class="w-full overflow-x-auto" tabindex="0" role="region" aria-label={ label }>
		<table class="w-full min-w-[640px] table-fixed border-collapse text-left">
		//<caption class="caption-top">{ label }</caption>
		{ children... }
		</table>
	</div>
}

templ TableHeader() {
	<thead>
		<tr class="bg-sand-50 dark:bg-zinc-800 text-[10px] font-semibold uppercase tracking-wide text-sand-700 dark:text-zinc-400">
		{ children... }
		</tr>
	</thead>
}

templ TableHeaderCell() {
	<th scope="col" class="px-4 py-2.5">
		{ children... }
	</th>
}

templ TableBody() {
	<tbody>
		{ children... }
	</tbody>
}

templ TableRow() {
	<tr class="relative border-t border-sand-200 dark:border-zinc-700 even:bg-sand-50/50 dark:even:bg-zinc-800/30 hover:bg-sand-50 dark:hover:bg-zinc-800/60 transition-colors">
		{ children... }
	</tr>
}

templ TableDataCell() {
	<td class="px-4 py-3 align-middle font-mono text-[11px] text-sand-700 dark:text-zinc-400 whitespace-nowrap">
	 { children... }
	</td>
}