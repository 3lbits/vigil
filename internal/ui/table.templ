package ui

type TableProps struct {
	Attrs templ.Attributes
}

type THeadProps struct {
	Attrs templ.Attributes
}

type TrProps struct {
	Attrs templ.Attributes
}

type ThProps struct {
	Attrs templ.Attributes
}

type TdProps struct {
	Attrs templ.Attributes
}

templ Table(p TableProps) {
	<table class="w-full border-collapse text-[13px]" { p.Attrs... }>
		{ children... }
	</table>
}

templ THead(p THeadProps) {
	<thead class="bg-sand-50 dark:bg-zinc-900" { p.Attrs... }>
		{ children... }
	</thead>
}

templ Tr(p TrProps) {
	<tr class="border-t border-sand-200 dark:border-zinc-700 hover:bg-sand-50/50 dark:hover:bg-zinc-800/50" { p.Attrs... }>
		{ children... }
	</tr>
}

templ Th(p ThProps) {
	<th class="px-3 py-2 text-left font-medium text-sand-700 dark:text-zinc-300" { p.Attrs... }>
		{ children... }
	</th>
}

templ Td(p TdProps) {
	<td class="px-3 py-2 align-top text-sand-800 dark:text-zinc-200" { p.Attrs... }>
		{ children... }
	</td>
}
