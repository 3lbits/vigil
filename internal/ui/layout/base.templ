package layout

import (
	"context"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/middleware"
	"github.com/3lbits/vigil/internal/ui"
)

type NavItem struct {
	Key   string
	Icon  string
	Label string
	Href  string
}

type NavGroup struct {
	Section string
	Items   []NavItem
}

func navGroups(ctx context.Context, isAdmin bool, flags middleware.ModuleFlags) []NavGroup {
	controlItems := []NavItem{
		{Key: "measures", Icon: "shield", Label: locale.T(ctx, "nav_measures"), Href: "/measures"},
	}
	if flags.ActivitiesEnabled {
		controlItems = append(controlItems, NavItem{Key: "activities", Icon: "calendar", Label: locale.T(ctx, "nav_activities"), Href: "/activities"})
	}
	groups := []NavGroup{
		{Section: locale.T(ctx, "nav_section_overview"), Items: []NavItem{
			{Key: "dashboard", Icon: "dashboard", Label: locale.T(ctx, "nav_dashboard"), Href: "/"},
		}},
		{Section: locale.T(ctx, "nav_section_controls"), Items: controlItems},
	}
	if flags.RiskEnabled {
		riskItems := []NavItem{
			{Key: "risk", Icon: "risk", Label: locale.T(ctx, "nav_risk_assessments"), Href: "/risks"},
			{Key: "risk-register", Icon: "risk", Label: locale.T(ctx, "nav_risk_register"), Href: "/risk-register"},
		}
		if flags.AvvikEnabled {
			riskItems = append(riskItems, NavItem{Key: "avvik", Icon: "risk", Label: locale.T(ctx, "nav_avvik"), Href: "/avvik"})
		}
		groups = append(groups, NavGroup{Section: locale.T(ctx, "nav_section_risk"), Items: riskItems})
	}
	if flags.AssetsEnabled {
		groups = append(groups, NavGroup{Section: locale.T(ctx, "nav_section_assets"), Items: []NavItem{
			{Key: "assets", Icon: "package", Label: locale.T(ctx, "nav_assets_inventory"), Href: "/assets"},
		}})
	}
	if flags.ComplianceEnabled {
		groups = append(groups, NavGroup{Section: locale.T(ctx, "nav_section_compliance"), Items: []NavItem{
			{Key: "compliance", Icon: "compliance", Label: locale.T(ctx, "nav_compliance"), Href: "/compliance"},
		}})
	}
	groups = append(groups, NavGroup{Section: locale.T(ctx, "nav_section_info"), Items: []NavItem{
		{Key: "me", Icon: "users", Label: locale.T(ctx, "nav_my_page"), Href: "/me"},
		{Key: "about", Icon: "info", Label: locale.T(ctx, "nav_about"), Href: "/about"},
	}})
	if isAdmin {
		groups = append(groups, NavGroup{Section: locale.T(ctx, "nav_section_administration"), Items: []NavItem{
			{Key: "admin", Icon: "users", Label: locale.T(ctx, "nav_admin"), Href: "/admin"},
		}})
	}
	return groups
}

func UserInitials(name string) string {
	if name == "" {
		return "?"
	}
	runes := []rune(name)
	if len(runes) >= 2 {
		return string(runes[0:1]) + string(runes[1:2])
	}
	return string(runes[0:1])
}

templ Layout(title string, subtitle string, activePage string, user middleware.SessionUser, content templ.Component) {
	@layoutFrame(title, subtitle, activePage, user, content)
}

templ layoutFrame(title string, subtitle string, activePage string, user middleware.SessionUser, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ locale.LangFromContext(ctx) }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ middleware.TopOrgNameFromContext(ctx) } — { title }</title>
		<meta name="csrf-token" content={ csrf.TokenFromContext(ctx) }/>
		<meta name="mermaid-integrity" content={ MermaidIntegrity }/>
		<link rel="stylesheet" href={ "/public/css/output.css?v=" + AssetVer }/>
		<script nonce={ middleware.CSPNonceFromContext(ctx) }>(function(){var d=localStorage.getItem('darkMode');if(d==='true')document.documentElement.classList.add('dark');})()</script>
		<script src={ "/public/js/alpine-data.js?v=" + AssetVer } defer></script>
		<script src={ "/public/js/alpine.min.js?v=" + AssetVer } integrity={ AlpineIntegrity } defer></script>
		<meta name="htmx-config" content='{"includeIndicatorStyles": false}'/>
		<script src={ "/public/js/htmx.min.js?v=" + AssetVer } integrity={ HTMXIntegrity }></script>
		<script nonce={ middleware.CSPNonceFromContext(ctx) }>
			document.addEventListener("htmx:configRequest", function(e) {
				var t = document.querySelector('meta[name="csrf-token"]');
				if (t) { e.detail.headers["X-CSRF-Token"] = t.content; }
			});
		</script>
	</head>
	<body class="ui2-shell">
		<a href="#main-content" class="skip-link">{ locale.T(ctx, "action_skip_to_main") }</a>
		<div
			x-data="appLayout"
			@keydown.window.escape="sidebarOpen = false"
			class="app-frame"
		>
			<!-- Mobile overlay -->
			<div
				x-show="sidebarOpen"
				x-cloak
				aria-hidden="true"
				@click="sidebarOpen = false"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="sidebar-overlay"
			></div>

			<!-- Sidebar -->
			<aside
				aria-label="Sidebar"
				:class="sidebarOpen ? 'is-open' : ''"
				class="app-sidebar"
			>
				<!-- Logo -->
				<header class="sidebar-brand">
					<div class="sidebar-logo">
						@ui.IconSVG("eye", 13)
					</div>
					<a href="/" @click="sidebarOpen = false" class="sidebar-brand-link">
						<div class="sidebar-brand-name">Vigil</div>
						<div class="sidebar-small sidebar-truncate">{ middleware.TopOrgNameFromContext(ctx) }</div>
					</a>
					<button x-ref="closeBtn" aria-label={ locale.T(ctx, "action_close_menu") } @click="sidebarOpen = false" class="sidebar-close">
						@ui.IconSVG("x", 16)
					</button>
				</header>

				<!-- Nav groups -->
				<nav aria-label="Main navigation" class="sidebar-nav">
					for _, group := range navGroups(ctx, user.Role == "admin", middleware.ModuleFlagsFromContext(ctx)) {
						<section class="sidebar-nav-group">
							<h2>{ group.Section }</h2>
							<ul>
								for _, item := range group.Items {
									<li>
										<a
											href={ templ.SafeURL(item.Href) }
											@click="sidebarOpen = false"
											if activePage == item.Key {
												aria-current="page"
											}
											class="sidebar-nav-link"
										>
											@ui.IconSVG(item.Icon, 15)
											{ item.Label }
										</a>
									</li>
								}
							</ul>
						</section>
					}
				</nav>

				<footer class="sidebar-account">
					<div class="sidebar-account-inner">
						<div class="sidebar-user">
							<div aria-hidden="true" class="sidebar-avatar">
								{ UserInitials(user.Name) }
							</div>
							<div class="sidebar-user-info">
								<div class="sidebar-user-name sidebar-truncate">{ user.Name }</div>
								<div class="sidebar-user-meta">
									<span class="sidebar-truncate">{ user.Email }</span>
									<span class="sidebar-role">{ user.Role }</span>
								</div>
							</div>
							<div class="sidebar-user-actions">
								<button
									type="button"
									@click="darkMode = !darkMode"
									aria-label={ locale.T(ctx, "action_toggle_dark_mode") }
									class="sidebar-icon-button"
								>
									<span x-show="!darkMode">@ui.IconSVG("moon", 15)</span>
									<span x-show="darkMode" x-cloak>@ui.IconSVG("sun", 15)</span>
								</button>
								<form method="POST" action="/logout">
									<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
									<button type="submit" aria-label={ locale.T(ctx, "action_sign_out") } class="sidebar-icon-button">
										@ui.IconSVG("logout", 15)
									</button>
								</form>
							</div>
						</div>
						<form method="POST" action="/locale" class="sidebar-locale">
							<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
							<button
								type="submit"
								name="lang"
								value="nb"
								aria-label={ locale.T(ctx, "lang_switch_nb") }
								class={ "sidebar-locale-button", templ.KV("is-active", locale.LangFromContext(ctx) == locale.LangNB) }
							>NB</button>
							<button
								type="submit"
								name="lang"
								value="nn"
								aria-label={ locale.T(ctx, "lang_switch_nn") }
								class={ "sidebar-locale-button", templ.KV("is-active", locale.LangFromContext(ctx) == locale.LangNN) }
							>NN</button>
							<button
								type="submit"
								name="lang"
								value="en"
								aria-label={ locale.T(ctx, "lang_switch_en") }
								class={ "sidebar-locale-button", templ.KV("is-active", locale.LangFromContext(ctx) == locale.LangEN) }
							>EN</button>
						</form>
						if middleware.DevStubAuthFromContext(ctx) {
							<form method="POST" action="/dev/role" class="sidebar-dev-role">
								<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
								<label for="dev-role-switcher">{ locale.T(ctx, "dev_role_switcher_label") }</label>
								<div class="sidebar-dev-controls">
									<select
										id="dev-role-switcher"
										name="role"
									>
										for _, role := range []string{"admin", "editor", "viewer", "contributor"} {
											<option value={ role } selected?={ user.Role == role }>{ role }</option>
										}
									</select>
									<button type="submit">
										{ locale.T(ctx, "action_switch_role") }
									</button>
								</div>
							</form>
						}
					</div>
				</footer>
			</aside>

			<!-- Main -->
			<main id="main-content" class="app-main">
				<div class="app-content">
					<!-- Page header -->
					<header class="app-page-header">
						<button type="button" aria-label={ locale.T(ctx, "action_open_menu") } @click="sidebarOpen = true" class="app-menu-button">
							@ui.IconSVG("menu", 16)
						</button>
						<div>
							<h1>{ locale.T(ctx, title) }</h1>
							<p>{ locale.T(ctx, subtitle) }</p>
						</div>
					</header>

					<!-- Page content -->
					@content
				</div>
			</main>
		</div>
	</body>
	</html>
}
