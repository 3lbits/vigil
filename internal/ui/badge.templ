package ui

import (
	"github.com/3lbits/vigil/internal/locale"
)

type BadgeProps struct {
	Variant string
	Class   string
	Attrs   templ.Attributes
}

var badgeVariants = map[string]string{
	"default":     "bg-sand-100 dark:bg-zinc-800 text-sand-700 dark:text-zinc-300 border border-sand-300 dark:border-zinc-600",
	"success":     "bg-green-50 dark:bg-green-950 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800",
	"warning":     "bg-amber-50 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800",
	"danger":      "bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800",
	"neutral":     "bg-stone-100 dark:bg-zinc-800 text-stone-700 dark:text-zinc-300 border border-stone-300 dark:border-zinc-600",
	"implemented": "bg-green-50 dark:bg-green-950 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800",
	"in_progress": "bg-amber-50 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800",
	"planned":     "bg-stone-100 dark:bg-zinc-800 text-stone-700 dark:text-zinc-300 border border-stone-300 dark:border-zinc-600",
	"deprecated":  "bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800",
}

templ Badge(p BadgeProps) {
	<span class={ cx("inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium", pick(badgeVariants, p.Variant, "default"), p.Class) } { p.Attrs... }>
		{ children... }
	</span>
}

templ StatusBadge(status string) {
	switch status {
		case "implemented":
			@Badge(BadgeProps{Variant: "implemented"}) {
				{ locale.T(ctx, "status_implemented") }
			}
		case "in_progress":
			@Badge(BadgeProps{Variant: "in_progress"}) {
				{ locale.T(ctx, "status_in_progress") }
			}
		case "planned":
			@Badge(BadgeProps{Variant: "planned"}) {
				{ locale.T(ctx, "status_planned") }
			}
		case "deprecated":
			@Badge(BadgeProps{Variant: "deprecated"}) {
				{ locale.T(ctx, "status_deprecated") }
			}
		default:
			@Badge(BadgeProps{Variant: "default"}) {
				{ status }
			}
	}
}
