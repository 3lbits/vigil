package httputil

import (
	"fmt"

	"github.com/3lbits/vigil/internal/locale"
)

type ErrorPageData struct {
	Status       int
	Title        string
	Message      string
	RequestID    string
	PrimaryHref  string
	PrimaryLabel string
}

templ ErrorPage(data ErrorPageData) {
	<!DOCTYPE html>
	<html lang={ locale.LangFromContext(ctx) }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.Title }</title>
		<link rel="stylesheet" href="/public/css/output.css"/>
	</head>
	<body class="error-page">
		<header class="error-header">
			<nav aria-label="Error navigation" class="error-nav">
				<a href="/" class="error-home">
					<span class="error-logo">V</span>
					Vigil
				</a>
				<div class="error-nav-links">
					<a href="/">{ locale.T(ctx, "error_action_go_home") }</a>
					<a href="/about">{ locale.T(ctx, "nav_about") }</a>
				</div>
			</nav>
		</header>
		<main class="error-main">
			<div class="error-card-wrap">
				@ErrorPageCard(data, false)
			</div>
		</main>
	</body>
	</html>
}

templ ErrorPageCard(data ErrorPageData, nested bool) {
	<article class="error-card">
		<p class="error-code">
			HTTP { fmt.Sprint(data.Status) }
		</p>
		if nested {
			<h2 class="error-title">{ data.Title }</h2>
		} else {
			<h1 class="error-title">{ data.Title }</h1>
		}
		<p class="error-message">{ data.Message }</p>

		if data.RequestID != "" {
			<p class="error-request">
				{ locale.T(ctx, "error_request_id_label") }: { data.RequestID }
			</p>
		}

		<div class="error-actions">
			<a href={ templ.SafeURL(data.PrimaryHref) } class="error-primary">
				{ data.PrimaryLabel }
			</a>
			<button type="button" onclick="history.back()" class="error-secondary">
				{ locale.T(ctx, "error_action_go_back") }
			</button>
		</div>
	</article>
}

templ ErrorInline(status int, title, message string) {
	<p class="error-inline">
		<strong>HTTP { fmt.Sprint(status) } · { title }</strong>
		<span>{ message }</span>
	</p>
}
