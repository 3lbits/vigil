package ui2

import "fmt"

templ Page(class string) {
	<div class={ "ui2", class }>
		{ children... }
	</div>
}

templ Panel() {
	<section class="ui2-panel">
		{ children... }
	</section>
}

templ Grid() {
	<div class="ui2-grid">
		{ children... }
	</div>
}

templ Notice(tone string) {
	<p class="ui2-notice" data-tone={ tone }>
		{ children... }
	</p>
}

templ Badge(tone string) {
	<span class="ui2-badge" data-tone={ tone }>{ children... }</span>
}

templ Metric(label string, value int64, note string) {
	<article class="ui2-metric">
		<h2>{ label }</h2>
		<data value={ fmt.Sprint(value) }>{ fmt.Sprint(value) }</data>
		<p>{ note }</p>
	</article>
}

templ CoverageMeter(label string, value int) {
	<div class="ui2-coverage">
		<span>{ children... }</span>
		@CoverageGauge(label, value)
		<span>{ fmt.Sprintf("%d %%", value) }</span>
	</div>
}

templ CoverageGauge(label string, value int) {
	<meter min="0" max="100" low="50" high="80" optimum="100" value={ fmt.Sprint(value) } aria-label={ label }>{ fmt.Sprintf("%d %%", value) }</meter>
}
