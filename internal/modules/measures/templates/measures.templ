package measurestemplates

import (
	"database/sql"
	"fmt"
	"strings"
	"github.com/google/uuid"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	formstemplates "github.com/3lbits/vigil/internal/ui2/forms"
)

func measureRef(n sql.NullInt32) string {
	if !n.Valid { return "" }
	return fmt.Sprintf("M-%03d", n.Int32)
}

func flashRole(tone string) string {
	if tone == "error" {
		return "alert"
	}
	return "status"
}

func flashTone(tone string) string {
	switch tone {
	case "error":
		return "danger"
	case "success":
		return "success"
	default:
		return "neutral"
	}
}

templ measureStatusBadge(status string) {
	switch status {
		case "implemented":
			@ui2.Badge("success") { { locale.T(ctx, "status_implemented") } }
		case "in_progress":
			@ui2.Badge("warning") { { locale.T(ctx, "status_in_progress") } }
		case "planned":
			@ui2.Badge("neutral") { { locale.T(ctx, "status_planned") } }
		case "deprecated":
			@ui2.Badge("danger") { { locale.T(ctx, "status_deprecated") } }
		default:
			@ui2.Badge("neutral") { { status } }
	}
}

// ── Measure list ──

templ MeasureList(measures []MeasureVM, filter, q, sort, dir string, mine bool, flash, flashType string, hasMore bool, pageSize int32) {
	@ui2.Page("ui2-measures") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-toolbar">
		<p data-testid="measure-count" class="ops-muted">{ locale.TN(ctx, "measures_count", len(measures), map[string]any{"Count": len(measures)}) }</p>
		@ui2.Link("/measures/new", templ.Attributes{"class": "ops-button"}) {
			@ui2.IconSVG("plus", 13)
			{ locale.T(ctx, "action_add_measure") }
		}
	</div>

	@ui2.FilterBar(ui2.FilterBarProps{ID: "measures-filters", Action: "/measures", Target: "#measures-table"}) {
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "sort", "value": sort})
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "dir", "value": dir})
		@ui2.FilterSearch(ui2.FilterSearchProps{
			Value:   q,
			Columns: []string{"label_name", "label_owner"},
			Action:  "/measures",
			Target:  "#measures-table",
		})
		@ui2.FilterSelect("filter", locale.T(ctx, "filter_all_statuses")) {
			<option value="" selected?={ filter == "" || filter == "all" }>{ locale.T(ctx, "filter_all_statuses") }</option>
			<option value="implemented" selected?={ filter == "implemented" }>{ locale.T(ctx, "status_implemented") }</option>
			<option value="in_progress" selected?={ filter == "in_progress" }>{ locale.T(ctx, "status_in_progress") }</option>
			<option value="planned" selected?={ filter == "planned" }>{ locale.T(ctx, "status_planned") }</option>
			<option value="deprecated" selected?={ filter == "deprecated" }>{ locale.T(ctx, "status_deprecated") }</option>
		}
		@ui2.FilterMine(mine, "label_mine_only")
	}

	<div id="measures-table" aria-live="polite" aria-atomic="false">
		@MeasuresTable(measures, hasMore, pageSize, filter, q, sort, dir, mine)
	</div>
	}
}

templ MeasuresTable(measures []MeasureVM, hasMore bool, pageSize int32, filter, q, sort, dir string, mine bool) {
	if len(measures) == 0 {
		<p data-testid="no-measures-empty">{ locale.T(ctx, "measures_none_yet") } @ui2.Link("/measures/new", nil) { Add your first measure → }</p>
	} else {
		@ui2.Table(locale.T(ctx, "nav_measures")) {
					<thead>
						<tr>
							@ui2.SortTh(locale.T(ctx, "label_measure"), "name", ui2.SortState{Col: sort, Dir: dir}, "/measures", "#measures-table", "measures-filters", "ops-sort-heading")
							@ui2.SortTh(locale.T(ctx, "label_status"), "status", ui2.SortState{Col: sort, Dir: dir}, "/measures", "#measures-table", "measures-filters", "ops-sort-heading")
							@ui2.SortTh(locale.T(ctx, "label_owner"), "owner", ui2.SortState{Col: sort, Dir: dir}, "/measures", "#measures-table", "measures-filters", "ops-sort-heading")
							<th scope="col" >{ locale.T(ctx, "label_frameworks") }</th>
							<th scope="col" class="ops-align-end"><span class="sr-only">{ locale.T(ctx, "label_actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						@MeasureRows(measures, hasMore, pageSize, filter, q, sort, dir, mine)
					</tbody>
		}
	}
}

templ MeasureRows(measures []MeasureVM, hasMore bool, nextOffset int32, filter, q, sort, dir string, mine bool) {
	for _, mvm := range measures {
		<tr>
			<td>
				<div class="ops-inline">
					if mvm.Measure.RefNum.Valid {
						<span class="ops-reference">{ measureRef(mvm.Measure.RefNum) }</span>
					}
					@ui2.Link(templ.SafeURL("/measures/"+mvm.Measure.ID.String()), templ.Attributes{"class": "ops-link ops-truncate"}) { { mvm.Measure.Name } }
				</div>
				if mvm.Measure.Category != "" {
					<p class="ops-muted">{ mvm.Measure.Category }</p>
				}
			</td>
			<td>
				@measureStatusBadge(mvm.Measure.Status)
			</td>
			<td>
				if mvm.OwnerDisplay == "" {
					<span class="ops-muted">—</span>
				} else {
					{ mvm.OwnerDisplay }
				}
			</td>
			<td>
				<div class="ops-inline">
					if mvm.HasRiskLinks {
						<span class="ops-kind ops-reference">Risk</span>
					}
					for _, fw := range mvm.Frameworks {
						<span class="ops-tag ops-reference">{ fw }</span>
					}
				</div>
			</td>
			<td class="ops-align-end">
				@ui2.Link(templ.SafeURL("/measures/"+mvm.Measure.ID.String()+"/edit"), templ.Attributes{"aria-label": "Edit measure " + mvm.Measure.Name, "class": "ops-link"}) { edit }
			</td>
		</tr>
	}
	if hasMore {
		<tr id="load-more-row">
			<td colspan="5" class="ops-align-center">
				@ui2.Link(templ.SafeURL("/measures?offset="+fmt.Sprint(nextOffset)+"&filter="+filter+"&q="+q+"&sort="+sort+"&dir="+dir+"&mine="+listMineQueryValue(mine)), templ.Attributes{"hx-get": "/measures", "hx-include": "#measures-filters", "hx-vals": fmt.Sprintf(`{"offset":"%d"}`, nextOffset), "hx-target": "#load-more-row", "hx-swap": "outerHTML", "class": "ops-button"}) { Load more }
			</td>
		</tr>
	}
}

func listMineQueryValue(mine bool) string {
	if mine {
		return "on"
	}
	return ""
}

// ── Measure form ──

templ MeasureForm(m *db.Measure, users []db.User, flash, flashType string) {
	@ui2.Page("ui2-measures") {
		@measureFormContent(m, users, flash, flashType)
	}
}

templ measureFormContent(m *db.Measure, users []db.User, flash, flashType string) {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-stack ops-narrow">
		<form method="POST" action={ measureFormAction(m) } class="ops-form-inline">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			if m == nil {
				@formstemplates.MeasureCreateFields(users, "measure-create")
			} else {
				@measureInputField("label_name", "name", "e.g. Patch management process", measureFieldVal(m, "name"), true)
				@measureInputField("label_category", "category", "e.g. Technical, Organisational", measureFieldVal(m, "category"), false)
				@measureAssigneePicker(m, users)
				@measureTextarea("label_description", "description", "Optional detailed description", measureFieldVal(m, "description"))
			}

			<div>
				<label for="status" class="ops-label">{ locale.T(ctx, "label_status") }</label>
				@ui2.Select(templ.Attributes{"id": "status", "name": "status", "class": "ops-input"}) {
					for _, opt := range []struct{ Val, Key string }{
						{"planned", "status_planned"},
						{"in_progress", "status_in_progress"},
						{"implemented", "status_implemented"},
						{"deprecated", "status_deprecated"},
					} {
						<option value={ opt.Val } selected?={ measureFieldVal(m, "status") == opt.Val }>{ locale.T(ctx, opt.Key) }</option>
					}
				}
			</div>

			<div class="ops-inline">
				@ui2.Button(templ.Attributes{"type": "submit"}) {
					if m == nil {
						{ locale.T(ctx, "action_create_measure") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				}
				@ui2.Link("/measures", templ.Attributes{"class": "ops-button"}) {
					{ locale.T(ctx, "action_cancel") }
				}
				if m != nil {
					@ui2.Button(templ.Attributes{"type": "submit", "formaction": "/measures/" + m.ID.String() + "/delete", "formmethod": "POST", "onclick": "return confirm('Delete this measure?')", "data-tone": "danger", "class": "ops-link"}) {
						{ locale.T(ctx, "action_delete") }
					}
				}
			</div>
		</form>
	</div>
}

func measureFormAction(m *db.Measure) templ.SafeURL {
	if m == nil {
		return "/measures"
	}
	return templ.SafeURL("/measures/" + m.ID.String())
}

func measureFieldVal(m *db.Measure, field string) string {
	if m == nil {
		if field == "status" {
			return "planned"
		}
		return ""
	}
	switch field {
	case "name":
		return m.Name
	case "category":
		return m.Category
	case "owner":
		return m.Owner
	case "description":
		return m.Description
	case "status":
		return m.Status
	}
	return ""
}

// ── Measure detail ──

templ MeasureDetail(vm MeasureDetailVM) {
	@ui2.Page("ui2-measures") {
	<div class="ops-toolbar ops-spaced">
		@ui2.Link("/measures", templ.Attributes{"class": "ops-link"}) {
			@ui2.IconSVG("chevron", 13)
			Measures
		}
		if vm.CanEdit {
			@ui2.Link(templ.SafeURL("/measures/"+vm.Measure.ID.String()+"/edit"), templ.Attributes{"class": "ops-button"}) {
				Edit measure
			}
		} else {
			<span class="ops-muted" title="You don't have permission to edit">
				Edit measure
			</span>
		}
	</div>

	<dl class="ops-medium ops-spaced">
		<dt class="ops-muted">Status</dt>
		<dd>@measureStatusBadge(vm.Measure.Status)</dd>
		if vm.Measure.Category != "" {
			<dt class="ops-muted">Category</dt>
			<dd class="ops-muted">{ vm.Measure.Category }</dd>
		}
		if vm.Measure.Owner != "" {
			<dt class="ops-muted">Owner</dt>
			<dd class="ops-muted">{ vm.Measure.Owner }</dd>
		}
		if vm.Measure.Description != "" {
			<dt class="ops-muted">Description</dt>
			<dd class="ops-muted">{ vm.Measure.Description }</dd>
		}
	</dl>

	if len(vm.Links) > 0 {
		<section class="ops-separated ops-spaced">
			<h2 class="ops-heading">{ locale.T(ctx, "section_documentation") }</h2>
			<ul class="ops-list">
				for _, lnk := range vm.Links {
					<li class="ops-list-item">
						@ui2.UntrustedLink(lnk.Url, templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "class": "ops-link ops-break"}) {
							if lnk.Label != "" {
								{ lnk.Label }
							} else {
								{ lnk.Url }
							}
						}
					</li>
				}
			</ul>
		</section>
	}

	<section class="ops-separated">
		<h2 class="ops-heading">
			{ locale.T(ctx, "section_requirements") }
			<span class="ops-muted">({ fmt.Sprint(len(vm.LinkedReqs)) })</span>
		</h2>
		if len(vm.LinkedReqs) == 0 {
			<p class="ops-muted">{ locale.T(ctx, "req_none_linked_yet") }</p>
		} else {
			@ui2.Table("Linked requirements") {
					<thead><tr><th scope="col">Framework</th><th scope="col">Ref</th><th scope="col">Title</th></tr></thead>
					<tbody>
						for _, req := range vm.LinkedReqs {
							<tr>
								<td>
									<span class="ops-tag ops-reference">{ req.FrameworkShortName }</span>
								</td>
								<td class="ops-reference">{ req.Ref }</td>
								<td>
									@ui2.Link(templ.SafeURL("/compliance/requirements/"+req.ID.String()), templ.Attributes{"class": "ops-link"}) { { req.Title } }
								</td>
							</tr>
						}
					</tbody>
			}
		}
	</section>

	<section class="ops-separated">
		<h2 class="ops-heading">
			{ locale.T(ctx, "section_activities") }
			<span class="ops-muted">({ fmt.Sprint(len(vm.Activities)) })</span>
		</h2>
		if len(vm.Activities) == 0 {
			<p class="ops-muted">{ locale.T(ctx, "activities_none_linked") }</p>
		} else {
			@ui2.Table("Activities") {
					<thead><tr><th scope="col">Activity</th><th scope="col">Status</th><th scope="col">Due</th></tr></thead>
					<tbody>
						for _, a := range vm.Activities {
							<tr>
								<td>
									@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()), templ.Attributes{"class": "ops-link"}) { { a.Title } }
								</td>
								<td>@measureStatusBadge(a.Status)</td>
								<td>
									if a.DueDate.Valid {
										{ a.DueDate.Time.Format("2006-01-02") }
									} else {
										<span class="ops-muted">—</span>
									}
								</td>
							</tr>
						}
					</tbody>
			}
		}
	</section>

	if len(vm.LinkedRisks) > 0 {
		<section class="ops-separated">
			<h2 class="ops-heading">
				{ locale.T(ctx, "section_linked_risks") }
				<span class="ops-muted">({ fmt.Sprint(len(vm.LinkedRisks)) })</span>
			</h2>
			<ul class="ops-list-box">
				for i, risk := range vm.LinkedRisks {
					<li>
					@ui2.Link(templ.SafeURL("/risks/"+risk.AssessmentID.String()+"/risks/"+risk.ID.String()), templ.Attributes{"class": measureRiskLinkClass(i)}) {
						<span class="ops-muted ops-truncate">{ risk.Name }</span>
						<div class="ops-inline">
							if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
								<div class="ops-risk-score" data-tone={ ui2.Tone(int(risk.LikelihoodCurrent.Int32)*int(risk.ConsequenceCurrent.Int32), vm.LowMax, vm.HighMin) }>
									<span>{ fmt.Sprint(int(risk.LikelihoodCurrent.Int32)*int(risk.ConsequenceCurrent.Int32)) }</span>
									<span >{ locale.T(ctx, "label_now") }</span>
								</div>
							}
							if risk.LikelihoodTarget.Valid && risk.ConsequenceTarget.Valid {
								<span class="ops-muted">→</span>
								<div class="ops-risk-score" data-tone={ ui2.Tone(int(risk.LikelihoodTarget.Int32)*int(risk.ConsequenceTarget.Int32), vm.LowMax, vm.HighMin) }>
									<span>{ fmt.Sprint(int(risk.LikelihoodTarget.Int32)*int(risk.ConsequenceTarget.Int32)) }</span>
									<span >{ locale.T(ctx, "label_target_score") }</span>
								</div>
							}
						</div>
					}
					</li>
				}
			</ul>
		</section>
	}

	@measureRecentChanges(vm.AuditLog, "ops-history-separated")

	}
}

func measureAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

// ── Measure edit page (form + links) ──

templ MeasureEditPage(vm MeasureEditVM, flash, flashType string) {
	@ui2.Page("ui2-measures") {
	@measureFormContent(&vm.Measure, vm.Users, flash, flashType)
	@measureLinksSection(vm)
	@measureDocSection(vm)
	@measureRecentChanges(vm.AuditLog, "ops-spaced")
	}
}

templ measureRecentChanges(auditLog []db.ListAuditLogForMeasureRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead><tr>
					<th scope="col">{ locale.T(ctx, "label_event") }</th>
					<th scope="col">{ locale.T(ctx, "label_by") }</th>
					<th scope="col">{ locale.T(ctx, "label_when") }</th>
				</tr></thead>
				<tbody>
					if len(auditLog) == 0 {
						<tr><td colspan="3">{ locale.T(ctx, "label_no_changes_yet") }</td></tr>
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								<tr>
									<td>{ measureAuditEventLabel(entry.Event) }</td>
									<td>
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="ops-muted">—</span>
										}
									</td>
									<td>{ entry.EventTime.Format("2 Jan 2006 15:04") }</td>
								</tr>
							}
						}
					}
				</tbody>
		}
	</details>
}

templ measureLinksSection(vm MeasureEditVM) {
	<section class="ops-stack ops-narrow ops-spaced">
		<h2 class="ops-heading">{ locale.T(ctx, "section_requirements") }</h2>
		if len(vm.LinkedReqs) == 0 {
			<p class="ops-muted">{ locale.T(ctx, "req_none_linked_yet") }</p>
		} else {
			@ui2.Table("Linked requirements") {
					<thead><tr><th scope="col">Framework</th><th scope="col">Ref</th><th scope="col">Title</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
					<tbody>
						for _, req := range vm.LinkedReqs {
							<tr>
								<td>
									<span class="ops-tag ops-reference">{ req.FrameworkShortName }</span>
								</td>
								<td class="ops-reference">{ req.Ref }</td>
								<td>{ req.Title }</td>
								<td class="ops-align-end">
									<form method="POST" action={ templ.SafeURL("/measures/" + vm.Measure.ID.String() + "/requirements/" + req.ID.String() + "/delete") }>
										@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
										@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "aria-label": "Remove requirement " + req.Ref + ": " + req.Title, "class": "ops-danger-link"}) { remove }
									</form>
								</td>
							</tr>
						}
					</tbody>
			}
		}
		<div class="ops-stack">
			<label for="requirement-link-search" class="ops-label">Search and link requirement</label>
			@ui2.Input(templ.Attributes{"id": "requirement-link-search", "type": "text", "name": "q", "placeholder": "Type ref or title...", "class": "ops-input", "hx-get": "/measures/" + vm.Measure.ID.String() + "/requirements/search", "hx-trigger": "input delay:250ms, search", "hx-target": "#measure-requirement-search-results-" + vm.Measure.ID.String(), "hx-swap": "innerHTML"})
			@MeasureRequirementSearchResults(vm.Measure.ID.String(), nil, "")
		</div>
	</section>
}

templ MeasureRequirementSearchResults(measureID string, requirements []db.ListRequirementsForMeasureRow, query string) {
	<div id={ "measure-requirement-search-results-" + measureID } class="ops-stack">
		if strings.TrimSpace(query) == "" {
			<p class="ops-muted">Start typing to find requirements.</p>
		} else if len(requirements) == 0 {
			<p class="ops-muted">No matching unlinked requirements.</p>
		} else {
			@ui2.Table("Requirement search results") {
					<tbody>
						for _, req := range requirements {
							<tr>
								<td>
									<span class="ops-tag ops-reference">{ req.FrameworkShortName }</span>
								</td>
								<td class="ops-reference">{ req.Ref }</td>
								<td>{ req.Title }</td>
								<td class="ops-align-end">
									<form method="POST" action={ templ.SafeURL("/measures/" + measureID + "/requirements") }>
										@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
										@ui2.Input(templ.Attributes{"type": "hidden", "name": "requirement_id", "value": req.ID.String()})
										@ui2.Button(templ.Attributes{"type": "submit", "class": "ops-link"}) { { locale.T(ctx, "action_link_requirement") } }
									</form>
								</td>
							</tr>
						}
					</tbody>
			}
		}
	</div>
}

templ measureDocSection(vm MeasureEditVM) {
	<section class="ops-stack ops-narrow ops-spaced">
		<h2 class="ops-heading">{ locale.T(ctx, "section_documentation") }</h2>
		if len(vm.Links) > 0 {
			<ul class="ops-list">
				for _, lnk := range vm.Links {
					<li class="ops-list-item">
						<span >
							@ui2.UntrustedLink(lnk.Url, templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "class": "ops-link ops-break"}) {
								if lnk.Label != "" {
									{ lnk.Label }
								} else {
									{ lnk.Url }
								}
							}
							if lnk.Label != "" {
								<span class="ops-muted ops-break">{ lnk.Url }</span>
							}
						</span>
						<form method="POST" action={ templ.SafeURL("/measures/" + vm.Measure.ID.String() + "/links/" + lnk.ID.String() + "/delete") } class="ops-form-inline">
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
							@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "aria-label": "Remove link " + lnk.Url, "class": "ops-danger-link"}) { remove }
						</form>
					</li>
				}
			</ul>
		} else {
			<p class="ops-muted">No documentation links yet.</p>
		}
		<form method="POST" action={ templ.SafeURL("/measures/" + vm.Measure.ID.String() + "/links") } class="ops-form-inline">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Input(templ.Attributes{"id": "doc-url", "type": "url", "name": "url", "placeholder": "https://...", "required": true, "aria-label": "URL", "class": "ops-input"})
			<div class="ops-inline">
				@ui2.Input(templ.Attributes{"id": "doc-label", "type": "text", "name": "label", "placeholder": "Label (optional)", "aria-label": "Label (optional)", "class": "ops-input"})
				@ui2.Button(templ.Attributes{"type": "submit", "class": "ops-button"}) {
					{ locale.T(ctx, "action_add_link") }
				}
			</div>
		</form>
	</section>
}

// ── Shared form helpers (local to this package) ──

templ measureInputField(labelKey, name, placeholder, value string, required bool) {
	<div>
		<label for={ name } class="ops-label">
			{ locale.T(ctx, labelKey) }
			if required {
				<span aria-hidden="true">*</span>
			}
		</label>
		@ui2.Input(templ.Attributes{"id": name, "name": name, "type": "text", "value": value, "placeholder": placeholder, "required": required, "class": "ops-input"})
	</div>
}

templ measureTextarea(labelKey, name, placeholder, value string) {
	<div>
		<label for={ name } class="ops-label">{ locale.T(ctx, labelKey) }</label>
		@ui2.Textarea(templ.Attributes{"id": name, "name": name, "placeholder": placeholder, "rows": "3", "class": "ops-input"}) { { value } }
	</div>
}

templ measureAssigneePicker(m *db.Measure, users []db.User) {
	<div class="ops-stack">
		<div>
			<label for="assignee_id" class="ops-label">{ locale.T(ctx, "label_assignee_registered") }</label>
			@ui2.Select(templ.Attributes{"id": "assignee_id", "name": "assignee_id", "class": "ops-input"}) {
				<option value="">— none —</option>
				for _, u := range users {
					<option value={ u.ID.String() } selected?={ measureAssigneeSelected(m, u.ID) }>{ u.Name } ({ u.Email })</option>
				}
			}
		</div>
		<div>
			<label for="owner" class="ops-label">{ locale.T(ctx, "label_owner_text_team") }</label>
			@ui2.Input(templ.Attributes{"id": "owner", "name": "owner", "type": "search", "value": measureFieldVal(m, "owner"), "placeholder": "Search user or enter custom owner", "list": "measure-owner-list", "class": "ops-input"})
			<datalist id="measure-owner-list">
				for _, u := range users {
					<option value={ u.Name } label={ u.Email }></option>
				}
			</datalist>
		</div>
	</div>
}

func measureAssigneeSelected(m *db.Measure, id uuid.UUID) bool {
	if m == nil || !m.AssigneeID.Valid {
		return false
	}
	return m.AssigneeID.UUID == id
}

func measureAssigneePickerData(m *db.Measure) string {
	if m != nil && m.AssigneeID.Valid {
		return fmt.Sprintf(`{ assigneeID: '%s', owner: '%s' }`, m.AssigneeID.UUID.String(), m.Owner)
	}
	return `{ assigneeID: '', owner: '' }`
}

func measureRiskLinkClass(i int) string {
	if i > 0 {
		return "ops-risk-link ops-risk-next"
	}
	return "ops-risk-link"
}
