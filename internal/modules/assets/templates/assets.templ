package assetstemplates

import (
	"context"
	"fmt"
	"strings"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
)

templ AssetList(assets []db.Asset, q, status, flash, flashType string, hasMore bool, nextOffset int32) {
	@ui.Flash(flash, flashType)

	<div class="flex flex-wrap justify-between items-center gap-3 mb-4">
		<p class="text-[13px] text-sand-700">{ locale.T(ctx, "assets_inventory") }</p>
		<a href="/assets/new" class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-400 hover:bg-sand-100 transition-colors flex items-center gap-1.5">
			@ui.IconSVG("plus", 13)
			{ locale.T(ctx, "action_add_asset") }
		</a>
	</div>

	<form method="GET" action="/assets" class="flex flex-wrap gap-2 mb-4 items-center">
		<label for="assets-q" class="sr-only">{ locale.T(ctx, "assets_search_assets") }</label>
		<input id="assets-q" name="q" type="search" value={ q } placeholder={ locale.T(ctx, "assets_search_name_or_owner") } class="text-[12px] border border-sand-300 rounded-md px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500 w-60"/>
		<label for="assets-status" class="sr-only">{ locale.T(ctx, "assets_filter_status") }</label>
		<select id="assets-status" name="status" class="text-[12px] border border-sand-300 rounded-md px-2.5 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
			<option value="" selected?={ status == "" }>{ locale.T(ctx, "filter_all_statuses") }</option>
			<option value="active" selected?={ status == "active" }>{ locale.T(ctx, "status_active") }</option>
			<option value="planned" selected?={ status == "planned" }>{ locale.T(ctx, "status_planned") }</option>
			<option value="retired" selected?={ status == "retired" }>{ locale.T(ctx, "status_retired") }</option>
		</select>
		<button type="submit" class="text-[12px] px-3 py-1.5 rounded border border-sand-300 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_search") }</button>
	</form>

	if len(assets) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			Class: "border-solid border-sand-300/60 rounded-[10px] p-8 bg-white dark:bg-zinc-900",
		}) {
			<div class="text-sand-700 text-[13px]">{ locale.T(ctx, "assets_none_found") }</div>
			<a href="/assets/new" class="text-blue-600 text-[13px] hover:underline">{ locale.T(ctx, "assets_add_first") }</a>
		}
	} else {
		@ui.Card(ui.CardProps{
			Class:   "border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden",
			Padding: "p-0",
		}) {
			<div role="region" aria-label={ locale.T(ctx, "assets_table_aria") } tabindex="0" class="overflow-x-auto">
				@ui.Table(ui.TableProps{
					Attrs: templ.Attributes{
						"class": "min-w-[760px]",
					},
				}) {
					<caption class="sr-only">{ locale.T(ctx, "assets_table_caption") }</caption>
					@ui.THead(ui.THeadProps{
						Attrs: templ.Attributes{
							"class": "bg-sand-100 dark:bg-zinc-800",
						},
					}) {
						@ui.Tr(ui.TrProps{}) {
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { { locale.T(ctx, "label_name") } }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { { locale.T(ctx, "label_asset_type") } }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { { locale.T(ctx, "label_asset_owner") } }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { { locale.T(ctx, "label_status") } }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { { locale.T(ctx, "assets_criticality") } }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-right px-4"}}) { <span class="sr-only">{ locale.T(ctx, "label_actions") }</span> }
						}
					}
					<tbody>
						for _, a := range assets {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4"}}) {
									<a href={ templ.SafeURL("/assets/" + a.ID.String()) } class="font-medium hover:text-blue-700 hover:underline">{ a.Name }</a>
								}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) { zeroDash(a.AssetType) }
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) { zeroDash(a.Owner) }
								@ui.Td(ui.TdProps{}) {
									<span class={ assetStatusClass(a.Status) }>{ localizeAssetStatus(ctx, a.Status) }</span>
								}
								@ui.Td(ui.TdProps{}) {
									<span class={ criticalityClass(a.Criticality) }>{ localizeCriticality(ctx, a.Criticality) }</span>
								}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 text-right"}}) {
									<a href={ templ.SafeURL("/assets/" + a.ID.String() + "/edit") } class="text-[11px] text-sand-700 hover:text-sand-900 py-1 px-2">{ locale.T(ctx, "action_edit_lower") }</a>
								}
							}
						}
						if hasMore {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{
									Attrs: templ.Attributes{
										"colspan": "6",
										"class":   "text-center",
									},
								}) {
									<a href={ templ.SafeURL("/assets?offset=" + fmt.Sprint(nextOffset) + "&q=" + q + "&status=" + status) } class="text-[12px] text-sand-700 hover:text-sand-900 border border-sand-300 rounded px-3 py-1.5 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_load_more") }</a>
								}
							}
						}
					</tbody>
				}
			</div>
		}
	}
}

templ AssetForm(a *db.Asset, flash, flashType string, auditLog []db.ListAuditLogForAssetRow) {
	@ui.Flash(flash, flashType)
	<div class="max-w-xl">
		<form method="POST" action={ assetFormAction(a) } class="flex flex-col gap-4">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div>
				<label for="asset-name" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "label_name") } <span class="text-red-500">*</span></label>
				<input id="asset-name" type="text" name="name" required value={ assetValue(a, "name") } placeholder={ locale.T(ctx, "assets_placeholder_name") } class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"/>
			</div>
			<div>
				<label for="asset-description" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "label_description") }</label>
				<textarea id="asset-description" name="description" rows="4" class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">{ assetValue(a, "description") }</textarea>
			</div>
			<div class="grid grid-cols-2 gap-3">
				<div>
					<label for="asset-type" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "label_asset_type") }</label>
					<input id="asset-type" type="text" name="asset_type" value={ assetValue(a, "asset_type") } placeholder={ locale.T(ctx, "assets_placeholder_type") } class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"/>
				</div>
				<div>
					<label for="asset-owner" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "label_asset_owner") }</label>
					<input id="asset-owner" type="text" name="owner" value={ assetValue(a, "owner") } placeholder={ locale.T(ctx, "assets_placeholder_owner") } class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"/>
				</div>
			</div>
			<div class="grid grid-cols-2 gap-3">
				<div>
					<label for="asset-status" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "label_status") }</label>
					<select id="asset-status" name="status" class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
						<option value="active" selected?={ assetValue(a, "status") == "active" || assetValue(a, "status") == "" }>{ locale.T(ctx, "status_active") }</option>
						<option value="planned" selected?={ assetValue(a, "status") == "planned" }>{ locale.T(ctx, "status_planned") }</option>
						<option value="retired" selected?={ assetValue(a, "status") == "retired" }>{ locale.T(ctx, "status_retired") }</option>
					</select>
				</div>
				<div>
					<label for="asset-criticality" class="block text-[13px] font-medium text-sand-800 mb-1">{ locale.T(ctx, "assets_criticality") }</label>
					<select id="asset-criticality" name="criticality" class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
						<option value="low" selected?={ assetValue(a, "criticality") == "low" }>{ locale.T(ctx, "risk_level_low") }</option>
						<option value="medium" selected?={ assetValue(a, "criticality") == "medium" || assetValue(a, "criticality") == "" }>{ locale.T(ctx, "risk_level_medium") }</option>
						<option value="high" selected?={ assetValue(a, "criticality") == "high" }>{ locale.T(ctx, "risk_level_high") }</option>
					</select>
				</div>
			</div>
			<div class="flex gap-2 pt-1">
				@ui.Button(ui.ButtonProps{
					Attrs: templ.Attributes{
						"type": "submit",
					},
				}) {
					if a == nil {
						{ locale.T(ctx, "action_create_asset") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				}
				if a != nil {
					<a href={ templ.SafeURL("/assets/" + a.ID.String()) } class="text-[13px] font-medium py-2 px-4 rounded-md border border-sand-300 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_cancel") }</a>
				}
			</div>
		</form>
		if a != nil {
			@assetRecentChanges(auditLog, "mt-8")
		}
	</div>
}

templ AssetDetail(a db.Asset, canEdit bool, flash, flashType string, auditLog []db.ListAuditLogForAssetRow) {
	@ui.Flash(flash, flashType)
	<div class="max-w-3xl space-y-4">
		<div class="border border-sand-300/60 rounded-[10px] p-4">
			<div class="flex items-start justify-between gap-3">
				<div>
					<h2 class="text-[16px] font-medium">{ a.Name }</h2>
					<div class="mt-1 flex items-center gap-2">
						<span class={ assetStatusClass(a.Status) }>{ localizeAssetStatus(ctx, a.Status) }</span>
						<span class={ criticalityClass(a.Criticality) }>{ localizeCriticality(ctx, a.Criticality) } { locale.T(ctx, "assets_criticality") }</span>
					</div>
				</div>
				if canEdit {
					<a href={ templ.SafeURL("/assets/" + a.ID.String() + "/edit") } class="text-[12px] px-3 py-1.5 rounded border border-sand-300 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_edit") }</a>
				}
			</div>
			<div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-[13px]">
				<div>
					<div class="text-sand-700 text-[11px] uppercase tracking-wide">{ locale.T(ctx, "label_asset_type") }</div>
					<div>{ zeroDash(a.AssetType) }</div>
				</div>
				<div>
					<div class="text-sand-700 text-[11px] uppercase tracking-wide">{ locale.T(ctx, "label_asset_owner") }</div>
					<div>{ zeroDash(a.Owner) }</div>
				</div>
			</div>
			<div class="mt-4">
				<div class="text-sand-700 text-[11px] uppercase tracking-wide mb-1">{ locale.T(ctx, "label_description") }</div>
				if a.Description == "" {
					<div class="text-[13px] text-sand-700">—</div>
				} else {
					<p class="text-[13px] whitespace-pre-wrap">{ a.Description }</p>
				}
			</div>
		</div>
		if canEdit {
			<form method="POST" action={ templ.SafeURL("/assets/" + a.ID.String() + "/delete") } onsubmit="return confirm('Delete this asset?')">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<button type="submit" class="text-[12px] px-3 py-1.5 rounded border border-red-200 text-red-700 hover:bg-red-50 transition-colors">{ locale.T(ctx, "action_delete_asset") }</button>
			</form>
		}
		@assetRecentChanges(auditLog, "")
	</div>
}

templ assetRecentChanges(auditLog []db.ListAuditLogForAssetRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="cursor-pointer text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3 list-none">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
			@ui.Table(ui.TableProps{}) {
				<caption class="sr-only">{ locale.T(ctx, "label_recent_changes") }</caption>
				@ui.THead(ui.THeadProps{
					Attrs: templ.Attributes{
						"class": "bg-sand-100 dark:bg-zinc-800",
					},
				}) {
					@ui.Tr(ui.TrProps{}) {
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_event") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_by") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_when") } }
					}
				}
				<tbody>
					if len(auditLog) == 0 {
						@ui.Tr(ui.TrProps{
							Attrs: templ.Attributes{
								"class": "border-sand-300/60 dark:border-zinc-700/60",
							},
						}) {
							@ui.Td(ui.TdProps{
								Attrs: templ.Attributes{
									"colspan": "3",
									"class":   "px-4 text-sand-700",
								},
							}) { { locale.T(ctx, "label_no_changes_yet") } }
						}
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								@ui.Tr(ui.TrProps{
									Attrs: templ.Attributes{
										"class": "border-sand-300/60 dark:border-zinc-700/60",
									},
								}) {
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-medium"}}) { { assetAuditEventLabel(entry.Event) } }
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) {
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="text-sand-700">—</span>
										}
									}
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700 font-mono text-[11px]"}}) { { entry.EventTime.Format("2 Jan 2006 15:04") } }
								}
							}
						}
					}
				</tbody>
			}
		</div>
	</details>
}

func assetFormAction(a *db.Asset) string {
	if a == nil {
		return "/assets"
	}
	return "/assets/" + a.ID.String()
}

func assetValue(a *db.Asset, field string) string {
	if a == nil {
		return ""
	}
	switch field {
	case "name":
		return a.Name
	case "description":
		return a.Description
	case "asset_type":
		return a.AssetType
	case "owner":
		return a.Owner
	case "status":
		return a.Status
	case "criticality":
		return a.Criticality
	default:
		return ""
	}
}

func zeroDash(v string) string {
	if strings.TrimSpace(v) == "" {
		return "—"
	}
	return v
}

func assetStatusClass(status string) string {
	switch status {
	case "planned":
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200"
	case "retired":
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-sand-100 text-sand-700 border border-sand-300"
	default:
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-green-50 text-green-700 border border-green-200"
	}
}

func criticalityClass(criticality string) string {
	switch criticality {
	case "low":
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-sand-100 text-sand-700 border border-sand-300"
	case "high":
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-red-50 text-red-700 border border-red-200"
	default:
		return "inline-flex items-center text-[10px] font-medium px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200"
	}
}

func assetAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

func localizeAssetStatus(ctx context.Context, status string) string {
	switch status {
	case "active":
		return locale.T(ctx, "status_active")
	case "planned":
		return locale.T(ctx, "status_planned")
	case "retired":
		return locale.T(ctx, "status_retired")
	default:
		return cases.Title(language.Und).String(status)
	}
}

func localizeCriticality(ctx context.Context, criticality string) string {
	switch criticality {
	case "low":
		return locale.T(ctx, "risk_level_low")
	case "high":
		return locale.T(ctx, "risk_level_high")
	default:
		return locale.T(ctx, "risk_level_medium")
	}
}
