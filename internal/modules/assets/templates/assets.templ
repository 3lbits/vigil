package assetstemplates

import (
	"context"
	"fmt"
	"strings"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
	"github.com/3lbits/vigil/internal/ui2"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
)

func flashRole(tone string) string {
	if tone == "error" {
		return "alert"
	}
	return "status"
}

func flashTone(tone string) string {
	switch tone {
	case "error":
		return "danger"
	case "success":
		return "success"
	default:
		return "neutral"
	}
}

templ AssetList(assets []db.Asset, q, status, flash, flashType string, hasMore bool, nextOffset int32) {
	@ui2.Page("ui2-assets") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-toolbar">
		<p class="ops-muted">{ locale.T(ctx, "assets_inventory") }</p>
		<a href="/assets/new" class="ops-button">
			@ui.IconSVG("plus", 13)
			{ locale.T(ctx, "action_add_asset") }
		</a>
	</div>

	@ui2.FilterBar(ui2.FilterBarProps{Action: "/assets", Target: "#assets-table"}) {
		@ui2.FilterSearch(ui2.FilterSearchProps{
			Value:   q,
			Columns: []string{"label_name", "label_asset_owner"},
			Class:   "w-60",
			Action:  "/assets",
			Target:  "#assets-table",
		})
		@ui2.FilterSelect("status", locale.T(ctx, "assets_filter_status")) {
			<option value="" selected?={ status == "" }>{ locale.T(ctx, "filter_all_statuses") }</option>
			<option value="active" selected?={ status == "active" }>{ locale.T(ctx, "status_active") }</option>
			<option value="planned" selected?={ status == "planned" }>{ locale.T(ctx, "status_planned") }</option>
			<option value="retired" selected?={ status == "retired" }>{ locale.T(ctx, "status_retired") }</option>
		}
	}

	<div id="assets-table" aria-live="polite" aria-atomic="false">
		@AssetTable(assets, hasMore, nextOffset, q, status)
	</div>
	}
}

templ AssetTable(assets []db.Asset, hasMore bool, nextOffset int32, q, status string) {
	if len(assets) == 0 {
		<p>{ locale.T(ctx, "assets_none_found") } <a href="/assets/new">{ locale.T(ctx, "assets_add_first") }</a></p>
	} else {
		<section role="region" aria-label={ locale.T(ctx, "assets_table_aria") } tabindex="0" class="ops-table">
			<table class="ops-data-table">
					<caption class="sr-only">{ locale.T(ctx, "assets_table_caption") }</caption>
					<thead>
						<tr>
							<th scope="col">{ locale.T(ctx, "label_name") }</th>
							<th scope="col">{ locale.T(ctx, "label_asset_type") }</th>
							<th scope="col">{ locale.T(ctx, "label_asset_owner") }</th>
							<th scope="col">{ locale.T(ctx, "label_status") }</th>
							<th scope="col">{ locale.T(ctx, "assets_criticality") }</th>
							<th scope="col"><span class="sr-only">{ locale.T(ctx, "label_actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, a := range assets {
							<tr>
								<td>
									<a href={ templ.SafeURL("/assets/" + a.ID.String()) } class="ops-link">{ a.Name }</a>
								</td>
								<td>{ zeroDash(a.AssetType) }</td>
								<td>{ zeroDash(a.Owner) }</td>
								<td>
									<span class={ assetStatusClass(a.Status) }>{ localizeAssetStatus(ctx, a.Status) }</span>
								</td>
								<td>
									<span class={ criticalityClass(a.Criticality) }>{ localizeCriticality(ctx, a.Criticality) }</span>
								</td>
								<td>
									<a href={ templ.SafeURL("/assets/" + a.ID.String() + "/edit") } class="ops-link">{ locale.T(ctx, "action_edit_lower") }</a>
								</td>
							</tr>
						}
						if hasMore {
							<tr>
								<td colspan="6" class="ops-align-center">
									<a href={ templ.SafeURL("/assets?offset=" + fmt.Sprint(nextOffset) + "&q=" + q + "&status=" + status) } class="ops-button">{ locale.T(ctx, "action_load_more") }</a>
								</td>
							</tr>
						}
					</tbody>
			</table>
		</section>
	}
}

templ AssetForm(a *db.Asset, flash, flashType string, auditLog []db.ListAuditLogForAssetRow) {
	@ui2.Page("ui2-assets") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}
	<div class="ops-stack ops-medium">
		<form method="POST" action={ assetFormAction(a) } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div>
				<label for="asset-name" class="ops-label">{ locale.T(ctx, "label_name") } <span class="ops-error">*</span></label>
				<input id="asset-name" type="text" name="name" required value={ assetValue(a, "name") } placeholder={ locale.T(ctx, "assets_placeholder_name") } class="ops-input"/>
			</div>
			<div>
				<label for="asset-description" class="ops-label">{ locale.T(ctx, "label_description") }</label>
				<textarea id="asset-description" name="description" rows="4" class="ops-input">{ assetValue(a, "description") }</textarea>
			</div>
			<div class="ops-fields">
				<div>
					<label for="asset-type" class="ops-label">{ locale.T(ctx, "label_asset_type") }</label>
					<input id="asset-type" type="text" name="asset_type" value={ assetValue(a, "asset_type") } placeholder={ locale.T(ctx, "assets_placeholder_type") } class="ops-input"/>
				</div>
				<div>
					<label for="asset-owner" class="ops-label">{ locale.T(ctx, "label_asset_owner") }</label>
					<input id="asset-owner" type="text" name="owner" value={ assetValue(a, "owner") } placeholder={ locale.T(ctx, "assets_placeholder_owner") } class="ops-input"/>
				</div>
			</div>
			<div class="ops-fields">
				<div>
					<label for="asset-status" class="ops-label">{ locale.T(ctx, "label_status") }</label>
					<select id="asset-status" name="status" class="ops-input">
						<option value="active" selected?={ assetValue(a, "status") == "active" || assetValue(a, "status") == "" }>{ locale.T(ctx, "status_active") }</option>
						<option value="planned" selected?={ assetValue(a, "status") == "planned" }>{ locale.T(ctx, "status_planned") }</option>
						<option value="retired" selected?={ assetValue(a, "status") == "retired" }>{ locale.T(ctx, "status_retired") }</option>
					</select>
				</div>
				<div>
					<label for="asset-criticality" class="ops-label">{ locale.T(ctx, "assets_criticality") }</label>
					<select id="asset-criticality" name="criticality" class="ops-input">
						<option value="low" selected?={ assetValue(a, "criticality") == "low" }>{ locale.T(ctx, "risk_level_low") }</option>
						<option value="medium" selected?={ assetValue(a, "criticality") == "medium" || assetValue(a, "criticality") == "" }>{ locale.T(ctx, "risk_level_medium") }</option>
						<option value="high" selected?={ assetValue(a, "criticality") == "high" }>{ locale.T(ctx, "risk_level_high") }</option>
					</select>
				</div>
			</div>
			<div class="ops-inline">
				<button type="submit">
					if a == nil {
						{ locale.T(ctx, "action_create_asset") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				</button>
				if a != nil {
					<a href={ templ.SafeURL("/assets/" + a.ID.String()) } class="ops-button">{ locale.T(ctx, "action_cancel") }</a>
				}
			</div>
		</form>
		if a != nil {
			@assetRecentChanges(auditLog, "ops-spaced")
		}
	</div>
	}
}

templ AssetDetail(a db.Asset, canEdit bool, flash, flashType string, auditLog []db.ListAuditLogForAssetRow) {
	@ui2.Page("ui2-assets") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}
	<div class="ops-stack ops-wide">
		@ui2.Panel() {
			<header >
				<div>
					<h2 class="ops-heading">{ a.Name }</h2>
					<div class="ops-inline">
						<span class={ assetStatusClass(a.Status) }>{ localizeAssetStatus(ctx, a.Status) }</span>
						<span class={ criticalityClass(a.Criticality) }>{ localizeCriticality(ctx, a.Criticality) } { locale.T(ctx, "assets_criticality") }</span>
					</div>
				</div>
				if canEdit {
					<a href={ templ.SafeURL("/assets/" + a.ID.String() + "/edit") } class="ops-button">{ locale.T(ctx, "action_edit") }</a>
				}
			</header>
			<div class="ops-fields ops-spaced">
				<dl >
					<dt class="ops-muted">{ locale.T(ctx, "label_asset_type") }</dt>
					<dd>{ zeroDash(a.AssetType) }</dd>
				</dl>
				<dl >
					<dt class="ops-muted">{ locale.T(ctx, "label_asset_owner") }</dt>
					<dd>{ zeroDash(a.Owner) }</dd>
				</dl>
			</div>
			<section class="ops-spaced">
				<h3 class="ops-overline">{ locale.T(ctx, "label_description") }</h3>
				if a.Description == "" {
					<p class="ops-muted">—</p>
				} else {
					<p class="ops-muted ops-pre-wrap">{ a.Description }</p>
				}
			</section>
		}
		if canEdit {
			<form method="POST" action={ templ.SafeURL("/assets/" + a.ID.String() + "/delete") } onsubmit="return confirm('Delete this asset?')">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<button type="submit" data-tone="danger" class="ops-link">{ locale.T(ctx, "action_delete_asset") }</button>
			</form>
		}
		@assetRecentChanges(auditLog, "")
	</div>
	}
}

templ assetRecentChanges(auditLog []db.ListAuditLogForAssetRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead>
					<tr>
						<th scope="col">{ locale.T(ctx, "label_event") }</th>
						<th scope="col">{ locale.T(ctx, "label_by") }</th>
						<th scope="col">{ locale.T(ctx, "label_when") }</th>
					</tr>
				</thead>
				<tbody>
					if len(auditLog) == 0 {
						<tr><td colspan="3">{ locale.T(ctx, "label_no_changes_yet") }</td></tr>
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								<tr>
									<td>{ assetAuditEventLabel(entry.Event) }</td>
									<td>
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="ops-muted">—</span>
										}
									</td>
									<td>{ entry.EventTime.Format("2 Jan 2006 15:04") }</td>
								</tr>
							}
						}
					}
				</tbody>
		}
	</details>
}

func assetFormAction(a *db.Asset) string {
	if a == nil {
		return "/assets"
	}
	return "/assets/" + a.ID.String()
}

func assetValue(a *db.Asset, field string) string {
	if a == nil {
		return ""
	}
	switch field {
	case "name":
		return a.Name
	case "description":
		return a.Description
	case "asset_type":
		return a.AssetType
	case "owner":
		return a.Owner
	case "status":
		return a.Status
	case "criticality":
		return a.Criticality
	default:
		return ""
	}
}

func zeroDash(v string) string {
	if strings.TrimSpace(v) == "" {
		return "—"
	}
	return v
}

func assetStatusClass(status string) string {
	switch status {
	case "planned":
		return "ops-asset-badge ops-asset-planned"
	case "retired":
		return "ops-asset-badge ops-asset-neutral"
	default:
		return "ops-asset-badge ops-asset-active"
	}
}

func criticalityClass(criticality string) string {
	switch criticality {
	case "low":
		return "ops-asset-badge ops-asset-neutral"
	case "high":
		return "ops-asset-badge ops-asset-high"
	default:
		return "ops-asset-badge ops-asset-planned"
	}
}

func assetAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

func localizeAssetStatus(ctx context.Context, status string) string {
	switch status {
	case "active":
		return locale.T(ctx, "status_active")
	case "planned":
		return locale.T(ctx, "status_planned")
	case "retired":
		return locale.T(ctx, "status_retired")
	default:
		return cases.Title(language.Und).String(status)
	}
}

func localizeCriticality(ctx context.Context, criticality string) string {
	switch criticality {
	case "low":
		return locale.T(ctx, "risk_level_low")
	case "high":
		return locale.T(ctx, "risk_level_high")
	default:
		return locale.T(ctx, "risk_level_medium")
	}
}
