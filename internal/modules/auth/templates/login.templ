package authtemplates

import (
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/middleware"
	"github.com/3lbits/vigil/internal/ui2"
)

// ProviderInfo carries the slug and display label for a single auth provider.
type ProviderInfo struct {
	Slug  string
	Label string
}

templ LoginPage(providers []ProviderInfo) {
	<!DOCTYPE html>
	<html lang={ locale.LangFromContext(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ middleware.TopOrgNameFromContext(ctx) } — Sign in</title>
			<link rel="stylesheet" href="/public/css/output.css"/>
		</head>
		<body class="ui2-login">
			<a href="#main-content" class="skip-link">{ locale.T(ctx, "action_skip_to_main") }</a>
			<main id="main-content">
				@ui2.Page("ui2-login-page") {
					<header>
						<div class="ui2-login-logo">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
						</div>
						<h1>{ locale.T(ctx, "login_title") }</h1>
						<p>{ locale.T(ctx, "login_subtitle") }</p>
					</header>
					<nav class="ui2-login-providers" aria-label={ locale.T(ctx, "login_title") }>
						for _, p := range providers {
							@providerButton(p)
						}
					</nav>
				}
			</main>
		</body>
	</html>
}

templ providerButton(p ProviderInfo) {
	<a
		href={ templ.SafeURL("/auth/" + p.Slug) }
		class="ui2-login-provider"
	>
		if p.Slug == "github" {
			<!-- GitHub mark -->
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path></svg>
		} else if p.Slug == "entra" {
			<!-- Microsoft logo (four squares) -->
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21"><rect x="1" y="1" width="9" height="9" fill="#f25022"></rect><rect x="11" y="1" width="9" height="9" fill="#7fba00"></rect><rect x="1" y="11" width="9" height="9" fill="#00a4ef"></rect><rect x="11" y="11" width="9" height="9" fill="#ffb900"></rect></svg>
		}
		{ locale.T(ctx, "login_with_provider", map[string]any{"Provider": p.Label}) }
	</a>
}
