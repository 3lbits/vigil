package admintemplates

import (
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ OrgsPage(orgs []db.Organization, flash, flashType string) {
	@ui2.Page("ui2-admin") {
	@adminFlash(flash, flashType)
	<div>
		<p>{ locale.T(ctx, "admin_org_tree_help") }</p>
	</div>
	<!-- Add form -->
	<section>
		<h2>{ locale.T(ctx, "action_add_org_unit") }</h2>
		<form method="POST" action="/admin/orgs">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Field("org_name", locale.T(ctx, "label_name"), true) {
				@ui2.Input(templ.Attributes{"id": "org_name", "name": "name", "type": "text", "required": true, "placeholder": locale.T(ctx, "admin_org_placeholder")})
			}
			@ui2.Field("parent_id", locale.T(ctx, "admin_parent_unit"), false) {
				@ui2.Select(templ.Attributes{"id": "parent_id", "name": "parent_id"}) {
					<option value="">— { locale.T(ctx, "admin_top_level") } —</option>
					for _, o := range orgs {
						if !o.ParentID.Valid {
							<option value={ o.ID.String() }>{ o.Name }</option>
							for _, child := range orgs {
								if child.ParentID.Valid && child.ParentID.UUID == o.ID {
									<option value={ child.ID.String() }>&nbsp;&nbsp;↳ { child.Name }</option>
								}
							}
						}
					}
				}
			}
			<div>
				@ui2.Button(templ.Attributes{"type": "submit"}) {
					{ locale.T(ctx, "action_add") }
				}
			</div>
		</form>
	</section>
	<!-- Tree list -->
	if len(orgs) == 0 {
		<p>
			{ locale.T(ctx, "admin_no_orgs") }
		</p>
	} else {
		<ul>
			for _, o := range orgs {
				if !o.ParentID.Valid {
					@orgRow(o, 0, orgs)
				}
			}
		</ul>
	}
	}
}

templ orgRow(o db.Organization, depth int, all []db.Organization) {
	<li>
	<div class={ "admin-org-row", orgRowBg(depth) }>
		<span>
			if depth == 1 {
				<span>↳</span>
			}
			if depth == 2 {
				<span>&nbsp;&nbsp;↳</span>
			}
			{ o.Name }
		</span>
		<form method="POST" action={ templ.SafeURL("/admin/orgs/" + o.ID.String() + "/delete") } onsubmit="return confirm('Delete this org unit? This may affect linked assessments.')">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "aria-label": locale.T(ctx, "action_delete") + " " + o.Name}) { × }
		</form>
	</div>
	if orgHasChildren(o, all) {
		<ul>
		for _, child := range all {
			if child.ParentID.Valid && child.ParentID.UUID == o.ID {
				@orgRow(child, depth+1, all)
			}
		}
		</ul>
	}
	</li>
}

func orgHasChildren(o db.Organization, all []db.Organization) bool {
	for _, child := range all {
		if child.ParentID.Valid && child.ParentID.UUID == o.ID {
			return true
		}
	}
	return false
}

func orgRowBg(depth int) string {
	switch depth {
	case 1:
		return "admin-org-child"
	case 2:
		return "admin-org-grandchild"
	default:
		return ""
	}
}

templ RiskSettingsPage(acceptanceCriteria, flash, flashType string) {
	@ui2.Page("ui2-admin") {
	@adminFlash(flash, flashType)
	<section>
		<h2 class="sr-only">{ locale.T(ctx, "tab_risk_settings") }</h2>
		<p>{ locale.T(ctx, "admin_risk_settings_help") }</p>
		<form method="POST" action="/admin/risk-settings">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Field("acceptance_criteria", locale.T(ctx, "label_acceptance_criteria"), false) {
				@ui2.Textarea(templ.Attributes{"id": "acceptance_criteria", "name": "acceptance_criteria", "rows": "5", "placeholder": locale.T(ctx, "admin_acceptance_criteria_placeholder")}) { { acceptanceCriteria } }
			}
			<div>
				@ui2.Button(templ.Attributes{"type": "submit"}) {
					{ locale.T(ctx, "action_save") }
				}
			</div>
		</form>
	</section>
	}
}
