package admintemplates

import (
	"fmt"
	"strings"
	"time"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ AdminPage(users []db.User, sessions []db.ListActiveSessionsByUserRow, auditLog []db.ListAuditLogAdminRow, version string, startTime time.Time, dbOK bool, flash, flashType, activeTab, auditFilter string, orgs []db.Organization, gs db.RiskGlobalSetting, scaleLabels []db.RiskScaleLabel, appSettings db.AppSetting) {
	@ui2.Page("ui2-admin") {
		<div
			role="tablist"
			aria-label={ locale.T(ctx, "admin_sections") }
		>
			@adminTab("users", locale.T(ctx, "tab_users"), activeTab)
			@adminTab("sessions", locale.T(ctx, "tab_sessions"), activeTab)
			@adminTab("audit", locale.T(ctx, "tab_audit"), activeTab)
			@adminTab("status", locale.T(ctx, "tab_status"), activeTab)
			@adminTab("orgs", locale.T(ctx, "tab_orgs"), activeTab)
			@adminTab("risk", locale.T(ctx, "tab_risk_settings"), activeTab)
			@adminTab("modules", locale.T(ctx, "tab_modules"), activeTab)
		</div>
		@adminFlash(flash, flashType)
		<div id="tab-panel-users" role="tabpanel" aria-labelledby="tab-btn-users" class={ templ.KV("admin-hidden", activeTab != "users") }>
			<!-- Add user form -->
			<section>
				<h2>{ locale.T(ctx, "admin_add_user") }</h2>
				<form method="POST" action="/admin/users">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<div>
						<label for="add-user-name">{ locale.T(ctx, "label_name") }</label>
						<input
							id="add-user-name"
							type="text"
							name="name"
							autocomplete="name"
							placeholder="Jane Smith"
						/>
					</div>
					<div>
						<label for="add-user-email">{ locale.T(ctx, "label_email") }</label>
						<input
							id="add-user-email"
							type="email"
							name="email"
							required
							autocomplete="email"
							placeholder="user@example.com"
						/>
					</div>
					<div>
						<label for="add-user-role">{ locale.T(ctx, "label_role") }</label>
						<select id="add-user-role" name="role">
							<option value="viewer">{ locale.T(ctx, "role_viewer") }</option>
							<option value="contributor">{ locale.T(ctx, "role_contributor") }</option>
							<option value="editor">{ locale.T(ctx, "role_editor") }</option>
							<option value="admin">{ locale.T(ctx, "role_admin") }</option>
						</select>
					</div>
					<button type="submit">
						{ locale.T(ctx, "action_add") }
					</button>
				</form>
				<p>{ locale.T(ctx, "admin_add_user_hint") }</p>
			</section>
			<div>
				@ui2.Table(locale.T(ctx, "tab_users")) {
					<thead>
						<tr>
							<th scope="col"> { locale.T(ctx, "label_name") } </th>
							<th scope="col"> { locale.T(ctx, "label_email") } </th>
							<th scope="col"> { locale.T(ctx, "label_provider") } </th>
							<th scope="col"> { locale.T(ctx, "label_role") } </th>
							<th scope="col"> { locale.T(ctx, "label_org_unit") } </th>
							<th scope="col"> <span class="admin-visually-hidden">{ locale.T(ctx, "label_actions") }</span> </th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							<tr>
								<td>
									if u.Name == "" {
										<span>—</span>
									} else {
										{ u.Name }
									}
								</td>
								<td>
									if strings.TrimSpace(u.Email) == "" {
										<span>—</span>
									} else {
										{ u.Email }
									}
								</td>
								<td>
									@ProviderBadge(u.Provider)
								</td>
								<td>
									@RoleBadge(u.Role)
								</td>
								<td>
									<form method="POST" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/org") }>
										<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
										<label for={ "org-" + u.ID.String() } class="admin-visually-hidden">{ locale.T(ctx, "label_org_unit") } { adminUserLabel(u) }</label>
										<select id={ "org-" + u.ID.String() } name="org_id">
											<option value="">— { locale.T(ctx, "label_none") } —</option>
											for _, o := range orgs {
												<option value={ o.ID.String() } selected?={ u.OrgID.Valid && u.OrgID.UUID == o.ID }>{ o.Name }</option>
											}
										</select>
										<button type="submit" aria-label={ locale.T(ctx, "action_save") + " " + locale.T(ctx, "label_org_unit") + " " + locale.T(ctx, "label_for") + " " + adminUserLabel(u) }>
											{ locale.T(ctx, "action_save") }
										</button>
									</form>
								</td>
								<td>
									<div>
										<form method="POST" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/role") }>
											<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
											<label for={ "role-" + u.ID.String() } class="admin-visually-hidden">{ locale.T(ctx, "label_role") } { locale.T(ctx, "label_for") } { adminUserLabel(u) }</label>
											<select id={ "role-" + u.ID.String() } name="role">
												<option value="viewer" selected?={ u.Role == "viewer" }>{ locale.T(ctx, "role_viewer") }</option>
												<option value="contributor" selected?={ u.Role == "contributor" }>{ locale.T(ctx, "role_contributor") }</option>
												<option value="editor" selected?={ u.Role == "editor" }>{ locale.T(ctx, "role_editor") }</option>
												<option value="admin" selected?={ u.Role == "admin" }>{ locale.T(ctx, "role_admin") }</option>
											</select>
											<button type="submit" aria-label={ locale.T(ctx, "action_save") + " " + locale.T(ctx, "label_role") + " " + locale.T(ctx, "label_for") + " " + adminUserLabel(u) }>
												{ locale.T(ctx, "action_save") }
											</button>
										</form>
										<form method="POST" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/delete") } onsubmit="return confirm('Delete this user?')">
											<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
											<button type="submit" data-tone="danger" aria-label={ locale.T(ctx, "action_delete") + " " + adminUserLabel(u) }>
												{ locale.T(ctx, "action_delete") }
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		</div>
		<div id="tab-panel-sessions" role="tabpanel" aria-labelledby="tab-btn-sessions" class={ templ.KV("admin-hidden", activeTab != "sessions") }>
			if len(sessions) == 0 {
				<p>
					{ locale.T(ctx, "admin_no_active_sessions") }
				</p>
			} else {
				<div>
					@ui2.Table(locale.T(ctx, "admin_active_sessions")) {
						<thead>
							<tr>
								<th scope="col"> { locale.T(ctx, "label_user") } </th>
								<th scope="col"> { locale.T(ctx, "label_role") } </th>
								<th scope="col"> { locale.T(ctx, "label_sessions") } </th>
								<th scope="col"> { locale.T(ctx, "label_expires") } </th>
								<th scope="col"> <span class="admin-visually-hidden">{ locale.T(ctx, "label_actions") }</span> </th>
							</tr>
						</thead>
						<tbody>
							for _, s := range sessions {
								<tr>
									<td>
										<strong>{ s.Name }</strong>
										<p>{ s.Email }</p>
									</td>
									<td>
										@RoleBadge(s.Role)
									</td>
									<td> fmt.Sprint(s.SessionCount) </td>
									<td title={ s.ExpiresAt.UTC().Format(time.RFC3339) }>
										{ s.ExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }
									</td>
									<td>
										<form method="POST" action={ templ.SafeURL("/admin/sessions/" + s.UserID.String() + "/revoke") }>
											<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
											<button
												type="submit"
												data-tone="danger"
												aria-label={ locale.T(ctx, "admin_revoke_sessions_for") + " " + s.Name }
											>
												{ locale.T(ctx, "action_revoke") }
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					}
				</div>
			}
		</div>
		<!-- Audit tab -->
		<div id="tab-panel-audit" role="tabpanel" aria-labelledby="tab-btn-audit" class={ templ.KV("admin-hidden", activeTab != "audit") }>
			<nav aria-label={ locale.T(ctx, "label_filter") }>
				<span>{ locale.T(ctx, "label_filter") }:</span>
				<a
					href="/admin?tab=audit&audit=all"
					if auditFilter == "all" { aria-current="page" }
					class={ templ.KV("admin-audit-selected", auditFilter == "all") }
				>{ locale.T(ctx, "audit_filter_all") }</a>
				<a
					href="/admin?tab=audit&audit=delete"
					if auditFilter == "delete" { aria-current="page" }
					class={ templ.KV("admin-audit-selected", auditFilter == "delete") }
				>{ locale.T(ctx, "audit_filter_deletions") }</a>
				<a
					href="/admin?tab=audit&audit=update"
					if auditFilter == "update" { aria-current="page" }
					class={ templ.KV("admin-audit-selected", auditFilter == "update") }
				>{ locale.T(ctx, "audit_filter_updates") }</a>
				<span>{ locale.T(ctx, "audit_last_500") }</span>
			</nav>
			if len(auditLog) == 0 {
				<p>
					{ locale.T(ctx, "admin_no_audit_events") }
				</p>
			} else {
				<div>
					@ui2.Table(locale.T(ctx, "tab_audit")) {
						<thead>
							<tr>
								<th scope="col"> { locale.T(ctx, "label_when") } </th>
								<th scope="col"> { locale.T(ctx, "label_user") } </th>
								<th scope="col"> { locale.T(ctx, "label_event") } </th>
								<th scope="col"> { locale.T(ctx, "label_detail") } </th>
							</tr>
						</thead>
						<tbody>
							for _, e := range auditLog {
								<tr>
									<td title={ e.EventTime.UTC().Format(time.RFC3339) }>
										{ e.EventTime.UTC().Format("2006-01-02 15:04") }
									</td>
									<td>
										if e.UserName != "" {
											{ e.UserName }
										} else {
											<span>{ locale.T(ctx, "label_system") }</span>
										}
									</td>
									<td>
										@adminAuditEventBadge(e.Event)
									</td>
									<td title={ string(e.Attrs) }>
										{ auditAttrsPreview(string(e.Attrs)) }
									</td>
								</tr>
							}
						</tbody>
					}
				</div>
			}
		</div>

		<div id="tab-panel-status" role="tabpanel" aria-labelledby="tab-btn-status" class={ templ.KV("admin-hidden", activeTab != "status") }>
			<div>
				<div>
					<dl>
						<dt>{ locale.T(ctx, "label_version") }</dt>
						<dd>{ version }</dd>
					</dl>
					<dl>
						<dt>{ locale.T(ctx, "label_deploy_time") }</dt>
						<dd title={ startTime.UTC().Format(time.RFC3339) }>
							{ startTime.UTC().Format("2006-01-02 15:04:05 UTC") }
						</dd>
					</dl>
					<dl>
						<dt>{ locale.T(ctx, "label_uptime") }</dt>
						<dd>{ formatUptime(time.Since(startTime)) }</dd>
					</dl>
				</div>
				<section>
					<h2>{ locale.T(ctx, "label_services") }</h2>
					<dl>
						<div>
							<dt>{ locale.T(ctx, "label_application") }</dt>
							<dd>@ui2.Badge("success") {
									<span></span>
									{ locale.T(ctx, "status_healthy") }
								}</dd>
						</div>
						<div>
							<dt>{ locale.T(ctx, "label_database") }</dt>
							<dd>
								if dbOK {
									@ui2.Badge("success") {
										<span></span>
										{ locale.T(ctx, "status_healthy") }
									}
								} else {
									@ui2.Badge("danger") {
										<span></span>
										{ locale.T(ctx, "status_unreachable") }
									}
								}
							</dd>
						</div>
					</dl>
				</section>
			</div>
		</div>
		<!-- Organisations tab -->
		<div id="tab-panel-orgs" role="tabpanel" aria-labelledby="tab-btn-orgs" class={ templ.KV("admin-hidden", activeTab != "orgs") }>
			<div>
				<p>{ locale.T(ctx, "admin_org_tree_help") }</p>
			</div>
			<section>
				<h2>{ locale.T(ctx, "action_add_org_unit") }</h2>
				<form method="POST" action="/admin/orgs">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<div>
						<label for="org_name">{ locale.T(ctx, "label_name") } <span>*</span></label>
						<input
							id="org_name" name="name" type="text" required
							placeholder={ locale.T(ctx, "admin_org_placeholder") }
						/>
					</div>
					<div>
						<label for="org_key">{ locale.T(ctx, "label_key") }</label>
						<input
							id="org_key" name="key" type="text"
							placeholder="e.g. corp, engineering, platform"
						/>
					</div>
					<div>
						<label for="parent_id">{ locale.T(ctx, "admin_parent_unit") }</label>
						<select id="parent_id" name="parent_id">
							<option value="">— { locale.T(ctx, "admin_top_level") } —</option>
							for _, o := range orgs {
								if !o.ParentID.Valid {
									<option value={ o.ID.String() }>{ o.Name }</option>
									for _, child := range orgs {
										if child.ParentID.Valid && child.ParentID.UUID == o.ID {
											<option value={ child.ID.String() }>&nbsp;&nbsp;↳ { child.Name }</option>
										}
									}
								}
							}
						</select>
					</div>
					<div>
						<button type="submit">
							{ locale.T(ctx, "action_add") }
						</button>
					</div>
				</form>
			</section>
			if len(orgs) == 0 {
				<p>
					{ locale.T(ctx, "admin_no_orgs") }
				</p>
			} else {
				<ul>
					for _, o := range orgs {
						if !o.ParentID.Valid {
							@orgRowInline(o, 0, orgs)
						}
					}
				</ul>
			}
		</div>
		<!-- Risk settings tab -->
		<div id="tab-panel-risk" role="tabpanel" aria-labelledby="tab-btn-risk" class={ templ.KV("admin-hidden", activeTab != "risk") }>
			<div>
				<p>{ locale.T(ctx, "admin_risk_settings_help") }</p>
				<form method="POST" action="/admin/risk-settings">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<!-- Thresholds -->
					<fieldset>
						<legend>{ locale.T(ctx, "admin_risk_level_thresholds") }</legend>
						<div>
							<div>
								<label for="low_max">{ locale.T(ctx, "admin_green_lowmax") }</label>
								<input
									id="low_max" name="low_max" type="number" min="1" max="24"
									value={ fmt.Sprint(gs.LowMax) }
								/>
								<p>{ locale.T(ctx, "admin_scores_green_help") }</p>
							</div>
							<div>
								<label for="high_min">{ locale.T(ctx, "admin_red_highmin") }</label>
								<input
									id="high_min" name="high_min" type="number" min="2" max="25"
									value={ fmt.Sprint(gs.HighMin) }
								/>
								<p>{ locale.T(ctx, "admin_scores_red_help") }</p>
							</div>
						</div>
						<p>{ locale.T(ctx, "admin_ns5814_default_help") }</p>
					</fieldset>
					<!-- Acceptance criteria -->
					<div>
						<label for="acceptance_criteria">{ locale.T(ctx, "label_acceptance_criteria") }</label>
						<textarea
							id="acceptance_criteria" name="acceptance_criteria" rows="4"
							placeholder={ locale.T(ctx, "admin_acceptance_criteria_placeholder") }
						>{ gs.AcceptanceCriteria }</textarea>
					</div>
					<!-- Likelihood scale -->
					<fieldset>
						<legend>{ locale.T(ctx, "admin_likelihood_scale") }</legend>
						<p>{ locale.T(ctx, "admin_scale_help") }</p>
						<div>
							<div>
								<span>#</span><span>{ locale.T(ctx, "label_label") }</span><span>{ locale.T(ctx, "label_description") }</span>
							</div>
							for _, i := range []int32{1, 2, 3, 4, 5} {
								@scaleRow("prob", "probability", i, findScaleLabel(scaleLabels, "probability", i))
							}
						</div>
					</fieldset>
					<!-- Consequence scale -->
					<fieldset>
						<legend>{ locale.T(ctx, "admin_consequence_scale") }</legend>
						<p>{ locale.T(ctx, "admin_consequence_scale_help") }</p>
						<div>
							<div>
								<span>#</span><span>{ locale.T(ctx, "label_label") }</span><span>Impact topics</span>
							</div>
							for _, i := range []int32{1, 2, 3, 4, 5} {
								@consequenceScaleRow("cons", i, findScaleLabel(scaleLabels, "consequence", i))
							}
						</div>
					</fieldset>
					<div>
						<button type="submit">
							{ locale.T(ctx, "admin_save_all_settings") }
						</button>
					</div>
				</form>
			</div>
		</div>
		<!-- Modules tab -->
		<div id="tab-panel-modules" role="tabpanel" aria-labelledby="tab-btn-modules" class={ templ.KV("admin-hidden", activeTab != "modules") }>
			<div>
				<p>{ locale.T(ctx, "admin_modules_help") }</p>
				<form method="POST" action="/admin/module-settings">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<fieldset>
						<legend class="admin-visually-hidden">{ locale.T(ctx, "tab_modules") }</legend>
						@moduleToggleRow(locale.T(ctx, "nav_compliance"), "compliance_enabled", appSettings.ComplianceEnabled, locale.T(ctx, "admin_module_compliance_desc"))
						@moduleToggleRow(locale.T(ctx, "nav_section_risk"), "risk_enabled", appSettings.RiskEnabled, locale.T(ctx, "admin_module_risk_desc"))
						@moduleToggleRow(locale.T(ctx, "nav_activities"), "activities_enabled", appSettings.ActivitiesEnabled, locale.T(ctx, "admin_module_activities_desc"))
						@moduleToggleRow(locale.T(ctx, "admin_assets"), "assets_enabled", appSettings.AssetsEnabled, locale.T(ctx, "admin_module_assets_desc"))
						@moduleToggleRow(locale.T(ctx, "nav_avvik"), "avvik_enabled", appSettings.AvvikEnabled, locale.T(ctx, "admin_module_avvik_desc"))
					</fieldset>
					<div>
						<button type="submit">
							{ locale.T(ctx, "action_save") }
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ moduleToggleRow(label, name string, checked bool, description string) {
	<div>
		<div>
			<p>{ label }</p>
			<p>{ description }</p>
		</div>
		<label class="admin-switch">
			<input type="checkbox" name={ name } value="on" checked?={ checked } aria-label={ label } class="admin-switch-input"/>
			<div class="admin-switch-track"></div>
		</label>
	</div>
}

templ adminFlash(flash, flashType string) {
	if flash != "" {
		if flashType == "error" {
			<p role="alert" class="ui2-notice" data-tone="danger">{ flash }</p>
		} else if flashType == "success" {
			<p role="status" class="ui2-notice" data-tone="success">{ flash }</p>
		} else {
			<p role="status" class="ui2-notice">{ flash }</p>
		}
	}
}

templ scaleRow(prefix, scale string, level int32, sl db.RiskScaleLabel) {
	<div class={ "admin-scale-row", scaleRowBg(level) }>
		<span>{ fmt.Sprint(level) }</span>
		<label for={ prefix + "-label-" + fmt.Sprint(level) } class="admin-visually-hidden">{ scale + " label " + fmt.Sprint(level) }</label>
		<input
			id={ prefix + "-label-" + fmt.Sprint(level) }
			type="text"
			name={ prefix + "_label_" + fmt.Sprint(level) }
			value={ sl.Label }
			placeholder={ locale.T(ctx, "admin_short_label_placeholder") }
		/>
		<input
			type="hidden"
			name={ prefix + "_scale_" + fmt.Sprint(level) }
			value={ scale }
		/>
		<label for={ prefix + "-desc-" + fmt.Sprint(level) } class="admin-visually-hidden">{ scale + " description " + fmt.Sprint(level) }</label>
		<textarea
			id={ prefix + "-desc-" + fmt.Sprint(level) }
			name={ prefix + "_desc_" + fmt.Sprint(level) }
			rows="2"
			placeholder={ locale.T(ctx, "admin_scale_description_placeholder") }
		>{ sl.Description }</textarea>
	</div>
}

templ consequenceScaleRow(prefix string, level int32, sl db.RiskScaleLabel) {
	<div class={ "admin-scale-row", scaleRowBg(level) }>
		<span>{ fmt.Sprint(level) }</span>
		<label for={ prefix + "-label-" + fmt.Sprint(level) } class="admin-visually-hidden">{ "consequence label " + fmt.Sprint(level) }</label>
		<input
			id={ prefix + "-label-" + fmt.Sprint(level) }
			type="text"
			name={ prefix + "_label_" + fmt.Sprint(level) }
			value={ sl.Label }
			placeholder={ locale.T(ctx, "admin_short_label_placeholder") }
		/>
		<div>
			<div>
				<label for={ prefix + "-finops-" + fmt.Sprint(level) }>Financial / Operational</label>
				<textarea
					id={ prefix + "-finops-" + fmt.Sprint(level) }
					name={ prefix + "_finops_desc_" + fmt.Sprint(level) }
					rows="2"
				>{ consequenceTopicDescription(sl.Description, "Financial / Operational") }</textarea>
			</div>
			<div>
				<label for={ prefix + "-confdata-" + fmt.Sprint(level) }>Confidentiality / Data</label>
				<textarea
					id={ prefix + "-confdata-" + fmt.Sprint(level) }
					name={ prefix + "_confdata_desc_" + fmt.Sprint(level) }
					rows="2"
				>{ consequenceTopicDescription(sl.Description, "Confidentiality / Data") }</textarea>
			</div>
			<div>
				<label for={ prefix + "-reglegal-" + fmt.Sprint(level) }>Regulatory / Legal</label>
				<textarea
					id={ prefix + "-reglegal-" + fmt.Sprint(level) }
					name={ prefix + "_reglegal_desc_" + fmt.Sprint(level) }
					rows="2"
				>{ consequenceTopicDescription(sl.Description, "Regulatory / Legal") }</textarea>
			</div>
			<div>
				<label for={ prefix + "-reptrust-" + fmt.Sprint(level) }>Reputation / Trust</label>
				<textarea
					id={ prefix + "-reptrust-" + fmt.Sprint(level) }
					name={ prefix + "_reptrust_desc_" + fmt.Sprint(level) }
					rows="2"
				>{ consequenceTopicDescription(sl.Description, "Reputation / Trust") }</textarea>
			</div>
		</div>
	</div>
}

func scaleRowBg(level int32) string {
	if level%2 == 0 {
		return "admin-scale-even"
	}
	return ""
}

func findScaleLabel(labels []db.RiskScaleLabel, scale string, level int32) db.RiskScaleLabel {
	for _, l := range labels {
		if l.Scale == scale && l.Level == level {
			return l
		}
	}
	return db.RiskScaleLabel{Scale: scale, Level: level}
}

func consequenceTopicDescription(desc, topic string) string {
	trimmed := strings.TrimSpace(desc)
	if trimmed == "" {
		return ""
	}
	for _, line := range strings.Split(trimmed, "\n") {
		line = strings.TrimSpace(line)
		if strings.HasPrefix(line, topic+":") {
			return strings.TrimSpace(strings.TrimPrefix(line, topic+":"))
		}
	}
	// Backward compatibility for old single-field descriptions.
	if topic == "Financial / Operational" {
		return trimmed
	}
	return ""
}

templ orgRowInline(o db.Organization, depth int, all []db.Organization) {
	<li>
	<div class={ "admin-org-row", orgRowBgInline(depth) }>
		<span>
			if depth == 1 {
				<span>↳</span>
			}
			if depth == 2 {
				<span>&nbsp;&nbsp;↳</span>
			}
			<span>{ o.Name }</span>
			if o.Key.Valid {
				<code>{ o.Key.String }</code>
			}
		</span>
		<form method="POST" action={ templ.SafeURL("/admin/orgs/" + o.ID.String() + "/delete") } onsubmit="return confirm('Delete this org unit? This may affect linked assessments.')">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<button type="submit" data-tone="danger" aria-label={ "Delete " + o.Name }><span aria-hidden="true">×</span></button>
		</form>
	</div>
	if orgHasChildren(o, all) {
		<ul>
		for _, child := range all {
			if child.ParentID.Valid && child.ParentID.UUID == o.ID {
				@orgRowInline(child, depth+1, all)
			}
		}
		</ul>
	}
	</li>
}

func orgRowBgInline(depth int) string {
	switch depth {
	case 1:
		return "admin-org-child"
	case 2:
		return "admin-org-grandchild"
	default:
		return ""
	}
}

templ adminTab(key, label, activeTab string) {
	<a
		id={ "tab-btn-" + key }
		href={ templ.SafeURL("/admin?tab=" + key) }
		data-tab={ key }
		role="tab"
		aria-controls={ "tab-panel-" + key }
		aria-selected={ fmt.Sprint(activeTab == key) }
		tabindex="0"
	>{ label }</a>
}

templ ProviderBadge(provider string) {
	switch provider {
		case "github":
			@ui2.Badge("neutral") {GitHub}
		case "oidc":
			@ui2.Badge("info") {SSO}
		case "pending":
			@ui2.Badge("warning") { { locale.T(ctx, "admin_pending_sso") } }
		default:
			@ui2.Badge("neutral") { { provider } }
	}
}

templ RoleBadge(role string) {
	switch role {
		case "admin":
			@ui2.Badge("danger") { { locale.T(ctx, "role_admin") } }
		case "editor":
			@ui2.Badge("warning") { { locale.T(ctx, "role_editor") } }
		case "contributor":
			@ui2.Badge("info") { { locale.T(ctx, "role_contributor") } }
		default:
			@ui2.Badge("neutral") { { locale.T(ctx, "role_viewer") } }
	}
}

templ adminAuditEventBadge(event string) {
	switch auditEventAction(event) {
		case "delete":
			@ui2.Badge("danger") { { event } }
		case "update":
			@ui2.Badge("warning") { { event } }
		case "create":
			@ui2.Badge("success") { { event } }
		default:
			@ui2.Badge("neutral") { { event } }
	}
}

func auditEventAction(event string) string {
	parts := strings.Split(event, ".")
	return parts[len(parts)-1]
}

func auditAttrsPreview(attrs string) string {
	if attrs == "{}" || attrs == "" {
		return "—"
	}
	// Trim braces and show inline
	s := strings.TrimPrefix(attrs, "{")
	s = strings.TrimSuffix(s, "}")
	s = strings.ReplaceAll(s, `"`, "")
	if len(s) > 80 {
		return s[:80] + "…"
	}
	return s
}

func adminUserLabel(u db.User) string {
	if name := strings.TrimSpace(u.Name); name != "" {
		return name
	}
	if email := strings.TrimSpace(u.Email); email != "" {
		return email
	}
	return u.ID.String()
}

func relativeTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", m)
	case d < 24*time.Hour:
		h := int(d.Hours())
		if h == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", h)
	default:
		days := int(d.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}

func formatUptime(d time.Duration) string {
	d = d.Round(time.Second)
	days := int(d.Hours()) / 24
	hours := int(d.Hours()) % 24
	minutes := int(d.Minutes()) % 60
	seconds := int(d.Seconds()) % 60
	if days > 0 {
		return fmt.Sprintf("%dd %dh %dm", days, hours, minutes)
	}
	if hours > 0 {
		return fmt.Sprintf("%dh %dm", hours, minutes)
	}
	if minutes > 0 {
		return fmt.Sprintf("%dm %ds", minutes, seconds)
	}
	return fmt.Sprintf("%ds", seconds)
}
