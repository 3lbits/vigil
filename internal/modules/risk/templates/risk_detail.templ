package risktemplates

import (
	"fmt"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	"strings"
)

templ RiskDetail(vm RiskDetailVM) {
	<nav class="risk-detail-back" aria-label="Back to assessment">
		@ui2.Link(templ.SafeURL("/risks/" + vm.Assessment.ID.String()), templ.Attributes{"class": "risk-back-link"}) {
			← { vm.Assessment.Name }
		}
	</nav>
	<div class="risk-detail-heading">
		<header>
			<h2 class="risk-result-name">
				if vm.Risk.RefNum.Valid {
					<span class="risk-monospace">{ riskRef(vm.Risk.RefNum) } ·</span>
				}
				{ vm.Risk.Name }
			</h2>
			if vm.Risk.Description != "" {
				<p class="risk-description">{ vm.Risk.Description }</p>
			}
		</header>
		<div class="risk-controls">
			@previewDecision(vm.Risk.RiskDecision)
			@ui2.Link(templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/decision/" + vm.Risk.ID.String()), templ.Attributes{"class": "risk-secondary-link"}) {
				Edit decision
			}
		</div>
	</div>
	@ui2.Grid() {
		@ui2.Panel() {
			<h3 class="risk-section-heading" style="font-size: 11px">{ locale.T(ctx, "label_current_risk") }</h3>
			if vm.Risk.AssessedAt.Valid {
				<p class="risk-caption">
					Assessed { vm.Risk.AssessedAt.Time.Format("2 Jan 2006 15:04") }
					if vm.AssessedByName != "" {
						<span>· by { vm.AssessedByName }</span>
					}
				</p>
			} else {
				<p class="risk-caption">Assessment date not recorded yet.</p>
			}
			if vm.Risk.LikelihoodCurrent.Valid && vm.Risk.ConsequenceCurrent.Valid {
				<div class="risk-controls">
					<div class={ "risk-score-tile", bgClassT(vm.Risk.LikelihoodCurrent.Int32, vm.Risk.ConsequenceCurrent.Int32, vm.LowMax, vm.HighMin) }>
						{ fmt.Sprint(int(vm.Risk.LikelihoodCurrent.Int32) * int(vm.Risk.ConsequenceCurrent.Int32)) }
					</div>
					<div class="risk-description">
						L{ fmt.Sprint(vm.Risk.LikelihoodCurrent.Int32) } × C{ fmt.Sprint(vm.Risk.ConsequenceCurrent.Int32) }
					</div>
				</div>
				if vm.Risk.LikelihoodReasoning != "" || vm.Risk.ConsequenceReasoning != "" {
					<div class="risk-caption">
						if vm.Risk.LikelihoodReasoning != "" {
							<p><span class="risk-emphasis">Likelihood:</span> { vm.Risk.LikelihoodReasoning }</p>
						}
						if vm.Risk.ConsequenceReasoning != "" {
							<p><span class="risk-emphasis">Consequence:</span> { vm.Risk.ConsequenceReasoning }</p>
						}
					</div>
				}
			} else {
				<p class="risk-description">{ locale.T(ctx, "label_not_scored") }</p>
			}
		}
		@ui2.Panel() {
			<h3 class="risk-section-heading" style="font-size: 11px">{ locale.T(ctx, "label_target_risk") }</h3>
			if vm.Risk.LikelihoodTarget.Valid && vm.Risk.ConsequenceTarget.Valid {
				<div class="risk-controls">
					<div class={ "risk-score-tile", bgClassT(vm.Risk.LikelihoodTarget.Int32, vm.Risk.ConsequenceTarget.Int32, vm.LowMax, vm.HighMin) }>
						{ fmt.Sprint(int(vm.Risk.LikelihoodTarget.Int32) * int(vm.Risk.ConsequenceTarget.Int32)) }
					</div>
					<div class="risk-description">
						L{ fmt.Sprint(vm.Risk.LikelihoodTarget.Int32) } × C{ fmt.Sprint(vm.Risk.ConsequenceTarget.Int32) }
					</div>
				</div>
			} else {
				<p class="risk-description">{ locale.T(ctx, "label_not_scored") }</p>
			}
		}
	}
	if vm.Risk.ReviewNeeded || len(vm.ReviewEvents) > 0 || vm.ReviewRationale != "" {
		@ui2.Panel() {
			<div class="risk-split">
				<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0">{ locale.T(ctx, "label_reassessment") }</h3>
				if vm.Risk.ReviewNeeded {
					<span class="risk-review-badge">{ locale.T(ctx, "status_review_needed") }</span>
				}
			</div>
			if vm.ReassessmentMessage != "" {
				<div role="status" class={ "risk-reassessment-status", templ.KV("risk-reassessment-error", vm.ReassessmentError), templ.KV("risk-reassessment-success", !vm.ReassessmentError) }>{ vm.ReassessmentMessage }</div>
			}
			if len(vm.ReviewEvents) > 0 {
				<div class="risk-spaced">
					<h4 class="risk-caption">{ locale.T(ctx, "label_controls_changed_since_last_assessment") }</h4>
					<ul class="risk-description">
						for _, ev := range vm.ReviewEvents {
							<li class="risk-split">
								<span>
									{ ev.MeasureName }
									<span class="risk-description">· { ev.TriggerStatus }</span>
								</span>
								<span class="risk-caption">{ ev.TriggeredAt.Format("2 Jan 2006") }</span>
							</li>
						}
					</ul>
				</div>
			}
			<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks/" + vm.Risk.ID.String() + "/reassess") }>
				@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
				<div class="risk-two-columns">
					<div>
						<label for="assessed-likelihood">{ locale.T(ctx, "label_assessed_likelihood") }</label>
						@ui2.Select(templ.Attributes{"id": "assessed-likelihood", "name": "assessed_likelihood"}) {
							<option value="">—</option>
							for i := 1; i <= 5; i++ {
								<option value={ fmt.Sprint(i) } selected?={ vm.Risk.LikelihoodCurrent.Valid && int(vm.Risk.LikelihoodCurrent.Int32) == i }>{ fmt.Sprint(i) }</option>
							}
						}
					</div>
					<div>
						<label for="assessed-consequence">{ locale.T(ctx, "label_assessed_consequence") }</label>
						@ui2.Select(templ.Attributes{"id": "assessed-consequence", "name": "assessed_consequence"}) {
							<option value="">—</option>
							for i := 1; i <= 5; i++ {
								<option value={ fmt.Sprint(i) } selected?={ vm.Risk.ConsequenceCurrent.Valid && int(vm.Risk.ConsequenceCurrent.Int32) == i }>{ fmt.Sprint(i) }</option>
							}
						}
					</div>
				</div>
				<label for="assessment-rationale">{ locale.T(ctx, "label_assessment_rationale_optional") }</label>
				@ui2.Textarea(templ.Attributes{"id": "assessment-rationale", "name": "assessment_rationale", "rows": "3"}) { { vm.ReviewRationale } }
				@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_save_reassessment") } }
			</form>
		}
	}
	@riskRecentChanges(vm.AuditLog, "risk-recent-changes")
	if vm.Risk.RiskDecision == "document" && vm.Risk.DecisionNotes != "" {
		@ui2.Panel() {
			<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.5rem">{ locale.T(ctx, "label_documentation_notes") }</h3>
			<p class="risk-preformatted">{ vm.Risk.DecisionNotes }</p>
		}
	}
	<section class="ui2-panel">
		<header class="risk-list-heading">
			<h3 class="risk-list-title" style="font-size: 12px; margin-bottom: 0">{ locale.T(ctx, "label_measures") } ({ fmt.Sprint(len(vm.Measures)) })</h3>
		</header>
		if len(vm.Measures) == 0 {
			<p class="risk-empty-list">{ locale.T(ctx, "label_no_measures_linked") }</p>
		} else {
			for _, m := range vm.Measures {
				@ui2.Link(templ.SafeURL("/measures/" + m.ID.String()), templ.Attributes{"class": "risk-linked-row"}) {
					<div>
						<span class="risk-linked-name">{ m.Name }</span>
						if m.Category != "" {
							<span class="risk-linked-detail">{ m.Category }</span>
						}
					</div>
					@measureStatusBadge(m.Status)
				}
			}
		}
	</section>
	<section class="ui2-panel">
		<header class="risk-list-heading">
			<h3 class="risk-list-title" style="font-size: 12px; margin-bottom: 0">{ locale.T(ctx, "label_assets") } ({ fmt.Sprint(len(vm.Assets)) })</h3>
		</header>
		if len(vm.Assets) == 0 {
			<p class="risk-description">{ locale.T(ctx, "empty_no_assets_linked_to_this_risk") }</p>
		} else {
			for _, a := range vm.Assets {
				<article class="risk-split">
					<div>
						<h4 class="risk-result-name">{ a.Name }</h4>
						if a.Owner != "" {
							<p class="risk-caption">{ a.Owner }</p>
						}
					</div>
					<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks/" + vm.Risk.ID.String() + "/assets/" + a.ID.String() + "/remove") }>
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_q", "value": vm.AssetQuery})
						@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "class": "risk-small-button"}) { { locale.T(ctx, "action_remove") } }
					</form>
				</article>
			}
		}
		<div>
			<form method="GET" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks/" + vm.Risk.ID.String()) } class="risk-controls">
				<label for="asset-q" class="sr-only">{ locale.T(ctx, "label_search_assets") }</label>
				@ui2.Input(templ.Attributes{"id": "asset-q", "name": "asset_q", "type": "search", "value": vm.AssetQuery, "placeholder": locale.T(ctx, "placeholder_search_name_or_owner")})
				@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-secondary-button"}) { { locale.T(ctx, "action_search") } }
			</form>
			if vm.AssetQuery != "" {
				<div class="risk-results">
					if len(vm.AssetResults) == 0 {
						<p class="risk-description">{ locale.T(ctx, "empty_no_matching_assets_found") }</p>
					} else {
						for _, a := range vm.AssetResults {
							<div class="risk-result-row">
								<div class="risk-truncation-container">
									<div class="risk-result-name">{ a.Name }</div>
									if a.Owner != "" {
										<div class="risk-result-detail">{ a.Owner }</div>
									}
								</div>
								<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks/" + vm.Risk.ID.String() + "/assets/" + a.ID.String() + "/add") }>
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_q", "value": vm.AssetQuery})
									@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-small-button"}) { { locale.T(ctx, "action_add") } }
								</form>
							</div>
						}
					}
				</div>
			}
		</div>
	</section>
	<section class="ui2-panel">
		<header class="risk-list-heading">
			<h3 class="risk-list-title" style="font-size: 12px; margin-bottom: 0">{ locale.T(ctx, "label_activities_section") } ({ fmt.Sprint(len(vm.Activities)) })</h3>
		</header>
		if len(vm.Activities) == 0 {
			<p class="risk-empty-list">{ locale.T(ctx, "label_no_activities_linked") }</p>
		} else {
			for _, a := range vm.Activities {
				@ui2.Link(templ.SafeURL("/activities/" + a.ID.String()), templ.Attributes{"class": "risk-linked-row"}) {
					<div>
						<span class="risk-linked-name">{ a.Title }</span>
						if a.Owner != "" {
							<span class="risk-linked-detail">{ a.Owner }</span>
						}
					</div>
					<div class="risk-controls">
						if a.DueDate.Valid {
							<span class="risk-monospace">{ a.DueDate.Time.Format("2 Jan 2006") }</span>
						}
						@activityStatusBadge(a.Status)
					</div>
				}
			}
		}
	</section>
	<div class="risk-detail-delete">
		<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks/" + vm.Risk.ID.String() + "/delete") } onsubmit="return confirm('Delete this risk and all its links?')">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "class": "risk-delete-button"}) {
				{ locale.T(ctx, "action_delete_risk") }
			}
		</form>
	</div>
}

templ riskRecentChanges(auditLog []db.ListAuditLogForRiskRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary>{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		@ui2.Table(locale.T(ctx, "label_recent_changes")) {
			<thead>
				<tr>
					<th scope="col">{ locale.T(ctx, "label_event") }</th>
					<th scope="col">{ locale.T(ctx, "label_by") }</th>
					<th scope="col">{ locale.T(ctx, "label_when") }</th>
				</tr>
			</thead>
			<tbody>
				if len(auditLog) == 0 {
					<tr><td colspan="3">{ locale.T(ctx, "label_no_changes_yet") }</td></tr>
				} else {
					for i, entry := range auditLog {
						if i < 5 {
							<tr>
								<td>{ riskAuditEventLabel(entry.Event) }</td>
								<td>
									if entry.UserName != "" {
										{ entry.UserName }
									} else {
										—
									}
								</td>
								<td><time datetime={ entry.EventTime.Format("2006-01-02T15:04:05Z07:00") }>{ entry.EventTime.Format("2 Jan 2006 15:04") }</time></td>
							</tr>
						}
					}
				}
			</tbody>
		}
	</details>
}

func riskAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

templ measureStatusBadge(status string) {
	switch status {
		case "implemented":
			@ui2.Badge("success") {
				{ locale.T(ctx, "status_implemented") }
			}
		case "in_progress":
			@ui2.Badge("info") {
				{ locale.T(ctx, "status_in_progress") }
			}
		case "deprecated":
			@ui2.Badge("") {
				{ locale.T(ctx, "status_deprecated") }
			}
		default:
			@ui2.Badge("warning") {
				{ locale.T(ctx, "status_planned") }
			}
	}
}

templ activityStatusBadge(status string) {
	switch status {
		case "done":
			@ui2.Badge("success") {
				{ locale.T(ctx, "status_done") }
			}
		case "in_progress":
			@ui2.Badge("info") {
				{ locale.T(ctx, "status_in_progress") }
			}
		case "cancelled":
			@ui2.Badge("") {
				{ locale.T(ctx, "status_cancelled") }
			}
		default:
			@ui2.Badge("warning") {
				{ locale.T(ctx, "status_pending") }
			}
	}
}
