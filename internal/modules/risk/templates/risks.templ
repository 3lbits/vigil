package risktemplates

import (
	"database/sql"
	"fmt"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	"strings"
)

func assessmentRef(n sql.NullInt32) string {
	if !n.Valid {
		return ""
	}
	return fmt.Sprintf("RA-%03d", n.Int32)
}

func riskRef(n sql.NullInt32) string {
	if !n.Valid {
		return ""
	}
	return fmt.Sprintf("R-%03d", n.Int32)
}

func bgClassT(l, c int32, lowMax, highMin int) string {
	score := int(l) * int(c)
	switch {
	case score >= highMin:
		return "risk-score-high"
	case score > lowMax:
		return "risk-score-medium"
	default:
		return "risk-score-low"
	}
}

func countPendingForOwner(assessments []AssessmentListVM, userID string) int {
	n := 0
	for _, a := range assessments {
		if a.Assessment.Status == "pending_acceptance" && a.Assessment.RiskOwnerID.UUID.String() == userID {
			n++
		}
	}
	return n
}

func participantNames(users []db.User) string {
	names := make([]string, 0, len(users))
	for _, u := range users {
		names = append(names, u.Name)
	}
	return strings.Join(names, ", ")
}

templ AssessmentList(vm AssessmentListPageVM) {
	if vm.Flash != "" {
		if vm.FlashType == "error" {
			@ui2.Notice("danger") {
				{ vm.Flash }
			}
		} else {
			@ui2.Notice("success") {
				{ vm.Flash }
			}
		}
	}
	@ui2.Panel() {
		<header class="ui2-actions">
			<p>
				{ locale.TN(ctx, "assessment_count", len(vm.Assessments), map[string]any{"Count": len(vm.Assessments)}) }
			</p>
			@ui2.Link("/risks/new", nil) { { locale.T(ctx, "action_new_assessment") } }
		</header>
		<p class="sr-only" aria-live="polite">Results update automatically when filters change.</p>
		<form action="/risks" method="GET" role="search">
			<label for="assessment-search">{ locale.T(ctx, "label_name") }</label>
			@ui2.Input(templ.Attributes{"id": "assessment-search", "type": "search", "name": "q", "value": vm.Q, "hx-get": "/risks", "hx-target": "#assessment-list", "hx-swap": "innerHTML", "hx-push-url": "true", "hx-include": "closest form", "hx-trigger": "input changed delay:300ms", "hx-on::after-request": templ.JSUnsafeFuncCall("if(event.detail.successful){document.querySelector('#assessment-list [role=region]')?.focus()}")})
			@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_search") } }
		</form>
	}
	<div id="assessment-list" aria-live="polite" aria-atomic="false">
		@AssessmentItems(vm)
	</div>
}

templ AssessmentItems(vm AssessmentListPageVM) {
	if pendingCount := countPendingForOwner(vm.Assessments, vm.CurrentUserID); pendingCount > 0 {
		@ui2.Panel() {
			<span class="risk-strong">{ fmt.Sprint(pendingCount) } assessment(s) await your acceptance.</span>
			<span>Open each assessment below to accept or decline.</span>
		}
	}
	if len(vm.Assessments) == 0 {
		@ui2.Panel() {
			<p>{ locale.T(ctx, "assessment_none_yet") }</p>
			@ui2.Link("/risks/new", nil) { { locale.T(ctx, "assessment_start_first") } }
		}
	} else {
		@ui2.Table(locale.T(ctx, "nav_risk_assessments")) {
			<thead>
				<tr>
					<th scope="col">{ locale.T(ctx, "label_name") }</th>
					<th scope="col">{ locale.T(ctx, "label_risks") }</th>
					<th scope="col">{ locale.T(ctx, "risk_level_high") }</th>
					<th scope="col">{ locale.T(ctx, "label_status") }</th>
					<th scope="col">{ locale.T(ctx, "label_updated") }</th>
					<th scope="col">{ locale.T(ctx, "label_progress") }</th>
				</tr>
			</thead>
			<tbody>
				for _, a := range vm.Assessments {
					<tr>
						<th scope="row">
							@ui2.Link(templ.SafeURL("/risks/" + a.Assessment.ID.String()), nil) {
								if a.Assessment.RefNum.Valid {
									{ assessmentRef(a.Assessment.RefNum) }
								}
								{ a.Assessment.Name }
							}
							if a.Assessment.IsPublic {
								@ui2.Badge("info") {
									{ "Public" }
								}
							}
							if a.Assessment.Scope != "" {
								<small>{ a.Assessment.Scope }</small>
							}
						</th>
						<td>{ fmt.Sprint(a.RiskCount) }</td>
						if a.RedCount > 0 {
							<td>{ fmt.Sprint(a.RedCount) }</td>
						} else {
							<td>—</td>
						}
						<td>
							@previewStatus(a.Assessment.Status)
						</td>
						<td><time datetime={ a.Assessment.UpdatedAt.Format("2006-01-02") }>{ a.Assessment.UpdatedAt.Format("2 Jan 2006") }</time></td>
						<td><progress value={ fmt.Sprint(a.Assessment.CurrentStep) } max="4">{ fmt.Sprint(a.Assessment.CurrentStep) }/4</progress></td>
					</tr>
				}
			</tbody>
		}
	}
}

// ── Risk register (flat list across all assessments) ─────────────────────────
templ RiskRegisterPage(risks []db.ListAllRisksRow, q string, lowMax, highMin int) {
	@ui2.Panel() {
		<p>{ fmt.Sprintf("%d risks", len(risks)) }</p>
		<p class="sr-only" aria-live="polite">Results update automatically when filters change.</p>
		<form action="/risks/register" method="GET" role="search">
			<label for="register-search">{ locale.T(ctx, "label_name") }</label>
			@ui2.Input(templ.Attributes{"id": "register-search", "type": "search", "name": "q", "value": q, "hx-get": "/risks/register", "hx-target": "#risk-register-table", "hx-swap": "innerHTML", "hx-push-url": "true", "hx-include": "closest form", "hx-trigger": "input changed delay:300ms", "hx-on::after-request": templ.JSUnsafeFuncCall("if(event.detail.successful){document.querySelector('#risk-register-table [role=region]')?.focus()}")})
			@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_search") } }
		</form>
	}
	<div id="risk-register-table" aria-live="polite" aria-atomic="false">
		@RiskRegister(risks, q, lowMax, highMin)
	</div>
}

templ RiskRegister(risks []db.ListAllRisksRow, q string, lowMax, highMin int) {
	if len(risks) == 0 {
		@ui2.Panel() {
			<p>{ locale.T(ctx, "risk_none_identified") }</p>
			@ui2.Link("/risks", nil) { Start a risk assessment → }
		}
	} else {
		@ui2.Table(locale.T(ctx, "nav_risk_register")) {
			<thead>
				<tr>
					<th scope="col">Ref</th>
					<th scope="col">{ locale.T(ctx, "label_risk") }</th>
					<th scope="col">{ locale.T(ctx, "label_assessment") }</th>
					<th scope="col">{ locale.T(ctx, "label_current") }</th>
					<th scope="col">{ locale.T(ctx, "label_decision") }</th>
				</tr>
			</thead>
			<tbody>
				for _, risk := range risks {
					<tr>
						<td>{ riskRef(risk.RefNum) }</td>
						<th scope="row">
							@ui2.Link(templ.SafeURL("/risks/" + risk.AssessmentID.String() + "/risks/" + risk.ID.String()), nil) { { risk.Name } }
							if risk.Description != "" {
								<small>{ risk.Description }</small>
							}
						</th>
						<td>
							if risk.AssessmentRefNum.Valid {
								{ assessmentRef(risk.AssessmentRefNum) }
							}
							{ risk.AssessmentName }
						</td>
						<td>
							@previewScore(risk.LikelihoodCurrent, risk.ConsequenceCurrent, lowMax, highMin)
						</td>
						<td>
							@previewDecision(risk.RiskDecision)
						</td>
					</tr>
				}
			</tbody>
		}
	}
}
