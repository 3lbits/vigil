package risktemplates

import (
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/google/uuid"
)

templ WizardStep1(vm WizardStep1VM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, 1, vm.IsNew, vm.ThreatEnabled)
	@wizardFlash(vm.Flash)
	<form
		method="POST"
		action={ templ.SafeURL(wizardPostAction(vm.IsNew, vm.Assessment.ID.String(), "")) }
		class="risk-form-width"
	>
		<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
		<section class="ui2-panel">
			<h2>{ locale.T(ctx, "label_assessment") }</h2>
			<div class="risk-fields">
				<div>
					<label for="name">{ locale.T(ctx, "label_assessment_name") } *</label>
					<input id="name" name="name" type="text" required value={ vm.Assessment.Name } placeholder="e.g. ISMS Annual Risk Assessment 2026"/>
				</div>
				<div class="risk-two-columns">
					<div class="risk-tight-list">
						<label for="org_id">{ locale.T(ctx, "label_organisational_unit") }</label>
						@orgPicker("org_id", vm.Assessment.OrgID, vm.Orgs)
					</div>
					<div class="risk-tight-list">
						<label for="risk_owner_id">{ locale.T(ctx, "label_risk_owner") }</label>
						@userPicker("risk_owner_id", vm.Assessment.RiskOwnerID, vm.Users)
					</div>
				</div>
			</div>
		</section>
		<div class="ui2-panel">
			<div class="risk-fields">
				<div>
					<label for="scope" class="risk-controls">
						{ locale.T(ctx, "label_scope_analysis_object") }
						@helpIcon("Describe what is being assessed — system, process, or asset — and what&#39;s included/excluded.")
					</label>
					<textarea id="scope" name="scope" rows="3" placeholder={ locale.T(ctx, "placeholder_assessment_scope") }>{ vm.Assessment.Scope }</textarea>
				</div>
				<div>
					<label for="security_objectives" class="risk-controls">
						{ locale.T(ctx, "label_objectives") }
						@helpIcon("What are you protecting and why? Security concerns and business/compliance drivers.")
					</label>
					<textarea id="security_objectives" name="security_objectives" rows="3" placeholder={ locale.T(ctx, "placeholder_assessment_objectives") }>{ vm.Assessment.SecurityObjectives }</textarea>
				</div>
			</div>
		</div>
		<div class="ui2-panel">
			<label class="risk-check-option">
				<input
					type="checkbox"
					id="threat_assessment_enabled"
					name="threat_assessment_enabled"
					class="risk-check-input"
					checked?={ vm.ThreatEnabled }
				/>
				<span>
					<span class="risk-controls">
						{ locale.T(ctx, "label_enable_threat_assessment") }
						@helpIcon(locale.T(ctx, "help_enable_threat_assessment_tooltip"))
					</span>
					<span class="risk-description">{ locale.T(ctx, "help_enable_threat_assessment") }</span>
				</span>
			</label>
		</div>
		<section class="ui2-panel">
			<h2 class="risk-section-heading">{ locale.T(ctx, "label_participants") }</h2>
			if vm.IsNew {
				<p class="risk-description">
					Participants can be added after the assessment is created.
				</p>
			} else if len(vm.Users) == 0 {
				<p class="risk-description">No users available.</p>
			} else {
				<div class="risk-spaced">
					<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">Selected</h3>
					if len(vm.Participants) == 0 {
						<p class="risk-description">No participants selected.</p>
					} else {
						<div class="risk-chip-list">
							for _, p := range vm.Participants {
								<button
									type="submit"
									data-tone="danger"
									formmethod="post"
									formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/participants/" + p.ID.String() + "/remove") }
									formnovalidate
									class="risk-participant-chip"
								>
									<span>{ p.Name }</span>
									<span aria-hidden="true">×</span>
								</button>
							}
						</div>
					}
				</div>
				<div class="risk-add-section">
					<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">Add participant</h3>
					<div class="risk-controls">
						<label for="participant-search" class="risk-visually-hidden">{ locale.T(ctx, "label_search_participants") }</label>
						<input id="participant-search" name="participant_q" type="search" value={ vm.ParticipantQuery } placeholder={ locale.T(ctx, "placeholder_search_name_or_email") }/>
						<button
							type="submit"
							formmethod="get"
							formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/review/step/1") }
							formnovalidate
							class="risk-secondary-button"
						>{ locale.T(ctx, "action_search") }</button>
					</div>
					if vm.ParticipantQuery != "" {
						<div class="risk-results">
							if len(vm.ParticipantResults) == 0 {
								<p class="risk-description">No matching users found.</p>
							} else {
								for _, u := range vm.ParticipantResults {
									<div class="risk-result-row">
										<div class="risk-truncation-container">
											<div class="risk-result-name">{ u.Name }</div>
											<div class="risk-result-detail">{ u.Email }</div>
										</div>
										<button
											type="submit"
											formmethod="post"
											formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/participants/" + u.ID.String() + "/add") }
											formnovalidate
											class="risk-small-button"
										>Add</button>
									</div>
								}
							}
						</div>
					}
				</div>
			}
		</section>
		<section class="ui2-panel">
			<h2 class="risk-section-heading">{ locale.T(ctx, "label_assets") }</h2>
			if vm.IsNew {
				<p class="risk-description">
					Assets can be linked after the assessment is created.
				</p>
			} else {
				<div class="risk-spaced">
					<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">Linked</h3>
					if len(vm.Assets) == 0 {
						<p class="risk-description">No assets linked.</p>
					} else {
						<div class="risk-chip-list">
							for _, a := range vm.Assets {
								<button
									type="submit"
									data-tone="danger"
									formmethod="post"
									formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/assets/" + a.ID.String() + "/remove") }
									formnovalidate
									class="risk-asset-chip"
								>
									<span>{ a.Name }</span>
									<span aria-hidden="true">×</span>
								</button>
							}
						</div>
					}
				</div>
				<div class="risk-add-section">
					<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">Link asset</h3>
					<div class="risk-controls">
						<label for="asset-search" class="risk-visually-hidden">{ locale.T(ctx, "label_search_assets") }</label>
						<input id="asset-search" name="asset_q" type="search" value={ vm.AssetQuery } placeholder={ locale.T(ctx, "placeholder_search_name_or_owner") }/>
						<button
							type="submit"
							formmethod="get"
							formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/review/step/1") }
							formnovalidate
							class="risk-secondary-button"
						>{ locale.T(ctx, "action_search") }</button>
					</div>
					if vm.AssetQuery != "" {
						<div class="risk-results">
							if len(vm.AssetResults) == 0 {
								<p class="risk-description">No matching assets found.</p>
							} else {
								for _, a := range vm.AssetResults {
									<div class="risk-result-row">
										<div class="risk-truncation-container">
											<div class="risk-result-name">{ a.Name }</div>
											if a.Owner != "" {
												<div class="risk-result-detail">{ a.Owner }</div>
											}
										</div>
										<button
											type="submit"
											formmethod="post"
											formaction={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/assets/" + a.ID.String() + "/add") }
											formnovalidate
											class="risk-small-button"
										>Add</button>
									</div>
								}
							}
						</div>
					}
				</div>
			}
		</section>
		if vm.AcceptanceCriteria != "" {
			<section class="ui2-panel">
				<div class="risk-split">
					<h2 class="risk-section-heading">{ locale.T(ctx, "label_risk_acceptance_criteria") }</h2>
					<a href="/admin?tab=risk" class="risk-link-toggle">Edit →</a>
				</div>
				<p class="risk-preformatted">{ vm.AcceptanceCriteria }</p>
			</section>
		} else {
			<p class="risk-criteria-missing">
				No global risk acceptance criteria set. <a href="/admin?tab=risk" class="risk-link-toggle">Set criteria in admin →</a>
			</p>
		}
		<div class="risk-end-actions">
			<button type="submit">
				if vm.IsNew {
					Save and identify risks →
				} else {
					Save and continue →
				}
			</button>
		</div>
	</form>
}

// helpIcon renders a keyboard- and pointer-accessible help popover.
templ helpIcon(text string) {
	<span class="risk-help">
		<button type="button" aria-label="Help">?</button>
		<span class="risk-help-text">
			{ text }
		</span>
	</span>
}

func isParticipant(id uuid.UUID, participants []db.User) bool {
	for _, p := range participants {
		if p.ID == id {
			return true
		}
	}
	return false
}

// orgPicker renders a grouped org select — top-level orgs followed by indented children/grandchildren.
templ orgPicker(name string, selected uuid.NullUUID, orgs []db.Organization) {
	<select id={ name } name={ name }>
		<option value="">— none —</option>
		for _, o := range orgs {
			if !o.ParentID.Valid {
				<option value={ o.ID.String() } selected?={ selected.Valid && selected.UUID == o.ID }>{ o.Name }</option>
				for _, child := range orgs {
					if child.ParentID.Valid && child.ParentID.UUID == o.ID {
						<option value={ child.ID.String() } selected?={ selected.Valid && selected.UUID == child.ID }>&nbsp;&nbsp;↳ { child.Name }</option>
						for _, grand := range orgs {
							if grand.ParentID.Valid && grand.ParentID.UUID == child.ID {
								<option value={ grand.ID.String() } selected?={ selected.Valid && selected.UUID == grand.ID }>&nbsp;&nbsp;&nbsp;&nbsp;↳ { grand.Name }</option>
							}
						}
					}
				}
			}
		}
	</select>
}

// userPicker renders a user select matching the pattern used in measures/activities.
templ userPicker(name string, selected uuid.NullUUID, users []db.User) {
	<select id={ name } name={ name }>
		<option value="">— unassigned —</option>
		for _, u := range users {
			<option value={ u.ID.String() } selected?={ selected.Valid && selected.UUID == u.ID }>{ u.Name }</option>
		}
	</select>
}

func wizardPostAction(isNew bool, id, suffix string) string {
	if isNew {
		return "/risks"
	}
	if suffix != "" {
		return "/risks/" + id + suffix
	}
	return "/risks/" + id + "/review/step/1"
}
