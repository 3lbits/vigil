package risktemplates

import (
	"fmt"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
)

// scaleReference renders a collapsible reference panel for likelihood and consequence scales.
templ scaleReference(labels []db.RiskScaleLabel) {
	<details class="ui2-panel">
		<summary class="risk-split">
			<span>{ locale.T(ctx, "scale_reference") }</span>
			<span class="risk-caption">click to expand</span>
		</summary>
		<div class="risk-two-columns">
			<section>
				<h2 class="risk-section-heading" style="font-size: 10px">{ locale.T(ctx, "scale_probability") }</h2>
				<div class="risk-tight-list">
					for _, i := range []int32{1, 2, 3, 4, 5} {
						<div>
							<span class="risk-monospace">{ fmt.Sprint(i) }</span>
							<div>
								<span class="risk-emphasis">{ findLabel(labels, "probability", i) }</span>
								if d := findDesc(labels, "probability", i); d != "" {
									<span class="risk-description">— { d }</span>
								}
							</div>
						</div>
					}
				</div>
			</section>
			<section>
				<h2 class="risk-section-heading" style="font-size: 10px">{ locale.T(ctx, "scale_consequence") }</h2>
				<div class="risk-tight-list">
					for _, i := range []int32{1, 2, 3, 4, 5} {
						<div>
							<span class="risk-monospace">{ fmt.Sprint(i) }</span>
							<div>
								<span class="risk-emphasis">{ findLabel(labels, "consequence", i) }</span>
								if d := findDesc(labels, "consequence", i); d != "" {
									<span class="risk-description">— { d }</span>
								}
							</div>
						</div>
					}
				</div>
			</section>
		</div>
	</details>
}

func findLabel(labels []db.RiskScaleLabel, scale string, level int32) string {
	for _, l := range labels {
		if l.Scale == scale && l.Level == level {
			return l.Label
		}
	}
	return fmt.Sprint(level)
}

func findDesc(labels []db.RiskScaleLabel, scale string, level int32) string {
	for _, l := range labels {
		if l.Scale == scale && l.Level == level {
			return l.Description
		}
	}
	return ""
}

templ WizardStep3(vm WizardStep3VM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(3, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	if len(vm.Risks) == 0 {
		<div class="ui2-panel">
			<p class="risk-description">{ locale.T(ctx, "risk_none_identified") }</p>
			<a href={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/2") } class="risk-link-toggle">← { locale.T(ctx, "action_go_back_add_risks_first") }</a>
		</div>
	} else {
		<p class="risk-description">{ locale.T(ctx, "text_risk_scoring_guidance") }</p>
		if len(vm.ScaleLabels) > 0 {
			@scaleReference(vm.ScaleLabels)
		}
		<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/3") }>
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div class="risk-fields">
				for _, risk := range vm.Risks {
					@riskScoreRow(risk, vm.LowMax, vm.HighMin)
				}
			</div>
			<div class="risk-split">
				<a href={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/2") } class="risk-back-link">← { locale.T(ctx, "action_back_to_identify") }</a>
				<button type="submit">{ locale.T(ctx, "action_save_evaluate") } →</button>
			</div>
		</form>
	}
}

templ riskScoreRow(risk db.Risk, lowMax, highMin int) {
	<section
		class="ui2-panel"
		x-data="{ expanded: true }"
	>
		<h2 style="font-size: 13px">
			<button
				type="button"
				@click="expanded = !expanded"
				:aria-expanded="expanded.toString()"
				aria-controls={ "risk-body-" + risk.ID.String() }
				class="risk-split"
			>
				<span class="risk-result-name">{ risk.Name }</span>
				<span class="risk-caption" x-text="expanded ? 'Hide details' : 'Show details'"></span>
			</button>
		</h2>
		<div
			id={ "risk-body-" + risk.ID.String() }
			x-show="expanded"
			class="risk-following-wide"
			x-data={ fmt.Sprintf("riskScorer(%d,%d,%d,%d)", risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32, highMin, lowMax) }
		>
			if risk.Description != "" {
				<p class="risk-caption">{ risk.Description }</p>
			}
			<div class="risk-spaced">
				@scorePanel(risk.ID.String(), "current", "label_current_risk", "label_with_existing_controls", int(risk.LikelihoodCurrent.Int32), int(risk.ConsequenceCurrent.Int32), risk.LikelihoodCurrent.Valid)
			</div>
			<div class="risk-two-columns">
				<div>
					<label for={ "lr-" + risk.ID.String() }>{ locale.T(ctx, "label_likelihood_reasoning") }</label>
					<textarea id={ "lr-" + risk.ID.String() } name={ "likelihood_reasoning_" + risk.ID.String() } rows="2" placeholder={ locale.T(ctx, "placeholder_likelihood_reasoning") }>{ risk.LikelihoodReasoning }</textarea>
				</div>
				<div>
					<label for={ "cr-" + risk.ID.String() }>{ locale.T(ctx, "label_consequence_reasoning") }</label>
					<textarea id={ "cr-" + risk.ID.String() } name={ "consequence_reasoning_" + risk.ID.String() } rows="2" placeholder={ locale.T(ctx, "placeholder_consequence_reasoning") }>{ risk.ConsequenceReasoning }</textarea>
				</div>
			</div>
		</div>
	</section>
}

// scorePanel renders a current risk scoring panel with Alpine.js live color.
// Expects a parent x-data="riskScorer(...)" with properties l (likelihood) and c (consequence).
templ scorePanel(riskID, kind, labelKey, subKey string, l, c int, valid bool) {
	<fieldset class="risk-score-fieldset">
		<legend class="risk-caption">{ locale.T(ctx, labelKey) }</legend>
		<p class="risk-caption">{ locale.T(ctx, subKey) }</p>
		<div class="risk-score-fields">
			<div>
				<label for={ kind + "-likelihood-" + riskID } class="risk-caption">{ locale.T(ctx, "label_likelihood_1_5") }</label>
				<select id={ kind + "-likelihood-" + riskID } name={ kind + "_likelihood_" + riskID } x-model="l">
					<option value="0">—</option>
					for i := 1; i <= 5; i++ {
						<option value={ fmt.Sprint(i) } selected?={ valid && l == i }>{ fmt.Sprint(i) } { likelihoodLabel(i) }</option>
					}
				</select>
			</div>
			<div>
				<label for={ kind + "-consequence-" + riskID } class="risk-caption">{ locale.T(ctx, "label_consequence_1_5") }</label>
				<select id={ kind + "-consequence-" + riskID } name={ kind + "_consequence_" + riskID } x-model="c">
					<option value="0">—</option>
					for i := 1; i <= 5; i++ {
						<option value={ fmt.Sprint(i) } selected?={ valid && c == i }>{ fmt.Sprint(i) } { consequenceLabel(i) }</option>
					}
				</select>
			</div>
		</div>
		<template x-if="l > 0 && c > 0">
			<div
				class="risk-live-score"
				:class="'risk-score-' + level(score())"
			>
				<span x-text="'Score: ' + score()"></span>
				<span class="risk-score-label" x-text="label(score())"></span>
			</div>
		</template>
	</fieldset>
}

func likelihoodLabel(i int) string {
	switch i {
	case 1:
		return "(Very unlikely)"
	case 2:
		return "(Unlikely)"
	case 3:
		return "(Possible)"
	case 4:
		return "(Likely)"
	default:
		return "(Very likely)"
	}
}

func consequenceLabel(i int) string {
	switch i {
	case 1:
		return "(Negligible)"
	case 2:
		return "(Minor)"
	case 3:
		return "(Moderate)"
	case 4:
		return "(Severe)"
	default:
		return "(Critical)"
	}
}
