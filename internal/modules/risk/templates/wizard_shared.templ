package risktemplates

import (
	"context"
	"fmt"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ RiskPage(content templ.Component) {
	@ui2.Page("ui2-risk") {
		@content
	}
}

// wizardShell renders the wizard progress header.
templ wizardShell(assessmentID, assessmentName string, step int, isNew, threatEnabled bool) {
	<header>
		if assessmentName != "" && !isNew {
			<p>{ assessmentName }</p>
		}
		<nav aria-label={ locale.T(ctx, "nav_risk_assessments") }>
			for i, item := range wizardSteps(ctx, threatEnabled) {
				<span>
					if i+1 < step && !isNew && assessmentID != "" {
						@ui2.Link(templ.SafeURL(wizardStepHref(assessmentID, item.Key)), nil) { { fmt.Sprint(i + 1) }. { item.Label } }
					} else if i+1 == step {
						<strong aria-current="step">{ fmt.Sprint(i + 1) }. { item.Label }</strong>
					} else {
						<span>{ fmt.Sprint(i + 1) }. { item.Label }</span>
					}
				</span>
			}
		</nav>
	</header>
}

type wizardStepItem struct {
	Key   string
	Label string
}

func wizardSteps(ctx context.Context, threatEnabled bool) []wizardStepItem {
	steps := []wizardStepItem{
		{Key: "framework", Label: locale.T(ctx, "wizard_step_framework")},
	}
	if threatEnabled {
		steps = append(steps, wizardStepItem{Key: "threat", Label: locale.T(ctx, "wizard_step_threat")})
	}
	steps = append(steps,
		wizardStepItem{Key: "identify", Label: locale.T(ctx, "wizard_step_identify")},
		wizardStepItem{Key: "analyse", Label: locale.T(ctx, "wizard_step_analyse")},
		wizardStepItem{Key: "treat", Label: locale.T(ctx, "wizard_step_treat")},
	)
	return steps
}

func wizardStepHref(id, key string) string {
	switch key {
	case "framework":
		return "/risks/" + id + "/review/step/1"
	case "threat":
		return "/risks/" + id + "/review/step/threat"
	case "identify":
		return "/risks/" + id + "/step/2"
	case "analyse":
		return "/risks/" + id + "/step/3"
	default:
		return "/risks/" + id + "/decision"
	}
}

func wizardDisplayStep(baseStep int, threatEnabled bool) int {
	if threatEnabled && baseStep > 1 {
		return baseStep + 1
	}
	return baseStep
}

templ wizardFlash(flash string) {
	if flash != "" {
		@ui2.Notice("danger") {
			{ flash }
		}
	}
}

// reviewBanner renders a banner for review mode.
templ reviewBanner(a db.RiskAssessment) {
	@ui2.Panel() {
		<h3>{ locale.T(ctx, "label_review_mode") }</h3>
		<p>
			Reviewing existing assessment. Confirm or update each step.
			if a.LastReviewedAt.Valid {
				Last reviewed: { a.LastReviewedAt.Time.Format("2 Jan 2006") }.
			}
		</p>
	}
}

// riskLevelBadge renders a level badge.
templ riskLevelBadge(level string) {
	switch level {
		case "red":
			@ui2.Badge("danger") {
				{ locale.T(ctx, "risk_level_high") }
			}
		case "yellow":
			@ui2.Badge("warning") {
				{ locale.T(ctx, "risk_level_medium") }
			}
		default:
			@ui2.Badge("success") {
				{ locale.T(ctx, "risk_level_low") }
			}
	}
}
