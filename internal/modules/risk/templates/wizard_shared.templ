package risktemplates

import (
	"fmt"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
)

// wizardShell renders the wizard progress header.
// step: 1=Framework, 2=Identify, 3=Analyse, 4=Treat
templ wizardShell(assessmentID, assessmentName string, step int, isNew bool) {
	<!-- Wizard header -->
	<div class="mb-6">
		if assessmentName != "" && !isNew {
			<div class="text-[11px] text-sand-700 mb-1">{ assessmentName }</div>
		}
		<div class="flex items-center gap-1 flex-wrap">
			for i, label := range []string{locale.T(ctx, "wizard_step_framework"), locale.T(ctx, "wizard_step_identify"), locale.T(ctx, "wizard_step_analyse"), locale.T(ctx, "wizard_step_treat")} {
				<div class="flex items-center gap-1">
					if i > 0 {
						<span class="text-sand-300 text-[12px] mx-1">›</span>
					}
					if i+1 < step && !isNew && assessmentID != "" {
						<a
							href={ templ.SafeURL(wizardStepHref(assessmentID, i+1)) }
							class="flex items-center gap-1.5 text-[12px] text-blue-600 hover:underline"
						>
							<span class="w-5 h-5 rounded-full text-white bg-blue-600 text-[10px] font-bold flex items-center justify-center shrink-0">{ fmt.Sprint(i + 1) }</span>
							{ label }
						</a>
					} else if i+1 == step {
						<div class="flex items-center gap-1.5 text-[12px] font-semibold text-sand-900">
							<span class="w-5 h-5 rounded-full bg-sand-900 text-white text-[10px] font-bold flex items-center justify-center shrink-0">{ fmt.Sprint(i + 1) }</span>
							{ label }
						</div>
					} else {
						<div class="flex items-center gap-1.5 text-[12px] text-sand-700">
							<span class="w-5 h-5 rounded-full border border-sand-300 text-sand-700 text-[10px] font-bold flex items-center justify-center shrink-0">{ fmt.Sprint(i + 1) }</span>
							{ label }
						</div>
					}
				</div>
			}
		</div>
	</div>
}

func wizardStepHref(id string, step int) string {
	switch step {
	case 1:
		return "/risks/" + id + "/review/step/1"
	case 2:
		return "/risks/" + id + "/step/2"
	case 3:
		return "/risks/" + id + "/step/3"
	default:
		return "/risks/" + id + "/decision"
	}
}

templ wizardFlash(flash string) {
	if flash != "" {
		<div role="alert" class="mb-4 px-4 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-800 text-[13px]">{ flash }</div>
	}
}

// reviewBanner renders a banner for review mode.
templ reviewBanner(a db.RiskAssessment) {
	<div class="mb-4 flex items-start gap-2.5 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-[12px] text-amber-800">
		<span class="font-semibold shrink-0">{ locale.T(ctx, "label_review_mode") }</span>
		<span>
			Reviewing existing assessment. Confirm or update each step.
			if a.LastReviewedAt.Valid {
				Last reviewed: { a.LastReviewedAt.Time.Format("2 Jan 2006") }.
			}
		</span>
	</div>
}

// riskLevelBadge renders a level badge.
templ riskLevelBadge(level string) {
	switch level {
		case "red":
			@ui.Badge(ui.BadgeProps{
				Variant: "danger",
				Class:   "text-[10px] font-bold px-1.5 rounded",
			}) { { locale.T(ctx, "risk_level_high") } }
		case "yellow":
			@ui.Badge(ui.BadgeProps{
				Variant: "warning",
				Class:   "text-[10px] font-bold px-1.5 rounded",
			}) { { locale.T(ctx, "risk_level_medium") } }
		default:
			@ui.Badge(ui.BadgeProps{
				Variant: "success",
				Class:   "text-[10px] font-bold px-1.5 rounded",
			}) { { locale.T(ctx, "risk_level_low") } }
	}
}
