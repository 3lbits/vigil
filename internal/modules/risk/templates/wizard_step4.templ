package risktemplates

import (
	"fmt"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	formstemplates "github.com/3lbits/vigil/internal/ui2/forms"
	"github.com/google/uuid"
)

templ WizardStep4(vm WizardStep4VM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(4, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	<div class="risk-wide">
		if len(vm.Risks) == 0 {
			<div class="ui2-panel">
				<p class="risk-description">{ locale.T(ctx, "empty_no_risks_marked_treatment") }</p>
				<p class="risk-description">{ locale.T(ctx, "text_all_risks_accepted_or_escalated") }</p>
				<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/4") }>
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
					@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_finalise_assessment") } }
				</form>
			</div>
		} else {
			<p class="risk-description">{ locale.T(ctx, "text_link_controls_and_activities_to_treat_risks") }</p>
			<div class="risk-fields">
				for _, risk := range vm.Risks {
					@treatmentPanel(risk, vm.RiskMeasures[risk.ID], vm.RiskActivities[risk.ID], vm.Users, vm.Assessment.ID, vm.OverdueRisks[risk.ID], vm.LowMax, vm.HighMin)
				}
			</div>
			<div class="risk-split">
				@ui2.Link(templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/3/evaluate"), templ.Attributes{"class": "risk-back-link"}) { ← { locale.T(ctx, "action_back_to_evaluation") } }
				<form id="finalise-form" method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/4") }>
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
					@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_finalise_assessment") } }
				</form>
			</div>
		}
	</div>
}

templ treatmentPanel(risk db.Risk, measures []db.Measure, activities []db.Activity, users []db.User, assessmentID uuid.UUID, overdue bool, lowMax, highMin int) {
	<section
		class={ "ui2-panel", treatmentBorderClass(overdue) }
		x-data={ fmt.Sprintf("treatmentScorer(%d,%d,%d,%d)", risk.LikelihoodTarget.Int32, risk.ConsequenceTarget.Int32, highMin, lowMax) }
	>
		<div id={ "risk-status-" + risk.ID.String() } class="sr-only" aria-live="polite" aria-atomic="true"></div>
		<div class="risk-chip-list">
			<h2 id={ "risk-heading-" + risk.ID.String() } tabindex="-1" class="risk-result-name" style="font-size: 13px">{ risk.Name }</h2>
			if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
				<div class={ "risk-score-tile", bgClassT(risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32, lowMax, highMin) }>
					Current: L{ fmt.Sprint(risk.LikelihoodCurrent.Int32) }×C{ fmt.Sprint(risk.ConsequenceCurrent.Int32) }={ scoreStr(risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32) }
				</div>
			}
			if overdue {
				<div class="risk-error-text">⚠ Overdue activities</div>
			}
		</div>
		<fieldset class="risk-score-fieldset">
			<legend class="risk-caption">{ locale.T(ctx, "label_target_risk") }</legend>
			<p class="risk-caption">{ locale.T(ctx, "label_after_planned_treatment") }</p>
			<div class="risk-score-fields">
				<div>
					<label for={ "tl-" + risk.ID.String() } class="risk-caption">{ locale.T(ctx, "label_likelihood_1_5") }</label>
					@ui2.Select(templ.Attributes{"id": "tl-" + risk.ID.String(), "name": "target_likelihood_" + risk.ID.String(), "form": "finalise-form", "x-model": "tl"}) {
						<option value="0">—</option>
						for i := 1; i <= 5; i++ {
							<option value={ fmt.Sprint(i) } selected?={ risk.LikelihoodTarget.Valid && int(risk.LikelihoodTarget.Int32) == i }>{ fmt.Sprint(i) } { likelihoodLabel(i) }</option>
						}
					}
				</div>
				<div>
					<label for={ "tc-" + risk.ID.String() } class="risk-caption">{ locale.T(ctx, "label_consequence_1_5") }</label>
					@ui2.Select(templ.Attributes{"id": "tc-" + risk.ID.String(), "name": "target_consequence_" + risk.ID.String(), "form": "finalise-form", "x-model": "tc"}) {
						<option value="0">—</option>
						for i := 1; i <= 5; i++ {
							<option value={ fmt.Sprint(i) } selected?={ risk.ConsequenceTarget.Valid && int(risk.ConsequenceTarget.Int32) == i }>{ fmt.Sprint(i) } { consequenceLabel(i) }</option>
						}
					}
				</div>
			</div>
			<template x-if="tl > 0 && tc > 0">
				<div
					class="risk-live-score"
					:class="'risk-score-' + label(tl * tc).toLowerCase()"
				>
					<span x-text="'Score: ' + (tl * tc)"></span>
					<span class="risk-score-label" x-text="label(tl * tc)"></span>
				</div>
			</template>
		</fieldset>
		<div id={ "linked-measures-" + risk.ID.String() } class="risk-chip-list">
			for _, m := range measures {
				@measureChip(m, risk.ID.String(), assessmentID.String())
			}
		</div>
		<div id={ "linked-activities-" + risk.ID.String() } class="risk-chip-list">
			for _, a := range activities {
				@activityChip(a, risk.ID.String(), assessmentID.String())
			}
		</div>
		<div x-data={ fmt.Sprintf("{ expanded: %v }", len(measures) == 0) } class="risk-spaced">
			@ui2.Button(templ.Attributes{"type": "button", "@click": "expanded=!expanded", "class": "risk-link-toggle"}) {
				<span x-text="expanded ? '↑ Hide' : '+ New measure'"></span>
			}
			<div x-show="expanded">
				<form
					method="POST"
					action={ templ.SafeURL("/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/measures/new") }
					hx-post={ "/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/measures/new" }
					hx-target={ "#linked-measures-" + risk.ID.String() }
					hx-swap="beforeend"
					@htmx:after-request="if($event.detail.successful){ $el.reset(); expanded=false }"
					class="risk-create-form"
				>
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
					@formstemplates.MeasureCreateFields(users, "risk-"+risk.ID.String())
					<div class="risk-end-actions">
						@ui2.Button(templ.Attributes{"type": "submit"}) { Create &amp; link }
					</div>
				</form>
			</div>
		</div>
		<div class="risk-fields">
			<details>
				<summary>Link existing measure</summary>
				<div class="risk-following">
					<form method="GET" action={ templ.SafeURL("/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/measures/search") } class="risk-controls">
						<label for={ "measure-search-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_search_measures") }</label>
						@ui2.Input(templ.Attributes{"id": "measure-search-" + risk.ID.String(), "name": "q", "type": "text", "placeholder": locale.T(ctx, "placeholder_search_measures"), "hx-get": "/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/measures/search", "hx-trigger": "input changed delay:300ms", "hx-target": "#measure-results-" + risk.ID.String()})
						@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-secondary-button"}) { { locale.T(ctx, "action_search") } }
					</form>
					<div id={ "measure-results-" + risk.ID.String() } class="risk-following" aria-live="polite" aria-atomic="false"></div>
				</div>
			</details>
			<details>
				<summary>Link existing activity</summary>
				<div class="risk-following">
					<form method="GET" action={ templ.SafeURL("/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/activities/search") } class="risk-controls">
						<label for={ "activity-search-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_search_activities") }</label>
						@ui2.Input(templ.Attributes{"id": "activity-search-" + risk.ID.String(), "name": "q", "type": "text", "placeholder": locale.T(ctx, "placeholder_search_activities"), "hx-get": "/risks/" + assessmentID.String() + "/risks/" + risk.ID.String() + "/activities/search", "hx-trigger": "input changed delay:300ms", "hx-target": "#activity-results-" + risk.ID.String()})
						@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-secondary-button"}) { { locale.T(ctx, "action_search") } }
					</form>
					<div id={ "activity-results-" + risk.ID.String() } class="risk-following" aria-live="polite" aria-atomic="false"></div>
				</div>
			</details>
		</div>
	</section>
}

templ measureChip(m db.Measure, riskID, assessmentID string) {
	<div id={ "chip-m-" + m.ID.String() + "-" + riskID } class="risk-measure-chip">
		<span class="risk-strong">Measure:</span>
		@ui2.Link(templ.SafeURL("/measures/" + m.ID.String()), templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "class": "risk-chip-name"}) { { m.Name } }
		if m.Status != "" {
			<span class="risk-chip-status">{ m.Status }</span>
		}
		if m.Category != "" {
			<span class="risk-chip-category">{ m.Category }</span>
		}
		<form
			method="POST"
			action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/measures/" + m.ID.String() + "/delete") }
			hx-delete={ "/risks/" + assessmentID + "/risks/" + riskID + "/measures/" + m.ID.String() }
			hx-target={ "#chip-m-" + m.ID.String() + "-" + riskID }
			hx-swap="outerHTML"
		>
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "hx-on::after-request": templ.JSUnsafeFuncCall("this.closest('[x-data]')?.querySelector('[id^=risk-status-]')?.replaceChildren(document.createTextNode('Measure unlinked')); this.closest('[x-data]')?.querySelector('[id^=risk-heading-]')?.focus()"), "aria-label": "Unlink " + m.Name, "class": "risk-chip-remove"}) { × }
		</form>
	</div>
}

templ activityChip(a db.Activity, riskID, assessmentID string) {
	<div id={ "chip-a-" + a.ID.String() + "-" + riskID } class="risk-activity-chip">
		<span class="risk-strong">Activity:</span>
		<span class="risk-chip-name">{ a.Title }</span>
		<form
			method="POST"
			action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/activities/" + a.ID.String() + "/delete") }
			hx-delete={ "/risks/" + assessmentID + "/risks/" + riskID + "/activities/" + a.ID.String() }
			hx-target={ "#chip-a-" + a.ID.String() + "-" + riskID }
			hx-swap="outerHTML"
		>
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "hx-on::after-request": templ.JSUnsafeFuncCall("this.closest('[x-data]')?.querySelector('[id^=risk-status-]')?.replaceChildren(document.createTextNode('Activity unlinked')); this.closest('[x-data]')?.querySelector('[id^=risk-heading-]')?.focus()"), "aria-label": "Unlink " + a.Title, "class": "risk-chip-remove"}) { × }
		</form>
	</div>
}

// MeasureSearchResults is the HTMX partial for measure search results.
templ MeasureSearchResults(measures []db.Measure, riskID, assessmentID string) {
	if len(measures) > 0 {
		<div class="risk-search-results">
			for _, m := range measures {
				<div class="risk-search-result">
					<form
						method="POST"
						action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/measures/" + m.ID.String()) }
						hx-post={ "/risks/" + assessmentID + "/risks/" + riskID + "/measures/" + m.ID.String() }
						hx-target={ "#linked-measures-" + riskID }
						hx-swap="beforeend"
						class="risk-fill"
					>
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
						@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-search-choice"}) {
							{ m.Name }
							if m.Category != "" {
								<span class="risk-caption">{ m.Category }</span>
							}
							if m.Status != "" {
								<span class="risk-caption">· { m.Status }</span>
							}
						}
					</form>
					@ui2.Link(templ.SafeURL("/measures/" + m.ID.String()), templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "class": "risk-secondary-link"}) {
						Open ↗
					}
				</div>
			}
		</div>
	}
}

// ActivitySearchResults is the HTMX partial for activity search results.
templ ActivitySearchResults(activities []db.Activity, riskID, assessmentID string) {
	if len(activities) > 0 {
		<div class="risk-search-results">
			for _, a := range activities {
				<form
					method="POST"
					action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/activities/" + a.ID.String()) }
					hx-post={ "/risks/" + assessmentID + "/risks/" + riskID + "/activities/" + a.ID.String() }
					hx-target={ "#linked-activities-" + riskID }
					hx-swap="beforeend"
				>
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
					@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-search-choice"}) {
						{ a.Title }
						<span class="risk-caption">{ a.ActivityType }</span>
					}
				</form>
			}
		</div>
	}
}

// LinkedMeasureChip is the HTMX partial returned after linking a measure.
templ LinkedMeasureChip(m db.Measure, riskID, assessmentID string) {
	@measureChip(m, riskID, assessmentID)
}

// LinkedActivityChip is the HTMX partial returned after linking an activity.
templ LinkedActivityChip(a db.Activity, riskID, assessmentID string) {
	@activityChip(a, riskID, assessmentID)
}

// LinkedMeasureWithActivity is returned by QuickCreateMeasure when a due date was set.
// The primary swap adds the measure chip; the OOB swap appends the activity chip.
templ LinkedMeasureWithActivity(m db.Measure, a db.Activity, riskID, assessmentID string) {
	@measureChip(m, riskID, assessmentID)
	<div hx-swap-oob={ "beforeend:#linked-activities-" + riskID }>
		@activityChip(a, riskID, assessmentID)
	</div>
}

func treatmentBorderClass(overdue bool) string {
	if overdue {
		return "risk-treatment-overdue"
	}
	return ""
}

func scoreStr(l, c int32) string {
	return fmt.Sprint(int(l) * int(c))
}
