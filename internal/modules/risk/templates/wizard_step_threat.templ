package risktemplates

import (
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	"strings"
)

templ WizardStepThreat(vm WizardStepThreatVM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, 2, false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	@wizardFlash(vm.Flash)
	<form method="POST" action={ templ.SafeURL(threatStepFormAction(vm.Assessment.ID.String(), vm.IsReview)) } class="risk-narrow">
		<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
		<section class="ui2-panel">
			<h2>{ locale.T(ctx, "heading_threat_context") }</h2>
			<p class="risk-description">{ locale.T(ctx, "text_threat_context_guidance") }</p>
			<ul class="risk-threat-tips">
				<li>{ locale.T(ctx, "text_threat_context_tip_1") }</li>
				<li>{ locale.T(ctx, "text_threat_context_tip_2") }</li>
				<li>{ locale.T(ctx, "text_threat_context_tip_3") }</li>
			</ul>
			<aside class="risk-threat-assets">
				<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">{ locale.T(ctx, "label_threat_asset_context") }</h3>
				if len(vm.Assets) == 0 {
					<p class="risk-info-description">{ locale.T(ctx, "text_threat_asset_context_none") }</p>
				} else {
					<p class="risk-info-description">{ locale.T(ctx, "text_threat_asset_context_hint") }</p>
					<div class="risk-two-columns">
						for _, asset := range vm.Assets {
							<article class="risk-threat-asset">
								<h4 class="risk-strong">{ asset.Name }</h4>
								<div class="risk-info-description">
									{ locale.T(ctx, "label_asset_type") }: { compactAssetField(asset.AssetType) }
									<span>·</span>
									{ locale.T(ctx, "label_asset_owner") }: { compactAssetField(asset.Owner) }
								</div>
								<div class="risk-controls">
									switch asset.Status {
										case "planned":
											@ui2.Badge("warning") {
												{ locale.T(ctx, "status_planned") }
											}
										case "retired":
											@ui2.Badge("") {
												{ locale.T(ctx, "status_retired") }
											}
										default:
											@ui2.Badge("success") {
												{ locale.T(ctx, "status_active") }
											}
									}
									switch asset.Criticality {
										case "low":
											@ui2.Badge("") {
												{ locale.T(ctx, "risk_level_low") }
											}
										case "high":
											@ui2.Badge("danger") {
												{ locale.T(ctx, "risk_level_high") }
											}
										default:
											@ui2.Badge("warning") {
												{ locale.T(ctx, "risk_level_medium") }
											}
									}
								</div>
								if desc := compactAssetDescription(asset.Description); desc != "" {
									<div class="risk-info-description">{ desc }</div>
								}
							</article>
						}
					</div>
				}
			</aside>
			<div class="risk-fields">
				<div>
					<label for="threat_app_description">{ locale.T(ctx, "label_threat_app_description") }</label>
					<textarea id="threat_app_description" name="threat_app_description" rows="5" placeholder={ locale.T(ctx, "placeholder_threat_app_description") }>{ vm.Assessment.ThreatAppDescription }</textarea>
				</div>
				<div x-data="mermaidPreview()">
					<label for="threat_information_flow" class="risk-controls">
						{ locale.T(ctx, "label_threat_information_flow") }
						@helpIcon(locale.T(ctx, "help_threat_information_flow"))
					</label>
					<textarea id="threat_information_flow" name="threat_information_flow" rows="8" x-ref="src" class="risk-monospace" placeholder={ locale.T(ctx, "placeholder_threat_information_flow") }>{ vm.Assessment.ThreatInformationFlow }</textarea>
					<div class="risk-controls">
						<button type="button" @click="render()" :disabled="rendering" class="risk-secondary-button">
							<span x-show="!rendering">{ locale.T(ctx, "action_update_diagram") }</span>
							<span x-show="rendering" x-cloak>{ locale.T(ctx, "label_rendering") }</span>
						</button>
						<span x-show="error" x-text="error" class="risk-error-text"></span>
					</div>
					<div class="risk-diagram">
						<div x-ref="out"></div>
					</div>
				</div>
			</div>
		</section>
		<div class="risk-split">
			<a href={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/review/step/1") } class="risk-back-link">← { locale.T(ctx, "action_back_to_framework") }</a>
			<button type="submit">{ locale.T(ctx, "action_save_continue_identify") } →</button>
		</div>
	</form>
}

func threatStepFormAction(id string, isReview bool) string {
	if isReview {
		return "/risks/" + id + "/review/step/threat"
	}
	return "/risks/" + id + "/step/threat"
}

func compactAssetField(v string) string {
	if strings.TrimSpace(v) == "" {
		return "—"
	}
	return v
}

func compactAssetDescription(v string) string {
	v = strings.TrimSpace(v)
	if v == "" {
		return ""
	}
	r := []rune(v)
	if len(r) <= 110 {
		return v
	}
	return string(r[:107]) + "..."
}
