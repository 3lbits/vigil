package risktemplates

import (
	"fmt"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
)

templ WizardDecision(vm DecisionVM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, 4, false)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}

	<div class="max-w-6xl" x-data={ fmt.Sprintf("{ decision: '%s' }", vm.Risk.RiskDecision) }>
		<div class="mb-4 border border-blue-200 bg-blue-50 rounded-lg px-4 py-3">
			<div class="text-[13px] font-semibold text-blue-800 mb-0.5">{ locale.T(ctx, "label_risk_decision_treatment") }</div>
			<p class="text-[12px] text-blue-700">{ locale.T(ctx, "label_risk") } { fmt.Sprint(vm.Position) } { locale.T(ctx, "text_of") } { fmt.Sprint(vm.Total) }, { locale.T(ctx, "text_ordered_by_current_criticality") }</p>
			if vm.AcceptanceCriteria != "" {
				<div class="mt-2 text-[12px] text-blue-800 border-t border-blue-200 pt-2">
					<span class="font-medium">{ locale.T(ctx, "label_acceptance_criteria") }:</span> { vm.AcceptanceCriteria }
				</div>
			}
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-4">
			<div class="border border-sand-200 rounded-[10px] p-3 h-fit lg:sticky lg:top-3">
				<div class="text-[12px] font-semibold uppercase tracking-wide text-sand-700 mb-2">{ locale.T(ctx, "label_risks_in_treatment_phase") }</div>
				<div class="max-h-[60vh] overflow-auto divide-y divide-sand-100">
					for _, risk := range vm.Risks {
						<a
							href={ templ.SafeURL(decisionGetPath(vm.Assessment.ID.String(), risk.ID.String(), vm.IsReview)) }
							class={
								"block p-2 transition-colors",
								templ.KV("bg-blue-50", risk.ID == vm.Risk.ID),
								templ.KV("hover:bg-sand-50", risk.ID != vm.Risk.ID),
							}
						>
							<div class="flex items-center gap-2 justify-between">
								<div class="min-w-0">
									<div class="text-[11px] text-sand-700">
										if risk.RefNum.Valid {
											{ riskRef(risk.RefNum) }
										} else {
											—
										}
									</div>
									<div class="text-[12px] font-medium text-sand-900 truncate">{ risk.Name }</div>
								</div>
								if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
									<div class={ "w-10 h-7 rounded text-[11px] font-bold text-white flex items-center justify-center", bgClassT(risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32, vm.LowMax, vm.HighMin) }>
										{ fmt.Sprint(int(risk.LikelihoodCurrent.Int32) * int(risk.ConsequenceCurrent.Int32)) }
									</div>
								}
							</div>
							<div class="mt-1">
								if risk.RiskDecision != "" {
									@ui.Badge(ui.BadgeProps{
										Variant: decisionListBadgeVariant(risk.RiskDecision),
										Class:   decisionListBadgeClass(risk.RiskDecision),
									}) { { locale.T(ctx, decisionListLabelKey(risk.RiskDecision)) } }
								} else {
									<span class="text-[10px] text-sand-600">{ locale.T(ctx, "label_not_decided") }</span>
								}
							</div>
						</a>
					}
				</div>
			</div>
			<div class="space-y-4">
				<div class="border border-sand-200 rounded-[10px] p-4">
					<div class="text-[12px] font-semibold uppercase tracking-wide text-sand-700 mb-2">{ locale.T(ctx, "label_identify_details") }</div>
					<div class="text-[14px] font-semibold text-sand-900 mb-1">{ vm.Risk.Name }</div>
					if vm.OwnerName != "" {
						<div class="text-[12px] text-sand-700 mb-1">{ locale.T(ctx, "label_risk_owner") }: { vm.OwnerName } ({ locale.T(ctx, "text_inherited_from_assessment") })</div>
					}
					if vm.Risk.Description != "" {
						<p class="text-[12px] text-sand-700 whitespace-pre-wrap">{ vm.Risk.Description }</p>
					}
					<div class="mt-3">
						<div class="text-[11px] font-semibold text-sand-700 uppercase tracking-wide mb-1">{ locale.T(ctx, "label_linked_assets") }</div>
						if len(vm.Assets) == 0 {
							<div class="text-[12px] text-sand-700">{ locale.T(ctx, "empty_no_assets_linked") }</div>
						} else {
							<div class="flex flex-wrap gap-1.5">
								for _, a := range vm.Assets {
									@ui.Badge(ui.BadgeProps{
										Variant: "default",
										Class:   "gap-1 px-2.5 bg-violet-50 text-violet-800 border-violet-200 dark:bg-violet-950 dark:text-violet-300 dark:border-violet-800",
									}) { { a.Name } }
								}
							</div>
						}
					</div>
				</div>

				<div class="border border-sand-200 rounded-[10px] p-4">
					<div class="text-[12px] font-semibold uppercase tracking-wide text-sand-700 mb-2">{ locale.T(ctx, "label_analysis_details") }</div>
					if vm.Risk.LikelihoodCurrent.Valid && vm.Risk.ConsequenceCurrent.Valid {
						<div class="flex items-center gap-3 mb-2">
							<div class={ "w-14 h-10 rounded flex items-center justify-center text-[13px] font-bold text-white", bgClassT(vm.Risk.LikelihoodCurrent.Int32, vm.Risk.ConsequenceCurrent.Int32, vm.LowMax, vm.HighMin) }>
								{ fmt.Sprint(int(vm.Risk.LikelihoodCurrent.Int32) * int(vm.Risk.ConsequenceCurrent.Int32)) }
							</div>
							<div class="text-[12px] text-sand-700">L{ fmt.Sprint(vm.Risk.LikelihoodCurrent.Int32) }×C{ fmt.Sprint(vm.Risk.ConsequenceCurrent.Int32) }</div>
						</div>
					}
					if vm.Risk.LikelihoodReasoning != "" || vm.Risk.ConsequenceReasoning != "" {
						<div class="text-[12px] text-sand-700 space-y-1">
							if vm.Risk.LikelihoodReasoning != "" {
								<div><span class="font-medium">{ locale.T(ctx, "label_likelihood") }:</span> { vm.Risk.LikelihoodReasoning }</div>
							}
							if vm.Risk.ConsequenceReasoning != "" {
								<div><span class="font-medium">{ locale.T(ctx, "label_consequence") }:</span> { vm.Risk.ConsequenceReasoning }</div>
							}
						</div>
					}
				</div>

				<form id="finalise-form" method="POST" action={ templ.SafeURL(decisionPostPath(vm.Assessment.ID.String(), vm.Risk.ID.String(), vm.IsReview)) } class="border border-sand-200 rounded-[10px] p-4 mb-4">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<div class="text-[12px] font-semibold uppercase tracking-wide text-sand-700 mb-2">Decision</div>
					<div class="flex flex-wrap gap-4 mb-3">
						for _, opt := range []struct{ v, key string }{{"accept", "decision_accept"}, {"treat", "decision_treat"}, {"document", "decision_document"}} {
							<label class="flex items-center gap-1.5 cursor-pointer">
								<input
									type="radio"
									name="decision"
									value={ opt.v }
									class="accent-blue-600"
									checked?={ vm.Risk.RiskDecision == opt.v }
									disabled?={ (opt.v == "accept" && !vm.CanAccept) || (opt.v != "accept" && vm.CanAccept) }
									x-model="decision"
								/>
								<span class={ "text-[13px]", decisionOptionColor(opt.v), decisionOptionStateClass(opt.v, vm.CanAccept) }>{ locale.T(ctx, opt.key) }</span>
							</label>
						}
					</div>
					if !vm.CanAccept {
						<div class="mb-3 text-[11px] text-amber-700">{ locale.T(ctx, "help_accept_available_only_low_current") }</div>
					} else {
						<div class="mb-3 text-[11px] text-amber-700">{ locale.T(ctx, "help_low_risks_only_accepted") }</div>
					}
					<div class="mb-3" x-show="decision === 'document'">
						@ui.Field("decision_notes", "label_documentation_notes", false) {
							@ui.Textarea(ui.TextareaProps{
								ID:          "decision_notes",
								Name:        "decision_notes",
								Value:       vm.Risk.DecisionNotes,
								Placeholder: locale.T(ctx, "placeholder_why_decision_appropriate"),
								Class:       "py-2 text-[12px] resize-y min-h-0 focus:ring-1",
								Attrs: templ.Attributes{
									"rows": "3",
								},
							})
						}
					</div>
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							if vm.PrevRiskID.Valid {
								<a href={ templ.SafeURL(decisionGetPath(vm.Assessment.ID.String(), vm.PrevRiskID.UUID.String(), vm.IsReview)) } class="text-[12px] px-3 py-1.5 rounded border border-sand-300 hover:bg-sand-50 transition-colors">← { locale.T(ctx, "action_previous_risk") }</a>
							}
						</div>
						<div class="flex items-center gap-2">
							@ui.Button(ui.ButtonProps{
								Variant: "secondary",
								Size:    "sm",
								Attrs: templ.Attributes{
									"type":  "submit",
									"name":  "next",
									"value": "0",
								},
							}) { { locale.T(ctx, "action_save") } }
							if vm.NextRiskID.Valid {
								@ui.Button(ui.ButtonProps{
									Size: "sm",
									Attrs: templ.Attributes{
										"type":  "submit",
										"name":  "next",
										"value": "1",
									},
								}) { { locale.T(ctx, "action_save_next") } → }
							} else {
								@ui.Button(ui.ButtonProps{
									Size: "sm",
									Attrs: templ.Attributes{
										"type":  "submit",
										"name":  "submit_assessment",
										"value": "1",
									},
								}) { locale.T(ctx, "action_finalise_assessment") }
							}
						</div>
					</div>
				</form>

				<div x-show="decision === 'treat'">
					@treatmentPanel(vm.Risk, vm.Measures, vm.Activities, vm.Users, vm.Assessment.ID, vm.Overdue, vm.LowMax, vm.HighMin)
				</div>
			</div>
		</div>
	</div>
}

func decisionGetPath(assessmentID, riskID string, review bool) string {
	if review {
		return "/risks/" + assessmentID + "/review/decision/" + riskID
	}
	return "/risks/" + assessmentID + "/decision/" + riskID
}

func decisionPostPath(assessmentID, riskID string, review bool) string {
	if review {
		return "/risks/" + assessmentID + "/review/decision/" + riskID
	}
	return "/risks/" + assessmentID + "/decision/" + riskID
}

func decisionOptionStateClass(value string, canAccept bool) string {
	if value == "accept" && !canAccept {
		return "line-through opacity-70"
	}
	if value != "accept" && canAccept {
		return "line-through opacity-70"
	}
	return ""
}

func decisionListLabelKey(decision string) string {
	switch decision {
	case "accept":
		return "decision_accept"
	case "treat":
		return "decision_treat"
	case "document":
		return "decision_document"
	default:
		return "label_not_decided"
	}
}

func decisionListBadgeVariant(decision string) string {
	switch decision {
	case "accept":
		return "success"
	case "treat":
		return "warning"
	case "document":
		return "default"
	default:
		return "default"
	}
}

func decisionListBadgeClass(decision string) string {
	switch decision {
	case "document":
		return "text-[10px] font-semibold px-1.5 rounded bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-800"
	case "accept", "treat":
		return "text-[10px] font-semibold px-1.5 rounded"
	default:
		return "text-[10px] font-semibold px-1.5 rounded"
	}
}
