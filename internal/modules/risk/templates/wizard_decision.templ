package risktemplates

import (
	"fmt"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ WizardDecision(vm DecisionVM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(4, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	<div class="risk-wide" x-data={ fmt.Sprintf("{ decision: '%s' }", vm.Risk.RiskDecision) }>
		<section class="ui2-panel">
			<h2 class="risk-info-title" style="font-size: 13px">{ locale.T(ctx, "label_risk_decision_treatment") }</h2>
			<p class="risk-info-description">{ locale.T(ctx, "label_risk") } { fmt.Sprint(vm.Position) } { locale.T(ctx, "text_of") } { fmt.Sprint(vm.Total) }, { locale.T(ctx, "text_ordered_by_current_criticality") }</p>
			if vm.AcceptanceCriteria != "" {
				<div class="risk-info-criteria">
					<span class="risk-emphasis">{ locale.T(ctx, "label_acceptance_criteria") }:</span> { vm.AcceptanceCriteria }
				</div>
			}
		</section>
		<div class="risk-decision-layout">
			<aside class="ui2-panel risk-decision-sidebar" aria-label={ locale.T(ctx, "label_risks_in_treatment_phase") }>
				<h2 class="risk-section-heading" style="font-size: 12px">{ locale.T(ctx, "label_risks_in_treatment_phase") }</h2>
				<div class="risk-decision-list">
					for _, risk := range vm.Risks {
						@ui2.Link(templ.SafeURL(decisionGetPath(vm.Assessment.ID.String(), risk.ID.String(), vm.IsReview)), templ.Attributes{"class": "risk-decision-item " + decisionItemStateClass(risk.ID == vm.Risk.ID)}) {
							<div class="risk-split">
								<div class="risk-truncation-container">
									<div class="risk-caption">
										if risk.RefNum.Valid {
											{ riskRef(risk.RefNum) }
										} else {
											—
										}
									</div>
									<span class="risk-result-name">{ risk.Name }</span>
								</div>
								if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
									<div class={ "risk-score-tile", bgClassT(risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32, vm.LowMax, vm.HighMin) }>
										{ fmt.Sprint(int(risk.LikelihoodCurrent.Int32) * int(risk.ConsequenceCurrent.Int32)) }
									</div>
								}
							</div>
							<div class="risk-following">
								if risk.RiskDecision != "" {
									@ui2.Badge(decisionListBadgeVariant(risk.RiskDecision)) {
										{ locale.T(ctx, decisionListLabelKey(risk.RiskDecision)) }
									}
								} else {
									<span class="risk-caption">{ locale.T(ctx, "label_not_decided") }</span>
								}
							</div>
						}
					}
				</div>
			</aside>
			<div>
				<section class="ui2-panel">
					<h2 class="risk-section-heading" style="font-size: 12px">{ locale.T(ctx, "label_identify_details") }</h2>
					<h3 class="risk-result-name" style="font-size: 14px; margin-bottom: 0.25rem">{ vm.Risk.Name }</h3>
					if vm.OwnerName != "" {
						<p class="risk-description">{ locale.T(ctx, "label_risk_owner") }: { vm.OwnerName } ({ locale.T(ctx, "text_inherited_from_assessment") })</p>
					}
					if vm.Risk.Description != "" {
						<p class="risk-preformatted">{ vm.Risk.Description }</p>
					}
					<div class="risk-following-wide">
						<h3 class="risk-subheading" style="font-size: 11px; margin-bottom: 0.25rem">{ locale.T(ctx, "label_linked_assets") }</h3>
						if len(vm.Assets) == 0 {
							<p class="risk-description">{ locale.T(ctx, "empty_no_assets_linked") }</p>
						} else {
							<div class="risk-chip-list">
								for _, a := range vm.Assets {
									@ui2.Badge("") {
										{ a.Name }
									}
								}
							</div>
						}
					</div>
				</section>
				<section class="ui2-panel">
					<h2 class="risk-section-heading" style="font-size: 12px">{ locale.T(ctx, "label_analysis_details") }</h2>
					if vm.Risk.LikelihoodCurrent.Valid && vm.Risk.ConsequenceCurrent.Valid {
						<div class="risk-controls">
							<div class={ "risk-score-tile", bgClassT(vm.Risk.LikelihoodCurrent.Int32, vm.Risk.ConsequenceCurrent.Int32, vm.LowMax, vm.HighMin) }>
								{ fmt.Sprint(int(vm.Risk.LikelihoodCurrent.Int32) * int(vm.Risk.ConsequenceCurrent.Int32)) }
							</div>
							<div class="risk-description">L{ fmt.Sprint(vm.Risk.LikelihoodCurrent.Int32) }×C{ fmt.Sprint(vm.Risk.ConsequenceCurrent.Int32) }</div>
						</div>
					}
					if vm.Risk.LikelihoodReasoning != "" || vm.Risk.ConsequenceReasoning != "" {
						<div class="risk-description">
							if vm.Risk.LikelihoodReasoning != "" {
								<p><span class="risk-emphasis">{ locale.T(ctx, "label_likelihood") }:</span> { vm.Risk.LikelihoodReasoning }</p>
							}
							if vm.Risk.ConsequenceReasoning != "" {
								<p><span class="risk-emphasis">{ locale.T(ctx, "label_consequence") }:</span> { vm.Risk.ConsequenceReasoning }</p>
							}
						</div>
					}
				</section>
				<form id="finalise-form" method="POST" action={ templ.SafeURL(decisionPostPath(vm.Assessment.ID.String(), vm.Risk.ID.String(), vm.IsReview)) } class="risk-spaced">
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
					<fieldset class="risk-spaced">
						<legend class="risk-section-heading">Decision</legend>
						<div class="risk-chip-list">
							for _, opt := range []struct{ v, key string }{{"accept", "decision_accept"}, {"treat", "decision_treat"}, {"document", "decision_document"}} {
								<label class="risk-radio-option">
									@ui2.Input(templ.Attributes{"type": "radio", "name": "decision", "value": opt.v, "class": "risk-radio", "checked": vm.Risk.RiskDecision == opt.v, "disabled": (opt.v == "accept" && !vm.CanAccept) || (opt.v != "accept" && vm.CanAccept), "x-model": "decision"})
									<span class={ "risk-decision-option", decisionOptionColor(opt.v), decisionOptionStateClass(opt.v, vm.CanAccept) }>{ locale.T(ctx, opt.key) }</span>
								</label>
							}
						</div>
					</fieldset>
					if !vm.CanAccept {
						<div class="risk-decision-hint">{ locale.T(ctx, "help_accept_available_only_low_current") }</div>
					} else {
						<div class="risk-decision-hint">{ locale.T(ctx, "help_low_risks_only_accepted") }</div>
					}
					<div class="risk-spaced" x-show="decision === 'document'">
						<label for="decision_notes">{ locale.T(ctx, "label_documentation_notes") }</label>
						@ui2.Textarea(templ.Attributes{"id": "decision_notes", "name": "decision_notes", "rows": "3", "placeholder": locale.T(ctx, "placeholder_why_decision_appropriate")}) { { vm.Risk.DecisionNotes } }
					</div>
					<div class="risk-split">
						<div class="risk-controls">
							if vm.PrevRiskID.Valid {
								@ui2.Link(templ.SafeURL(decisionGetPath(vm.Assessment.ID.String(), vm.PrevRiskID.UUID.String(), vm.IsReview)), templ.Attributes{"class": "risk-secondary-button"}) { ← { locale.T(ctx, "action_previous_risk") } }
							}
						</div>
						<div class="risk-controls">
							@ui2.Button(templ.Attributes{"type": "submit", "name": "next", "value": "0", "class": "risk-secondary-button"}) { { locale.T(ctx, "action_save") } }
							if vm.NextRiskID.Valid {
								@ui2.Button(templ.Attributes{"type": "submit", "name": "next", "value": "1"}) { { locale.T(ctx, "action_save_next") } → }
							} else {
								@ui2.Button(templ.Attributes{"type": "submit", "name": "submit_assessment", "value": "1"}) { { locale.T(ctx, "action_finalise_assessment") } }
							}
						</div>
					</div>
				</form>
				<div x-show="decision === 'treat'">
					@treatmentPanel(vm.Risk, vm.Measures, vm.Activities, vm.Users, vm.Assessment.ID, vm.Overdue, vm.LowMax, vm.HighMin)
				</div>
			</div>
		</div>
	</div>
}

func decisionItemStateClass(selected bool) string {
	if selected {
		return "risk-decision-selected"
	}
	return "risk-decision-available"
}

func decisionGetPath(assessmentID, riskID string, review bool) string {
	if review {
		return "/risks/" + assessmentID + "/review/decision/" + riskID
	}
	return "/risks/" + assessmentID + "/decision/" + riskID
}

func decisionPostPath(assessmentID, riskID string, review bool) string {
	if review {
		return "/risks/" + assessmentID + "/review/decision/" + riskID
	}
	return "/risks/" + assessmentID + "/decision/" + riskID
}

func decisionOptionStateClass(value string, canAccept bool) string {
	if value == "accept" && !canAccept {
		return "risk-decision-disabled"
	}
	if value != "accept" && canAccept {
		return "risk-decision-disabled"
	}
	return ""
}

func decisionListLabelKey(decision string) string {
	switch decision {
	case "accept":
		return "decision_accept"
	case "treat":
		return "decision_treat"
	case "document":
		return "decision_document"
	default:
		return "label_not_decided"
	}
}

func decisionListBadgeVariant(decision string) string {
	switch decision {
	case "accept":
		return "success"
	case "treat":
		return "warning"
	case "document":
		return "default"
	default:
		return "default"
	}
}
