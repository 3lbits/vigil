package risktemplates

import (
	"fmt"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ WizardEvaluate(vm EvaluationVM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(3, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	<div class="risk-narrow">
		<section class="ui2-panel">
			<h2 class="risk-info-title" style="font-size: 13px">{ locale.T(ctx, "risk_eval_gate_title") }</h2>
			<p class="risk-info-description">{ locale.T(ctx, "text_compare_risks_against_acceptance") }</p>
			if vm.AcceptanceCriteria != "" {
				<div class="risk-info-criteria">
					<span class="risk-emphasis">{ locale.T(ctx, "label_acceptance_criteria") }:</span> { vm.AcceptanceCriteria }
				</div>
			}
		</section>
		<form method="POST" action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/3/evaluate") }>
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			<div class="ui2-panel">
				<div class="risk-eval-header">
					<span>{ locale.T(ctx, "label_risk") }</span>
					<span class="risk-centered">{ locale.T(ctx, "label_current") }</span>
					<span>{ locale.T(ctx, "label_decision") }</span>
				</div>
				for _, risk := range vm.Risks {
					@evalRow(risk, vm.LowMax, vm.HighMin)
				}
			</div>
			<div class="risk-split">
				@ui2.Link(templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/step/3"), templ.Attributes{"class": "risk-back-link"}) { ← { locale.T(ctx, "action_back_to_scoring") } }
				@ui2.Button(templ.Attributes{"type": "submit"}) { { locale.T(ctx, "action_confirm_plan_treatment") } → }
			</div>
		</form>
	</div>
}

templ evalRow(risk db.Risk, lowMax, highMin int) {
	<section class="risk-eval-item">
		<div class="risk-eval-row">
			<div class="risk-truncation-container">
				<h2 class="risk-result-name" style="font-size: 12px; font-weight: 500">{ risk.Name }</h2>
				if risk.Description != "" {
					<p class="risk-result-detail">{ risk.Description }</p>
				}
			</div>
			@evalScore(risk.LikelihoodCurrent.Int32, risk.ConsequenceCurrent.Int32, risk.LikelihoodCurrent.Valid, lowMax, highMin)
			<fieldset>
				<legend class="sr-only">{ locale.T(ctx, "label_decision_for") } { risk.Name }</legend>
				<div class="risk-tight-list">
					for _, opt := range []struct{ v, key string }{{"accept", "decision_accept"}, {"treat", "decision_treat"}, {"document", "decision_document"}} {
						<label class="risk-radio-option">
							@ui2.Input(templ.Attributes{"type": "radio", "name": "decision_" + risk.ID.String(), "value": opt.v, "class": "risk-radio", "checked": risk.RiskDecision == opt.v})
							<span class={ "risk-decision-option", decisionOptionColor(opt.v) }>{ locale.T(ctx, opt.key) }</span>
						</label>
					}
				</div>
			</fieldset>
		</div>
		<div class="risk-eval-notes">
			<label for={ "notes-" + risk.ID.String() }>{ locale.T(ctx, "label_documentation_notes") }</label>
			@ui2.Textarea(templ.Attributes{"id": "notes-" + risk.ID.String(), "name": "notes_" + risk.ID.String(), "rows": "3", "placeholder": locale.T(ctx, "placeholder_decision_notes")}) { { risk.DecisionNotes } }
			<p class="risk-caption">{ locale.T(ctx, "text_used_when_decision_document") }</p>
		</div>
	</section>
}

templ evalScore(l, c int32, valid bool, lowMax, highMin int) {
	if valid && l > 0 && c > 0 {
		<div class={ "risk-eval-score", bgClassT(l, c, lowMax, highMin) }>
			<span>{ fmt.Sprint(int(l) * int(c)) }</span>
			<span>L{ fmt.Sprint(l) }×C{ fmt.Sprint(c) }</span>
		</div>
	} else {
		<div class="risk-centered">—</div>
	}
}

func decisionOptionColor(v string) string {
	switch v {
	case "accept":
		return "risk-decision-accept"
	case "document":
		return "risk-decision-document"
	default:
		return "risk-decision-treat"
	}
}
