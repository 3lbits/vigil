package risktemplates

import (
	"github.com/google/uuid"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
)

templ WizardStep2(vm WizardStep2VM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(2, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	@wizardFlash(vm.Flash)
	<div id="risk-step2-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
	<!-- Quick-add form: HTMX posts, returns new row inserted at top of #risk-rows -->
	<div class="border border-sand-300/60 rounded-[10px] p-4 mb-4 max-w-2xl">
		<h2 class="text-[12px] font-semibold uppercase tracking-wide text-sand-700 mb-3">{ locale.T(ctx, "heading_add_risk") }</h2>
		<form
			method="POST"
			action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks") }
			hx-post={ "/risks/" + vm.Assessment.ID.String() + "/risks" }
			hx-target="#risk-rows"
			hx-swap="afterbegin"
			hx-on::after-request="this.reset(); document.getElementById('empty-row')?.remove(); document.getElementById('risk-step2-status').textContent='Risk added'; document.getElementById('risk_name')?.focus()"
			class="flex gap-2 items-end flex-wrap"
		>
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div class="flex-1 min-w-48">
				@ui.Field("risk_name", "label_title", true) {
					@ui.Input(ui.InputProps{
						ID:          "risk_name",
						Name:        "name",
						Type:        "text",
						Required:    true,
						Placeholder: locale.T(ctx, "placeholder_risk_title_example"),
					})
				}
			</div>
			<div class="basis-full">
				@ui.Field("risk_description", "label_description", false) {
					@ui.Textarea(ui.TextareaProps{
						ID:          "risk_description",
						Name:        "description",
						Placeholder: locale.T(ctx, "placeholder_risk_description_brief"),
						Attrs: templ.Attributes{
							"rows": "2",
						},
						Class: "resize-y min-h-[72px]",
					})
				}
			</div>
			<button type="submit" class="self-end px-4 py-1.5 rounded-md bg-sand-900 text-white text-[13px] font-medium hover:bg-sand-800 transition-colors focus:ring-2 focus:ring-sand-700 focus:ring-offset-2 outline-none shrink-0">
				{ locale.T(ctx, "action_add") }
			</button>
		</form>
	</div>
	<!-- Identification form (bulk-saves all risk details on Next) -->
	<form method="POST" action={ templ.SafeURL(step2FormAction(vm.Assessment.ID.String(), vm.IsReview)) }>
		<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
		<div class="border border-sand-200 rounded-[10px] overflow-x-auto mb-5">
			@ui.Table(ui.TableProps{
				Attrs: templ.Attributes{
					"class": "text-[12px]",
				},
			}) {
				@ui.THead(ui.THeadProps{
					Attrs: templ.Attributes{
						"class": "bg-sand-50 dark:bg-zinc-900 text-[10px] font-semibold text-sand-700 dark:text-zinc-300 uppercase tracking-wide",
					},
				}) {
					@ui.Tr(ui.TrProps{}) {
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-left px-4 py-2.5 w-1/3"}}) { { locale.T(ctx, "label_title") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-left py-2.5"}}) { { locale.T(ctx, "label_description") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-left py-2.5"}}) { { locale.T(ctx, "label_assets") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "py-2.5 w-6"}}) {}
					}
				}
				<tbody id="risk-rows">
					for _, risk := range vm.Risks {
						@riskIdentRow(risk, vm.Assessment.ID.String(), vm.LinkedAssets, vm.AssetQueries, vm.AssetResults, vm.IsReview)
					}
					if len(vm.Risks) == 0 {
						@ui.Tr(ui.TrProps{
							Attrs: templ.Attributes{
								"id": "empty-row",
							},
						}) {
							@ui.Td(ui.TdProps{
								Attrs: templ.Attributes{
									"colspan": "4",
									"class":   "px-4 py-8 text-center text-[13px] text-sand-700",
								},
							}) { { locale.T(ctx, "empty_no_risks_yet_add_above") } }
						}
					}
				</tbody>
			}
		</div>
		<!-- Navigation -->
		<div class="flex items-center justify-between max-w-2xl">
			<a href={ templ.SafeURL(wizardStepHref(vm.Assessment.ID.String(), "framework")) } class="text-[13px] text-sand-700 hover:text-sand-800">← Back to Framework</a>
			<div class="flex items-center gap-2">
				@ui.Button(ui.ButtonProps{
					Variant: "secondary",
					Attrs: templ.Attributes{
						"type":  "submit",
						"name":  "step2_action",
						"value": "save",
					},
				}) {
					Save
				}
				@ui.Button(ui.ButtonProps{
					Attrs: templ.Attributes{
						"type":  "submit",
						"name":  "step2_action",
						"value": "continue",
					},
				}) {
					Save &amp; analyse →
				}
			</div>
		</div>
	</form>
}

templ riskIdentRow(
	risk db.Risk,
	assessmentID string,
	linkedAssets map[uuid.UUID][]db.Asset,
	assetQueries map[uuid.UUID]string,
	assetResults map[uuid.UUID][]db.Asset,
	isReview bool,
) {
	@ui.Tr(ui.TrProps{
		Attrs: templ.Attributes{
			"id":    "risk-row-" + risk.ID.String(),
			"class": "border-sand-200 dark:border-zinc-700 align-top",
		},
	}) {
		@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 py-3"}}) {
			<label for={ "risk-name-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_title") }</label>
			@ui.Input(ui.InputProps{
				ID:          "risk-name-" + risk.ID.String(),
				Name:        "name_" + risk.ID.String(),
				Type:        "text",
				Value:       risk.Name,
				Placeholder: locale.T(ctx, "placeholder_risk_title"),
				Class:       "border-sand-200 px-2 py-1 text-[12px] focus:ring-1",
			})
		}
		@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "py-3"}}) {
			<label for={ "risk-description-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_description") }</label>
			@ui.Textarea(ui.TextareaProps{
				ID:          "risk-description-" + risk.ID.String(),
				Name:        "description_" + risk.ID.String(),
				Placeholder: locale.T(ctx, "placeholder_risk_description_brief"),
				Value:       risk.Description,
				Class:       "border-sand-200 px-2 py-1 text-[12px] resize-y min-h-0 focus:ring-1",
				Attrs: templ.Attributes{
					"rows": "2",
				},
			})
		}
		@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "py-3"}}) {
			<div class="space-y-2">
				<div class="rounded-md border border-sand-200 bg-white divide-y divide-sand-100">
					if len(linkedAssets[risk.ID]) == 0 {
						<div class="px-3 py-2 text-[11px] text-sand-700">
							{ locale.T(ctx, "empty_no_assets_linked") }
						</div>
					} else {
						for _, a := range linkedAssets[risk.ID] {
							<div class="px-3 py-2 flex items-center justify-between gap-2">
								<div class="min-w-0">
									<div class="text-[12px] text-sand-900 truncate">{ a.Name }</div>
									if a.Owner != "" {
										<div class="text-[11px] text-sand-700 truncate">{ a.Owner }</div>
									}
								</div>
								<form method="POST" action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + risk.ID.String() + "/assets/" + a.ID.String() + "/remove") }>
									<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
									<input type="hidden" name="return_to" value="step2"/>
									<input type="hidden" name="review" value={ reviewValue(isReview) }/>
									<input type="hidden" name="asset_q" value={ assetQueries[risk.ID] }/>
									<input type="hidden" name="asset_risk_id" value={ risk.ID.String() }/>
									<button type="submit" class="text-[11px] px-2 py-1 rounded border border-sand-300 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_remove") }</button>
								</form>
							</div>
						}
					}
				</div>
				<div id={ "risk-asset-search-controls-" + risk.ID.String() } class="flex items-center gap-2">
					<label for={ "asset-q-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_search_assets") }</label>
					<input type="hidden" name="asset_risk_id" value={ risk.ID.String() }/>
					<input type="hidden" name="asset_search_partial" value="1"/>
					@ui.Input(ui.InputProps{
						ID:          "asset-q-" + risk.ID.String(),
						Name:        "asset_q",
						Type:        "search",
						Value:       assetQueries[risk.ID],
						Placeholder: locale.T(ctx, "placeholder_search_name_or_owner"),
						Class:       "text-[12px]",
						Attrs: templ.Attributes{
							"hx-get":     step2FormAction(assessmentID, isReview),
							"hx-trigger": "input changed delay:500ms, search",
							"hx-target":  "#risk-asset-search-results-" + risk.ID.String(),
							"hx-include": "#risk-asset-search-controls-" + risk.ID.String(),
							"hx-swap":    "innerHTML",
						},
					})
				</div>
				<div id={ "risk-asset-search-results-" + risk.ID.String() }>
					@Step2AssetSearchResults(assessmentID, risk.ID.String(), isReview, assetQueries[risk.ID], assetResults[risk.ID])
				</div>
			</div>
		}
		@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "py-3"}}) {
			<form
				method="POST"
				action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + risk.ID.String() + "/delete") }
				hx-delete={ "/risks/" + assessmentID + "/risks/" + risk.ID.String() }
				hx-target={ "#risk-row-" + risk.ID.String() }
				hx-swap="outerHTML"
				hx-confirm="Delete this risk?"
			>
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<button
					type="submit"
					hx-on::after-request="document.getElementById('risk-step2-status').textContent='Risk deleted'; document.getElementById('risk_name')?.focus()"
					class="text-sand-300 hover:text-red-500 transition-colors text-lg leading-none"
					aria-label={ locale.T(ctx, "action_delete_risk") }
				>
					×
				</button>
			</form>
		}
	}
}

// NewRiskRow is the HTMX partial returned after adding a risk.
templ NewRiskRow(risk db.Risk, assessmentID string) {
	@riskIdentRow(risk, assessmentID, map[uuid.UUID][]db.Asset{}, map[uuid.UUID]string{}, map[uuid.UUID][]db.Asset{}, false)
}

templ Step2AssetSearchResults(assessmentID, riskID string, isReview bool, assetQuery string, results []db.Asset) {
	if assetQuery != "" {
		<div class="rounded-md border border-sand-200 divide-y divide-sand-100">
			if len(results) == 0 {
				<div class="px-3 py-2 text-[12px] text-sand-700">{ locale.T(ctx, "empty_no_matching_assets_found") }</div>
			} else {
				for _, a := range results {
					<div class="px-3 py-2 flex items-center justify-between gap-2">
						<div class="min-w-0">
							<div class="text-[12px] text-sand-900 truncate">{ a.Name }</div>
							if a.Owner != "" {
								<div class="text-[11px] text-sand-700 truncate">{ a.Owner }</div>
							}
						</div>
						<form method="POST" action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/assets/" + a.ID.String() + "/add") }>
							<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
							<input type="hidden" name="return_to" value="step2"/>
							<input type="hidden" name="review" value={ reviewValue(isReview) }/>
							<input type="hidden" name="asset_q" value={ assetQuery }/>
							<input type="hidden" name="asset_risk_id" value={ riskID }/>
							<button type="submit" class="text-[11px] px-2.5 py-1 rounded border border-sand-300 hover:bg-sand-50 transition-colors">{ locale.T(ctx, "action_add") }</button>
						</form>
					</div>
				}
			}
		</div>
	}
}

func reviewValue(review bool) string {
	if review {
		return "1"
	}
	return "0"
}

func step2FormAction(assessmentID string, isReview bool) string {
	if isReview {
		return "/risks/" + assessmentID + "/review/step/2"
	}
	return "/risks/" + assessmentID + "/step/2"
}
