package risktemplates

import (
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
	"github.com/google/uuid"
)

templ WizardStep2(vm WizardStep2VM) {
	@wizardShell(vm.Assessment.ID.String(), vm.Assessment.Name, wizardDisplayStep(2, vm.Assessment.ThreatAssessmentEnabled), false, vm.Assessment.ThreatAssessmentEnabled)
	if vm.IsReview {
		@reviewBanner(vm.Assessment)
	}
	@wizardFlash(vm.Flash)
	<div id="risk-step2-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
	@ui2.Panel() {
		<h2>{ locale.T(ctx, "heading_add_risk") }</h2>
		<form
			method="POST"
			action={ templ.SafeURL("/risks/" + vm.Assessment.ID.String() + "/risks") }
			hx-post={ "/risks/" + vm.Assessment.ID.String() + "/risks" }
			hx-target="#risk-rows"
			hx-swap="afterbegin"
			hx-on::after-request="this.reset(); document.getElementById('empty-row')?.remove(); document.getElementById('risk-step2-status').textContent='Risk added'; document.getElementById('risk_name')?.focus()"
			class="risk-add-form"
		>
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			<div class="risk-add-title">
				<label for="risk_name">{ locale.T(ctx, "label_title") } *</label>
				@ui2.Input(templ.Attributes{"id": "risk_name", "name": "name", "type": "text", "required": true, "placeholder": locale.T(ctx, "placeholder_risk_title_example")})
			</div>
			<div class="risk-add-description">
				<label for="risk_description">{ locale.T(ctx, "label_description") }</label>
				@ui2.Textarea(templ.Attributes{"id": "risk_description", "name": "description", "rows": "2", "placeholder": locale.T(ctx, "placeholder_risk_description_brief")}) {}
			</div>
			@ui2.Button(templ.Attributes{"type": "submit"}) {
				{ locale.T(ctx, "action_add") }
			}
		</form>
	}
	<form method="POST" action={ templ.SafeURL(step2FormAction(vm.Assessment.ID.String(), vm.IsReview)) }>
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
		@ui2.Table(locale.T(ctx, "label_risks")) {
			<thead>
				<tr>
					<th scope="col">{ locale.T(ctx, "label_title") }</th>
					<th scope="col">{ locale.T(ctx, "label_description") }</th>
					<th scope="col">{ locale.T(ctx, "label_assets") }</th>
					<th scope="col">{ locale.T(ctx, "label_actions") }</th>
				</tr>
			</thead>
			<tbody id="risk-rows">
				for _, risk := range vm.Risks {
					@riskIdentRow(risk, vm.Assessment.ID.String(), vm.LinkedAssets, vm.AssetQueries, vm.AssetResults, vm.IsReview)
				}
				if len(vm.Risks) == 0 {
					<tr id="empty-row"><td colspan="4">{ locale.T(ctx, "empty_no_risks_yet_add_above") }</td></tr>
				}
			</tbody>
		}
		<div class="risk-split">
			@ui2.Link(templ.SafeURL(wizardStepHref(vm.Assessment.ID.String(), "framework")), templ.Attributes{"class": "risk-back-link"}) { ← Back to Framework }
			<div class="risk-controls">
				@ui2.Button(templ.Attributes{"type": "submit", "name": "step2_action", "value": "save", "class": "risk-secondary-button"}) { Save }
				@ui2.Button(templ.Attributes{"type": "submit", "name": "step2_action", "value": "continue"}) { Save &amp; analyse → }
			</div>
		</div>
	</form>
}

templ riskIdentRow(
	risk db.Risk,
	assessmentID string,
	linkedAssets map[uuid.UUID][]db.Asset,
	assetQueries map[uuid.UUID]string,
	assetResults map[uuid.UUID][]db.Asset,
	isReview bool,
) {
	<tr id={ "risk-row-" + risk.ID.String() }>
		<td>
			<label for={ "risk-name-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_title") }</label>
			@ui2.Input(templ.Attributes{"id": "risk-name-" + risk.ID.String(), "name": "name_" + risk.ID.String(), "type": "text", "value": risk.Name, "placeholder": locale.T(ctx, "placeholder_risk_title")})
		</td>
		<td>
			<label for={ "risk-description-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_description") }</label>
			@ui2.Textarea(templ.Attributes{"id": "risk-description-" + risk.ID.String(), "name": "description_" + risk.ID.String(), "rows": "2", "placeholder": locale.T(ctx, "placeholder_risk_description_brief")}) { { risk.Description } }
		</td>
		<td>
			<div class="risk-fields">
				<div class="risk-results">
					if len(linkedAssets[risk.ID]) == 0 {
						<div class="risk-caption">
							{ locale.T(ctx, "empty_no_assets_linked") }
						</div>
					} else {
						for _, a := range linkedAssets[risk.ID] {
							<div class="risk-result-row">
								<div class="risk-truncation-container">
									<div class="risk-result-name">{ a.Name }</div>
									if a.Owner != "" {
										<div class="risk-result-detail">{ a.Owner }</div>
									}
								</div>
								<form method="POST" action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + risk.ID.String() + "/assets/" + a.ID.String() + "/remove") }>
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "return_to", "value": "step2"})
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "review", "value": reviewValue(isReview)})
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_q", "value": assetQueries[risk.ID]})
									@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_risk_id", "value": risk.ID.String()})
									@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "class": "risk-small-button"}) { { locale.T(ctx, "action_remove") } }
								</form>
							</div>
						}
					}
				</div>
				<div id={ "risk-asset-search-controls-" + risk.ID.String() } class="risk-controls">
					<label for={ "asset-q-" + risk.ID.String() } class="sr-only">{ locale.T(ctx, "label_search_assets") }</label>
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_risk_id", "value": risk.ID.String()})
					@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_search_partial", "value": "1"})
					@ui2.Input(templ.Attributes{"id": "asset-q-" + risk.ID.String(), "name": "asset_q", "type": "search", "value": assetQueries[risk.ID], "placeholder": locale.T(ctx, "placeholder_search_name_or_owner"), "hx-get": step2FormAction(assessmentID, isReview), "hx-trigger": "input changed delay:500ms, search", "hx-target": "#risk-asset-search-results-" + risk.ID.String(), "hx-include": "#risk-asset-search-controls-" + risk.ID.String(), "hx-swap": "innerHTML"})
				</div>
				<div id={ "risk-asset-search-results-" + risk.ID.String() }>
					@Step2AssetSearchResults(assessmentID, risk.ID.String(), isReview, assetQueries[risk.ID], assetResults[risk.ID])
				</div>
			</div>
		</td>
		<td>
			<form
				method="POST"
				action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + risk.ID.String() + "/delete") }
				hx-delete={ "/risks/" + assessmentID + "/risks/" + risk.ID.String() }
				hx-target={ "#risk-row-" + risk.ID.String() }
				hx-swap="outerHTML"
				hx-confirm="Delete this risk?"
			>
				@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
				@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "hx-on::after-request": templ.JSUnsafeFuncCall("document.getElementById('risk-step2-status').textContent='Risk deleted'; document.getElementById('risk_name')?.focus()"), "class": "risk-delete-button", "aria-label": locale.T(ctx, "action_delete_risk")}) {
					×
				}
			</form>
		</td>
	</tr>
}

// NewRiskRow is the HTMX partial returned after adding a risk.
templ NewRiskRow(risk db.Risk, assessmentID string) {
	@riskIdentRow(risk, assessmentID, map[uuid.UUID][]db.Asset{}, map[uuid.UUID]string{}, map[uuid.UUID][]db.Asset{}, false)
}

templ Step2AssetSearchResults(assessmentID, riskID string, isReview bool, assetQuery string, results []db.Asset) {
	if assetQuery != "" {
		<div class="risk-results">
			if len(results) == 0 {
				<div class="risk-description">{ locale.T(ctx, "empty_no_matching_assets_found") }</div>
			} else {
				for _, a := range results {
					<div class="risk-result-row">
						<div class="risk-truncation-container">
							<div class="risk-result-name">{ a.Name }</div>
							if a.Owner != "" {
								<div class="risk-result-detail">{ a.Owner }</div>
							}
						</div>
						<form method="POST" action={ templ.SafeURL("/risks/" + assessmentID + "/risks/" + riskID + "/assets/" + a.ID.String() + "/add") }>
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "return_to", "value": "step2"})
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "review", "value": reviewValue(isReview)})
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_q", "value": assetQuery})
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "asset_risk_id", "value": riskID})
							@ui2.Button(templ.Attributes{"type": "submit", "class": "risk-small-button"}) { { locale.T(ctx, "action_add") } }
						</form>
					</div>
				}
			}
		</div>
	}
}

func reviewValue(review bool) string {
	if review {
		return "1"
	}
	return "0"
}

func step2FormAction(assessmentID string, isReview bool) string {
	if isReview {
		return "/risks/" + assessmentID + "/review/step/2"
	}
	return "/risks/" + assessmentID + "/step/2"
}
