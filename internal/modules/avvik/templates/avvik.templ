package avviktemplates

import (
	"fmt"
	"time"

	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
	"github.com/3lbits/vigil/internal/ui2"
	formstemplates "github.com/3lbits/vigil/internal/ui2/forms"
)

type DetailData struct {
	Avvik         db.Avvik
	Tab           string
	Events        []db.AvvikEvent
	Measures      []db.Measure
	Activities    []db.Activity
	Attachments   []db.AvvikAttachment
	Notifications []db.AvvikNotification
	AllMeasures   []db.Measure
	AllActivities []db.ListActivitiesRow
	AllUsers      []db.User
	CanClose      bool
	CanManage     bool
	CanContribute bool
}

templ AvvikList(items []db.Avvik, orgs []db.Organization, q, status, risk, orgUnit string, mine bool) {
	@ui2.Page("ui2-avvik") {
	<div class="ops-between">
		<p class="ops-muted">{ fmt.Sprintf("%d avvik", len(items)) }</p>
		<a href="/avvik/new" class="ops-button">
			@ui.IconSVG("plus", 13)
			New Avvik
		</a>
	</div>
	@ui2.FilterBar(ui2.FilterBarProps{Action: "/avvik", Target: "#avvik-table"}) {
		@ui2.FilterSearch(ui2.FilterSearchProps{
			Value:   q,
			Columns: []string{"label_title", "label_description"},
			Action:  "/avvik",
			Target:  "#avvik-table",
		})
		@ui2.FilterSelect("status", "Filter by status") {
			<option value="" selected?={ status == "" }>All status</option>
			<option value="new" selected?={ status == "new" }>new</option>
			<option value="triaging" selected?={ status == "triaging" }>triaging</option>
			<option value="investigating" selected?={ status == "investigating" }>investigating</option>
			<option value="mitigating" selected?={ status == "mitigating" }>mitigating</option>
			<option value="closed" selected?={ status == "closed" }>closed</option>
		}
		@ui2.FilterSelect("risk", "Filter by risk") {
			<option value="" selected?={ risk == "" }>All risk</option>
			<option value="low" selected?={ risk == "low" }>low</option>
			<option value="medium" selected?={ risk == "medium" }>medium</option>
			<option value="high" selected?={ risk == "high" }>high</option>
		}
		@ui2.FilterSelect("org_unit", "Filter by org unit") {
			<option value="" selected?={ orgUnit == "" }>All org units</option>
			for _, org := range orgs {
				<option value={ org.ID.String() } selected?={ orgUnit == org.ID.String() }>{ org.Name }</option>
			}
		}
		@ui2.FilterMine(mine, "label_mine_only")
	}
	<div id="avvik-table">
		@AvvikTable(items)
	</div>
	}
}

templ AvvikTable(items []db.Avvik) {
	if len(items) == 0 {
		<p>No avvik yet.</p>
	} else {
		@ui2.Table("Avvik") {
				<thead>
					<tr>
						<th scope="col">Avvik</th>
						<th scope="col">Status</th>
						<th scope="col">Risk</th>
						<th scope="col">Flags</th>
						<th scope="col">Age</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range items {
						<tr>
							<td>
								<a href={ "/avvik/" + a.ID.String() } class="ops-link">{ a.Title }</a>
								if a.GdprDeadlineAt.Valid && a.Status != "closed" && time.Now().UTC().After(a.GdprDeadlineAt.Time.Add(-24*time.Hour)) {
									<p class="ops-error">GDPR clock</p>
								}
							</td>
							<td>
								@ui2.Badge(statusBadgeVariant(a.Status)) {
									{ a.Status }
								}
							</td>
							<td>
								@ui2.Badge(riskBadgeVariant(a.RiskLevel)) {
									{ a.RiskLevel }
								}
							</td>
							<td>
								if a.PersonalData {
									@ui2.Badge("danger") {PD}
								}
								if a.Ksi {
									@ui2.Badge("warning") {KSI}
								}
								if a.MarketSensitive {
									@ui2.Badge("neutral") {MS}
								}
							</td>
							<td>
								{ ageText(a.DiscoveredAt) }
							</td>
						</tr>
					}
				</tbody>
		}
	}
}

templ NewAvvikForm(orgs []db.Organization, users []db.User) {
	@ui2.Page("ui2-avvik") {
	<form method="POST" action="/avvik" class="ops-form ops-wide">
		<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
		<div>
			<label for="avvik-title" class="ops-label">{ locale.T(ctx, "label_title") } <span aria-hidden="true">*</span></label>
			<input id="avvik-title" name="title" type="text" required class="ops-input"/>
		</div>
		<div>
			<label for="avvik-description" class="ops-label">{ locale.T(ctx, "label_description") }</label>
			<textarea id="avvik-description" name="description" rows="4"></textarea>
		</div>
		<div class="ops-fields">
			<div>
				<label for="avvik-discovered-at" class="ops-label">{ locale.T(ctx, "label_when") }</label>
				<input id="avvik-discovered-at" name="discovered_at" type="date" class="ops-input"/>
			</div>
			<div>
				<label for="avvik-risk-level" class="ops-label">{ locale.T(ctx, "label_risk") }</label>
				<select id="avvik-risk-level" name="risk_level" class="ops-input">
					<option value="low">low</option>
					<option value="medium" selected>medium</option>
					<option value="high">high</option>
				</select>
			</div>
		</div>
		<div class="ops-fields">
			<div class="ops-stack">
				<label for="avvik-reporter-name" class="ops-label">Reporter name</label>
				<input id="avvik-reporter-name" name="reporter_name" type="search" list="reporter_name_list" placeholder="Search user by name/email or enter custom" class="ops-input"/>
				<datalist id="reporter_name_list">
					for _, u := range users {
						<option value={ u.Name } label={ u.Email }></option>
						<option value={ u.Email } label={ u.Name }></option>
					}
				</datalist>
			</div>
			<div>
				<label for="avvik-reporter-email" class="ops-label">{ locale.T(ctx, "label_email") }</label>
				<input id="avvik-reporter-email" name="reporter_email" type="email" class="ops-input"/>
			</div>
		</div>
		<div class="ops-fields">
			<div class="ops-stack">
				<label for="avvik-assigned-to" class="ops-label">Assigned to</label>
				<select id="avvik-assigned-to" name="assigned_to" class="ops-input">
					<option value="">Unassigned</option>
					for _, u := range users {
						<option value={ u.ID.String() }>{ u.Name }</option>
					}
				</select>
			</div>
			<div>
				<label for="avvik-org-unit" class="ops-label">{ locale.T(ctx, "label_org_unit") }</label>
				<select id="avvik-org-unit" name="org_unit_id" class="ops-input">
					<option value="">Not set</option>
					for _, org := range orgs {
						<option value={ org.ID.String() }>{ org.Name }</option>
					}
				</select>
			</div>
		</div>
		<div class="ops-fields ops-fields-three">
			<label class="ops-check-label"><input type="checkbox" name="personal_data" class="ops-input"/> Personal data</label>
			<label class="ops-check-label"><input type="checkbox" name="ksi" class="ops-input"/> KSI</label>
			<label class="ops-check-label"><input type="checkbox" name="market_sensitive" class="ops-input"/> Market sensitive</label>
		</div>
		<div class="ops-end">
			<button type="submit">Create Avvik</button>
		</div>
	</form>
	}
}

templ AvvikDetail(d DetailData) {
	@ui2.Page("ui2-avvik") {
	<div class="ops-stack">
		if d.Avvik.PersonalData && d.Avvik.Status != "closed" && d.Avvik.GdprDeadlineAt.Valid {
			<p role="alert" class="ops-error">
				GDPR deadline: { deadlineText(d.Avvik.GdprDeadlineAt.Time) } until Datatilsynet notification.
			</p>
		}
		if d.Avvik.Status == "new" {
			<aside class="ops-info-panel">
				<h2 class="ops-heading">Recommended next steps</h2>
				if d.CanManage {
					<p class="ops-muted">1) Triage details tab. 2) Link follow-up in measures or activities. 3) Keep timeline updated, then close in closure tab.</p>
				} else if d.CanContribute {
					<p class="ops-muted">You can track status and send updates in timeline/evidence tabs. Admins handle triage and closure.</p>
				} else {
					<p class="ops-muted">Avvik registered. An admin will triage and follow up. You can track status in the timeline.</p>
				}
			</aside>
		}
		@avvikRecentChanges(d.Events)
		<nav aria-label="Avvik sections" >
			@tabLink(d.Avvik.ID.String(), "details", d.Tab)
			@tabLink(d.Avvik.ID.String(), "timeline", d.Tab)
			@tabLink(d.Avvik.ID.String(), "measures", d.Tab)
			@tabLink(d.Avvik.ID.String(), "activities", d.Tab)
			@tabLink(d.Avvik.ID.String(), "evidence", d.Tab)
			@tabLink(d.Avvik.ID.String(), "notifications", d.Tab)
			@tabLink(d.Avvik.ID.String(), "closure", d.Tab)
		</nav>
		<div id="avvik-tab-panel">
			@AvvikTabPanel(d)
		</div>
	</div>
	}
}

templ avvikRecentChanges(events []db.AvvikEvent) {
	<details>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead>
					<tr>
						<th scope="col">{ locale.T(ctx, "label_event") }</th>
						<th scope="col">{ locale.T(ctx, "label_by") }</th>
						<th scope="col">{ locale.T(ctx, "label_when") }</th>
					</tr>
				</thead>
				<tbody>
					if len(events) == 0 {
						<tr><td colspan="3">{ locale.T(ctx, "label_no_changes_yet") }</td></tr>
					} else {
						for i, e := range events {
							if i < 5 {
								<tr>
									<td>{ e.EventType }</td>
									<td>{ e.ActorLabel }</td>
									<td>{ e.OccurredAt.Format("2 Jan 2006 15:04") }</td>
								</tr>
							}
						}
					}
				</tbody>
		}
	</details>
}

templ AvvikTabPanel(d DetailData) {
	switch d.Tab {
		case "timeline":
			@timelineTab(d)
		case "measures":
			@measuresTab(d)
		case "activities":
			@activitiesTab(d)
		case "evidence":
			@evidenceTab(d)
		case "notifications":
			@notificationsTab(d)
		case "closure":
			@closureTab(d)
		default:
			@detailsTab(d)
	}
}

templ detailsTab(d DetailData) {
	<div class="ops-stack">
		<section class="ops-card">
			<h2 class="ops-heading">{ d.Avvik.Title }</h2>
			<p class="ops-muted ops-pre-wrap">{ d.Avvik.Description }</p>
			<p class="ops-muted">Status: { d.Avvik.Status } · Risk: { d.Avvik.RiskLevel }</p>
		</section>
		if !d.CanManage {
			<p class="ops-warning-panel">Only admins can triage or update status.</p>
		} else {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/triage" } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div class="ops-fields">
				<select name="risk_level" class="ops-input">
					<option value="low" selected?={ d.Avvik.RiskLevel == "low" }>low</option>
					<option value="medium" selected?={ d.Avvik.RiskLevel == "medium" }>medium</option>
					<option value="high" selected?={ d.Avvik.RiskLevel == "high" }>high</option>
				</select>
				<input type="text" name="ksi_information_owner" value={ d.Avvik.KsiInformationOwner } placeholder="KSI information owner" class="ops-input"/>
			</div>
			<div class="ops-fields ops-fields-three">
				<label class="ops-check-label"><input type="checkbox" name="personal_data" checked?={ d.Avvik.PersonalData } class="ops-input"/> Personal data</label>
				<label class="ops-check-label"><input type="checkbox" name="ksi" checked?={ d.Avvik.Ksi } class="ops-input"/> KSI</label>
				<label class="ops-check-label"><input type="checkbox" name="market_sensitive" checked?={ d.Avvik.MarketSensitive } class="ops-input"/> Market sensitive</label>
			</div>
			<div class="ops-end"><button type="submit" class="ops-button">Save triage</button></div>
			</form>
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/status" } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div class="ops-fields">
				<select name="status" class="ops-input">
					<option value="new" selected?={ d.Avvik.Status == "new" }>new</option>
					<option value="triaging" selected?={ d.Avvik.Status == "triaging" }>triaging</option>
					<option value="investigating" selected?={ d.Avvik.Status == "investigating" }>investigating</option>
					<option value="mitigating" selected?={ d.Avvik.Status == "mitigating" }>mitigating</option>
				</select>
				<p class="ops-muted">Use closure tab for final close.</p>
			</div>
			<div class="ops-end"><button type="submit" class="ops-button">Update status</button></div>
			</form>
		}
	</div>
}

templ timelineTab(d DetailData) {
	<div class="ops-stack">
		if d.CanContribute {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/notes" } class="ops-form-inline">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<textarea name="note" rows="3" placeholder="Append timeline note..." class="ops-input"></textarea>
				<div class="ops-end"><button type="submit" class="ops-button">Add note</button></div>
			</form>
		}
		for _, e := range d.Events {
			<article aria-label={ e.EventType } class="ops-card">
				<p class="ops-muted">{ e.OccurredAt.Format(time.RFC3339) } · { e.EventType } · { e.ActorLabel }</p>
				<pre class="ops-pre-wrap">{ string(e.Payload) }</pre>
			</article>
		}
	</div>
}

templ measuresTab(d DetailData) {
	<div class="ops-stack">
		if d.CanManage {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/measures" } class="ops-form-inline">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<p class="ops-muted">Link existing measure</p>
				<div class="ops-fields">
					<select name="measure_id" class="ops-input">
						<option value="">Create new measure below</option>
						for _, m := range d.AllMeasures {
							<option value={ m.ID.String() }>{ m.Name }</option>
						}
					</select>
					<select name="relationship" class="ops-input">
						<option value="corrective">corrective</option>
						<option value="preventive">preventive</option>
						<option value="compensating">compensating</option>
					</select>
				</div>
				<p class="ops-muted">Or create new measure</p>
				@formstemplates.MeasureCreateFields(d.AllUsers, "avvik-measure-create")
				<div class="ops-end"><button type="submit" class="ops-button">Link measure</button></div>
			</form>
		}
		for _, m := range d.Measures {
			<article class="ops-card">
				<div class="ops-between">
					<h2 class="ops-heading"><a href={ "/measures/" + m.ID.String() } class="ops-link">{ m.Name }</a></h2>
					if d.CanManage {
						<button
							hx-delete={ "/avvik/" + d.Avvik.ID.String() + "/measures/" + m.ID.String() }
							data-tone="danger"
							hx-target="#avvik-tab-panel"
							hx-swap="outerHTML"
							hx-headers='{"X-CSRF-Token": "{{ csrf.TokenFromContext(ctx) }}"}'
							class="ops-danger-link"
						>unlink</button>
					}
				</div>
			</article>
		}
	</div>
}

templ activitiesTab(d DetailData) {
	<div class="ops-stack">
		if d.CanManage {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/activities" } class="ops-form-inline">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<p class="ops-muted">Link existing activity</p>
				<select name="activity_id" class="ops-input">
					<option value="">Create new activity below</option>
					for _, a := range d.AllActivities {
						<option value={ a.ID.String() }>{ a.Title }</option>
					}
				</select>
				<p class="ops-muted">Or create new activity</p>
				@formstemplates.ActivityCreateFields(d.AllMeasures, d.AllUsers, "avvik-activity-create", "Oppfølging avvik #"+d.Avvik.ID.String()[:8])
				<div class="ops-end"><button type="submit" class="ops-button">Link activity</button></div>
			</form>
		}
		for _, a := range d.Activities {
			<article class="ops-card">
				<div class="ops-between">
					<h2 class="ops-heading"><a href={ "/activities/" + a.ID.String() } class="ops-link">{ a.Title }</a></h2>
					if d.CanManage {
						<button
							hx-delete={ "/avvik/" + d.Avvik.ID.String() + "/activities/" + a.ID.String() }
							data-tone="danger"
							hx-target="#avvik-tab-panel"
							hx-swap="outerHTML"
							hx-headers='{"X-CSRF-Token": "{{ csrf.TokenFromContext(ctx) }}"}'
							class="ops-danger-link"
						>unlink</button>
					}
				</div>
			</article>
		}
	</div>
}

templ evidenceTab(d DetailData) {
	<div class="ops-stack">
		if d.CanContribute {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/attachments" } class="ops-form-inline">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<input type="text" name="filename" placeholder="Label / filename" class="ops-input"/>
				<input type="url" name="storage_key" placeholder="External URL (Confluence etc.)" class="ops-input"/>
				<div class="ops-end"><button type="submit" class="ops-button">Add evidence link</button></div>
			</form>
		}
		for _, a := range d.Attachments {
			<article class="ops-card">
				<h2 class="ops-heading"><a href={ a.StorageKey } class="ops-link">{ a.Filename }</a></h2>
				<p class="ops-muted">{ a.UploadedAt.Format(time.RFC3339) }</p>
			</article>
		}
	</div>
}

templ notificationsTab(d DetailData) {
	<div class="ops-stack">
		if d.CanManage {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/notifications" } class="ops-form-inline">
				<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
				<select name="audience" class="ops-input">
					<option value="reporter">reporter</option>
					<option value="management">management</option>
					<option value="organisation">organisation</option>
					<option value="exposed_employees">exposed_employees</option>
					<option value="datatilsynet">datatilsynet</option>
					<option value="nve">nve</option>
					<option value="finanstilsynet">finanstilsynet</option>
					<option value="bors">bors</option>
				</select>
				<textarea name="notes" rows="2" placeholder="Notes" class="ops-input"></textarea>
				<div class="ops-end"><button type="submit" class="ops-button">Record notification</button></div>
			</form>
		}
		for _, n := range d.Notifications {
			<article class="ops-card">
				<h2 class="ops-heading">{ n.Audience }</h2>
				<p class="ops-muted">{ n.SentAt.Format(time.RFC3339) }</p>
				if n.Notes != "" {
					<p class="ops-muted">{ n.Notes }</p>
				}
			</article>
		}
	</div>
}

templ closureTab(d DetailData) {
	<div class="ops-stack">
		if !d.CanManage {
			<p class="ops-warning-panel">Only admins can close avvik.</p>
		} else {
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/closure-flags" } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			@closureCheckbox("log_qa_done", "Log QA done", d.Avvik.LogQaDone)
			@closureCheckbox("followups_delegated", "Followups delegated", d.Avvik.FollowupsDelegated)
			@closureCheckbox("reporter_informed", "Reporter informed", d.Avvik.ReporterInformed)
			@closureCheckbox("org_informed", "Organisation informed", d.Avvik.OrgInformed)
			@closureCheckbox("mgmt_informed", "Management informed", d.Avvik.MgmtInformed)
			@closureCheckbox("decisions_anchored", "Decisions anchored", d.Avvik.DecisionsAnchored)
			@closureCheckbox("implementation_deadline_set", "Implementation deadline set", d.Avvik.ImplementationDeadlineSet)
			<div class="ops-end"><button type="submit" class="ops-button">Save checklist</button></div>
			</form>
			<form method="POST" action={ "/avvik/" + d.Avvik.ID.String() + "/close" } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<textarea name="closure_summary" rows="2" placeholder="Closure summary" class="ops-input"></textarea>
			<textarea name="root_cause" rows="2" placeholder="Root cause" class="ops-input"></textarea>
			<textarea name="lessons_learned" rows="2" placeholder="Lessons learned" class="ops-input"></textarea>
			<div class="ops-end">
				<button type="submit" data-tone="danger" disabled?={ !d.CanClose } class={ "ops-button ops-close", buttonCloseClass(d.CanClose) }>Close Avvik</button>
			</div>
			</form>
		}
	</div>
}

templ closureCheckbox(name, label string, checked bool) {
	<label class="ops-check-label">
		<input type="checkbox" name={ name } checked?={ checked } class="ops-input"/>
		{ label }
	</label>
}

templ tabLink(id, tab, current string) {
	<a
		href={ "/avvik/" + id + "?tab=" + tab }
		hx-get={ "/avvik/" + id + "?tab=" + tab }
		hx-target="#avvik-tab-panel"
		hx-swap="innerHTML"
		class={ "ops-tab", tabClass(tab == current) }
	>{ tab }</a>
}

func tabClass(active bool) string {
	if active {
		return "ops-tab-active"
	}
	return "ops-tab-inactive"
}

func statusBadgeVariant(status string) string {
	switch status {
	case "new":
		return "neutral"
	case "triaging", "investigating", "mitigating":
		return "warning"
	case "closed":
		return "success"
	default:
		return "default"
	}
}

func riskBadgeVariant(level string) string {
	switch level {
	case "high":
		return "danger"
	case "medium":
		return "warning"
	default:
		return "success"
	}
}

func ageText(discoveredAt time.Time) string {
	d := time.Since(discoveredAt)
	if d < 24*time.Hour {
		return fmt.Sprintf("%dh", int(d.Hours()))
	}
	return fmt.Sprintf("%dd", int(d.Hours()/24))
}

func deadlineText(deadline time.Time) string {
	remaining := time.Until(deadline)
	if remaining <= 0 {
		return "overdue"
	}
	if remaining < 24*time.Hour {
		return fmt.Sprintf("%d hours left", int(remaining.Hours()))
	}
	return fmt.Sprintf("%d days left", int(remaining.Hours()/24))
}

func buttonCloseClass(enabled bool) string {
	if enabled {
		return "ops-close-ready"
	}
	return "ops-close-disabled"
}
