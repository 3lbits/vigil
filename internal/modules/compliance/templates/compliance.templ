package compliancetemplates

import (
	"fmt"
	"strings"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
)

// ── Framework list ──

templ FrameworkList(frameworks []FrameworkVM, expandID, flash, flashType string) {
	@ui.Flash(flash, flashType)

	<div class="flex flex-wrap justify-between items-center gap-3 mb-4">
		<p data-testid="framework-count" class="text-[13px] text-sand-700">{ locale.TN(ctx, "fw_count", len(frameworks), map[string]any{"Count": len(frameworks)}) }</p>
		<div class="flex gap-2">
			<a href="/compliance/frameworks/new" class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-400 hover:bg-sand-100 transition-colors flex items-center gap-1.5">
				@ui.IconSVG("plus", 13)
				{ locale.T(ctx, "action_add_framework") }
			</a>
		</div>
	</div>

	if len(frameworks) == 0 {
		@ui.EmptyState(ui.EmptyStateProps{
			TestID: "no-frameworks-empty",
			Class:  "border-solid border-sand-300/60 rounded-[10px] p-8 bg-white dark:bg-zinc-900",
		}) {
			<div class="text-sand-700 text-[13px]">{ locale.T(ctx, "frameworks_none_yet") }</div>
			<a href="/compliance/frameworks/new" class="text-blue-600 text-[13px] hover:underline">Add your first framework →</a>
		}
	} else {
		<div class="flex flex-col gap-2.5">
			for _, fw := range frameworks {
				@frameworkAccordion(fw, expandID)
			}
		</div>
	}
}

templ frameworkAccordion(fw FrameworkVM, expandID string) {
	@ui.Card(ui.CardProps{
		Class:   "border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden",
		Padding: "p-0",
		Attrs: templ.Attributes{
			"id":     "fw-" + fw.Framework.ID.String(),
			"x-data": "{ expanded: " + fmt.Sprint(fw.Framework.ID.String() == expandID) + " }",
		},
	}) {
		<div class="w-full p-3.5 px-4 flex items-center gap-3.5">
			<button
				type="button"
				class="flex-1 min-w-0 flex items-center gap-3.5 text-left cursor-pointer"
				@click="expanded = !expanded"
				:aria-expanded="expanded ? 'true' : 'false'"
				aria-controls={ "fw-reqs-" + fw.Framework.ID.String() }
			>
				<span
					class="text-sand-700 transition-transform duration-150 shrink-0"
					:class="expanded ? 'rotate-90' : ''"
					aria-hidden="true"
				>
					@ui.IconSVG("chevron", 14)
				</span>
				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 mb-2 flex-wrap">
						<span class="text-sm font-medium">{ fw.Framework.Name }</span>
						if fw.Framework.Version != "" {
							<span class="text-[11px] text-sand-700">{ fw.Framework.Version }</span>
						}
						if fw.Framework.NotRelevant {
							@ui.Badge(ui.BadgeProps{
								Variant: "neutral",
								Class:   "text-[10px] font-medium px-1.5 rounded border-sand-300",
							}) { { locale.T(ctx, "label_not_relevant") } }
						}
					</div>
					<div class="flex items-center gap-2">
						<div class="flex-1">
							@ui.CoverageProgressBar(fw.Coverage)
						</div>
						<span class="text-[11px] font-medium text-sand-700 shrink-0 w-8 text-right">{ fmt.Sprintf("%d%%", fw.Coverage) }</span>
					</div>
				</div>
			</button>
			<div class="flex items-center gap-3 shrink-0">
				<span class="text-xs text-sand-700">{ fmt.Sprintf("%d reqs", fw.TotalReqs) }</span>
				<div class="flex gap-1">
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String()) }
						class="text-[11px] text-sand-700 hover:text-sand-900 border border-sand-300 rounded px-2 py-1 hover:bg-sand-50">
						Open
					</a>
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/import") }
						class="text-[11px] text-sand-700 hover:text-sand-900 border border-sand-300 rounded px-2 py-1 hover:bg-sand-50 flex items-center gap-1">
						@ui.IconSVG("upload", 11)
						{ locale.T(ctx, "action_import") }
					</a>
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/edit") }
						class="text-[11px] text-sand-700 hover:text-sand-900 border border-sand-300 rounded px-2 py-1 hover:bg-sand-50">
						{ locale.T(ctx, "action_edit") }
					</a>
					<form method="POST" action={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/delete") }
						onsubmit="return confirm('Delete this framework and all its requirements?')">
						<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
						<button type="submit" class="text-[11px] text-red-600 hover:text-red-800 border border-red-200 rounded-md px-2 py-1 hover:bg-red-50 transition-colors">
							{ locale.T(ctx, "action_delete") }
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Requirements table (expanded) -->
		<div
			id={ "fw-reqs-" + fw.Framework.ID.String() }
			x-show="expanded"
			:aria-hidden="expanded ? 'false' : 'true'"
			class="border-t border-sand-300/60"
		>
			<div class="p-3 px-4 flex justify-between items-center bg-sand-50/60">
				<span class="text-[11px] text-sand-700 uppercase tracking-wider">{ locale.T(ctx, "section_requirements") }</span>
				<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/new") }
					class="text-[11px] text-blue-600 hover:underline flex items-center gap-1">
					@ui.IconSVG("plus", 11)
					{ locale.T(ctx, "action_add_requirement") }
				</a>
			</div>
			if len(fw.Requirements) == 0 {
				<div class="px-4 py-6 text-center text-[13px] text-sand-700">
					No requirements yet. <a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/import") } class="text-blue-600 hover:underline">Import from CSV</a> or add manually.
				</div>
			} else {
				@RequirementsTable(fw.Requirements)
			}
		</div>
	}
}

templ CoverageBadge(pct int) {
	if pct >= 80 {
		@ui.Badge(ui.BadgeProps{
			Variant: "success",
		}) { { fmt.Sprintf("%d%%", pct) } }
	} else if pct >= 50 {
		@ui.Badge(ui.BadgeProps{
			Variant: "default",
			Class:   "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-800",
		}) { { fmt.Sprintf("%d%%", pct) } }
	} else {
		@ui.Badge(ui.BadgeProps{
			Variant: "warning",
		}) { { fmt.Sprintf("%d%%", pct) } }
	}
}

templ RequirementsTable(reqs []RequirementVM) {
	@ui.Table(ui.TableProps{}) {
		<caption class="sr-only">Requirements</caption>
		@ui.THead(ui.THeadProps{
			Attrs: templ.Attributes{
				"class": "bg-sand-100 dark:bg-zinc-800",
			},
		}) {
			@ui.Tr(ui.TrProps{}) {
				@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { Ref }
				@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Title }
				@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Measures }
				@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-right text-[11px]"}}) { <span class="sr-only">Actions</span> }
			}
		}
		<tbody>
			for _, rvm := range reqs {
				@ui.Tr(ui.TrProps{
					Attrs: templ.Attributes{
						"class": "border-sand-300/60 dark:border-zinc-700/60",
					},
				}) {
					@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-mono text-xs text-sand-700"}}) { { rvm.Requirement.Ref } }
					@ui.Td(ui.TdProps{}) {
						<a href={ templ.SafeURL("/compliance/requirements/" + rvm.Requirement.ID.String()) } class="hover:text-blue-700 hover:underline">{ rvm.Requirement.Title }</a>
						if rvm.Requirement.NotRelevant {
							@ui.Badge(ui.BadgeProps{
								Variant: "default",
								Class:   "ml-1.5 text-[10px] px-1.5 rounded",
							}) { { locale.T(ctx, "label_not_relevant") } }
						}
					}
					@ui.Td(ui.TdProps{}) {
						if rvm.Requirement.NotRelevant {
							<span class="text-[11px] text-sand-700">—</span>
						} else if len(rvm.Measures) == 0 {
							<span class="text-[11px] text-sand-700 dark:text-zinc-400">none</span>
						} else {
							<div class="flex gap-1 flex-wrap">
								for _, m := range rvm.Measures {
									@ui.StatusBadge(m.Status)
								}
							</div>
						}
					}
					@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 text-right"}}) {
						<a href={ templ.SafeURL("/compliance/requirements/" + rvm.Requirement.ID.String() + "/edit") }
							aria-label={ "Edit requirement " + rvm.Requirement.Ref + ": " + rvm.Requirement.Title }
							class="text-[11px] text-sand-700 hover:text-sand-900 py-1 px-1.5 rounded">edit</a>
					}
				}
			}
		</tbody>
	}
}

// ── Framework form ──

templ FrameworkForm(fw *db.Framework, flash, flashType string, auditLog []db.ListAuditLogForFrameworkRow) {
	@ui.Flash(flash, flashType)

	<div class="max-w-lg">
		<form method="POST" action={ fwFormAction(fw) } class="flex flex-col gap-4">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			@inputField("label_name", "name", "e.g. ISO 27001", fwFieldVal(fw, "name"), true)
			@inputField("label_short_name", "short_name", "e.g. ISO", fwFieldVal(fw, "short_name"), false)
			@inputField("label_version", "version", "e.g. 2022", fwFieldVal(fw, "version"), false)
			@textareaField("label_description", "description", "Optional description", fwFieldVal(fw, "description"))
			@ui.Field("framework_type", "label_type", false) {
				@ui.Select(ui.SelectProps{
					ID:    "framework_type",
					Name:  "framework_type",
					Class: "text-[13px]",
				}) {
					<option value="regulation" selected?={ fwFieldVal(fw, "framework_type") != "standard" && fwFieldVal(fw, "framework_type") != "directive" }>{ locale.T(ctx, "fw_type_regulation") }</option>
					<option value="standard" selected?={ fwFieldVal(fw, "framework_type") == "standard" }>{ locale.T(ctx, "fw_type_standard") }</option>
					<option value="directive" selected?={ fwFieldVal(fw, "framework_type") == "directive" }>{ locale.T(ctx, "fw_type_directive") }</option>
				}
			}

			<div class="flex flex-col gap-2 pt-1 border-t border-sand-200">
				<label class="flex items-center gap-2 text-[13px] text-sand-800 cursor-pointer">
					<input type="checkbox" name="not_relevant" value="on" checked?={ fw != nil && fw.NotRelevant }
						class="w-4 h-4 rounded border-sand-400 text-blue-600 focus:ring-blue-500"/>
					{ locale.T(ctx, "label_mark_not_relevant") }
				</label>
				@textareaField("label_reason_optional", "not_relevant_reason", "Explain why this framework does not apply", fwFieldVal(fw, "not_relevant_reason"))
			</div>

			<div class="flex gap-2 pt-1">
				@ui.Button(ui.ButtonProps{
					Attrs: templ.Attributes{
						"type": "submit",
					},
				}) {
					if fw == nil {
						{ locale.T(ctx, "action_create_framework") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				}
				<a href="/compliance" class="text-[13px] py-2 px-4 rounded-md border border-sand-400 text-sand-700 hover:bg-sand-100 transition-colors">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
		if fw != nil {
			@frameworkRecentChanges(auditLog, "mt-8")
		}
	</div>
}

func fwFormAction(fw *db.Framework) templ.SafeURL {
	if fw == nil {
		return "/compliance/frameworks"
	}
	return templ.SafeURL("/compliance/frameworks/" + fw.ID.String())
}

func fwFieldVal(fw *db.Framework, field string) string {
	if fw == nil {
		return ""
	}
	switch field {
	case "name":
		return fw.Name
	case "short_name":
		return fw.ShortName
	case "version":
		return fw.Version
	case "description":
		return fw.Description
	case "framework_type":
		return fw.FrameworkType
	case "not_relevant_reason":
		return fw.NotRelevantReason
	}
	return ""
}

// ── Requirement form ──

templ RequirementForm(frameworkID string, req *db.Requirement, flash, flashType string, auditLog []db.ListAuditLogForRequirementRow) {
	@ui.Flash(flash, flashType)

	<div class="max-w-lg">
		<form method="POST" action={ reqFormAction(frameworkID, req) } class="flex flex-col gap-4">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			@inputField("label_reference", "ref", "e.g. A.5.1 or Art.21", reqFieldVal(req, "ref"), true)
			@inputField("label_title", "title", "Short title of the requirement", reqFieldVal(req, "title"), true)
			@textareaField("label_description", "description", "Optional detailed description", reqFieldVal(req, "description"))
			@inputField("label_sort_order", "sort_order", "0", reqFieldVal(req, "sort_order"), false)

			<div class="flex flex-col gap-2 pt-1 border-t border-sand-200">
				<label class="flex items-center gap-2 text-[13px] text-sand-800 cursor-pointer">
					<input type="checkbox" name="not_relevant" value="on" checked?={ req != nil && req.NotRelevant }
						class="w-4 h-4 rounded border-sand-400 text-blue-600 focus:ring-blue-500"/>
					{ locale.T(ctx, "label_mark_not_relevant") }
				</label>
				@textareaField("label_reason_required_if_not_relevant", "not_relevant_reason", "Explain why this requirement does not apply", reqFieldVal(req, "not_relevant_reason"))
			</div>

			<div class="flex gap-2 pt-1">
				@ui.Button(ui.ButtonProps{
					Attrs: templ.Attributes{
						"type": "submit",
					},
				}) {
					if req == nil {
						{ locale.T(ctx, "action_add_requirement") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				}
				<a href="/compliance" class="text-[13px] py-2 px-4 rounded-md border border-sand-400 text-sand-700 hover:bg-sand-100 transition-colors">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
		if req != nil {
			@requirementRecentChanges(auditLog, "mt-8")
		}
	</div>
}

func reqFormAction(frameworkID string, req *db.Requirement) templ.SafeURL {
	if req == nil {
		return templ.SafeURL("/compliance/frameworks/" + frameworkID + "/requirements")
	}
	return templ.SafeURL("/compliance/requirements/" + req.ID.String())
}

func reqFieldVal(req *db.Requirement, field string) string {
	if req == nil {
		return ""
	}
	switch field {
	case "ref":
		return req.Ref
	case "title":
		return req.Title
	case "description":
		return req.Description
	case "sort_order":
		return fmt.Sprint(req.SortOrder)
	case "not_relevant_reason":
		return req.NotRelevantReason
	}
	return ""
}

// ── CSV import form ──

templ ImportForm(frameworkID string, flash, flashType string, result *ImportResult) {
	@ui.Flash(flash, flashType)

	<div class="max-w-lg">
		if result != nil && result.Count > 0 {
			<div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-[13px]">
				{ fmt.Sprintf("✓ Imported %d requirements successfully.", result.Count) }
			</div>
		}
		if result != nil && len(result.Errors) > 0 {
			<div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-[13px]">
				<div class="font-medium mb-1">Import errors:</div>
				for _, e := range result.Errors {
					<div>{ e }</div>
				}
			</div>
		}

		<div class="mb-5 p-4 bg-sand-50 rounded-lg border border-sand-200 text-[13px] text-sand-700">
			<p class="font-medium mb-1">CSV format</p>
			<p class="text-sand-700 mb-2">The file must have a header row with these columns:</p>
			<code class="font-mono text-[12px]">ref, title, description, sort_order</code>
			<p class="text-sand-700 mt-2 text-[11px]">Only <code class="font-mono">ref</code> and <code class="font-mono">title</code> are required.</p>
		</div>

		<form method="POST" action={ templ.SafeURL("/compliance/frameworks/" + frameworkID + "/requirements/import") } enctype="multipart/form-data" class="flex flex-col gap-4">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div>
				<label for="csv_file" class="block text-[13px] font-medium text-sand-800 mb-1">
					CSV file <span aria-hidden="true" class="text-red-500">*</span>
				</label>
				<input type="file" id="csv_file" name="csv_file" accept=".csv,text/csv" required
					class="w-full text-[13px] border border-sand-400 rounded-md py-2 px-3 bg-transparent file:mr-3 file:py-1 file:px-2 file:border file:border-sand-300 file:rounded file:text-[12px] file:bg-sand-50 file:text-sand-700"/>
			</div>
			<div class="flex gap-2 pt-1">
				@ui.Button(ui.ButtonProps{
					Attrs: templ.Attributes{
						"type": "submit",
					},
				}) {
					@ui.IconSVG("upload", 13)
					{ locale.T(ctx, "action_import_requirements") }
				}
				<a href="/compliance" class="text-[13px] py-2 px-4 rounded-md border border-sand-400 text-sand-700 hover:bg-sand-100 transition-colors">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
	</div>
}

// ── Requirement detail ──

templ RequirementDetail(vm RequirementDetailVM) {
	<div class="flex justify-between items-center mb-6">
		<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Requirement.FrameworkID.String()) } class="text-[13px] text-sand-700 dark:text-zinc-400 hover:text-sand-800 dark:hover:text-zinc-100 flex items-center gap-1.5">
			@ui.IconSVG("chevron", 13)
			{ vm.FrameworkShort }
		</a>
		if vm.CanEdit {
			<div class="flex items-center gap-2">
				<a href={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/edit") }
					class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-400 hover:bg-sand-100 transition-colors">
					Edit requirement
				</a>
				<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/delete") }
					onsubmit="return confirm('Delete this requirement?')">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<button type="submit" class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-red-200 text-red-600 hover:text-red-800 hover:bg-red-50 transition-colors">
						{ locale.T(ctx, "action_delete") }
					</button>
				</form>
			</div>
		} else {
			<span class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-300 text-sand-700 cursor-not-allowed select-none" title="You don't have permission to edit">
				Edit requirement
			</span>
		}
	</div>

	<div class="grid grid-cols-[120px_1fr] gap-x-6 gap-y-3 mb-6 text-[13px] max-w-xl">
		<span class="text-[11px] uppercase tracking-wider text-sand-700 font-medium pt-0.5">Framework</span>
		<span class="flex items-center gap-2">
			@ui.Badge(ui.BadgeProps{
				Variant: "default",
				Class:   "font-mono text-[11px] px-1.5 rounded",
			}) { { vm.FrameworkShort } }
			<span class="text-sand-700">{ vm.FrameworkName }</span>
		</span>
		<span class="text-[11px] uppercase tracking-wider text-sand-700 font-medium pt-0.5">Reference</span>
		<span class="font-mono text-[13px] text-sand-800">{ vm.Requirement.Ref }</span>
		<span class="text-[11px] uppercase tracking-wider text-sand-700 font-medium pt-0.5">Status</span>
		if vm.Requirement.NotRelevant {
			@ui.Badge(ui.BadgeProps{
				Variant: "default",
				Class:   "text-[11px] px-1.5 rounded",
			}) { { locale.T(ctx, "label_not_relevant") } }
		} else {
			@ui.Badge(ui.BadgeProps{
				Variant: "success",
				Class:   "text-[11px] px-1.5 rounded",
			}) { Relevant }
		}
		if vm.Requirement.Description != "" {
			<span class="text-[11px] uppercase tracking-wider text-sand-700 font-medium pt-0.5">Description</span>
			<span class="text-sand-700">{ vm.Requirement.Description }</span>
		}
		if vm.Requirement.NotRelevant {
			if vm.Requirement.NotRelevantReason != "" {
				<span class="text-[11px] uppercase tracking-wider text-sand-700 font-medium pt-0.5">Reason</span>
				<span class="text-sand-700">{ vm.Requirement.NotRelevantReason }</span>
			}
		}
	</div>

	<div class="border-t border-sand-300/60 dark:border-zinc-700/60 pt-6">
		<h2 class="text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3">
			Measures
			<span class="ml-1 text-[11px] font-normal text-sand-700">({ fmt.Sprint(len(vm.Measures)) })</span>
		</h2>
		if len(vm.Measures) == 0 {
			<p class="text-[13px] text-sand-700 dark:text-zinc-400">{ locale.T(ctx, "req_none_linked") }</p>
		} else {
			<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
				@ui.Table(ui.TableProps{}) {
					<caption class="sr-only">Linked measures</caption>
					@ui.THead(ui.THeadProps{
						Attrs: templ.Attributes{
							"class": "bg-sand-100 dark:bg-zinc-800",
						},
					}) {
						@ui.Tr(ui.TrProps{}) {
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { Measure }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Status }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Owner }
						}
					}
					<tbody>
						for _, m := range vm.Measures {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4"}}) {
									<a href={ templ.SafeURL("/measures/" + m.ID.String()) } class="font-medium hover:text-blue-700 hover:underline">{ m.Name }</a>
									if m.Category != "" {
										<div class="text-[11px] text-sand-700">{ m.Category }</div>
									}
								}
								@ui.Td(ui.TdProps{}) {@ui.StatusBadge(m.Status)}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) { m.Owner }
							}
						}
					</tbody>
				}
			</div>
		}
	</div>

	@requirementRecentChanges(vm.AuditLog, "border-t border-sand-300/60 dark:border-zinc-700/60 pt-6 mt-2")
}

func complianceAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

// ── Requirement edit page (form + links) ──

templ RequirementEditPage(vm RequirementEditVM, flash, flashType string) {
	@RequirementForm(vm.Requirement.FrameworkID.String(), &vm.Requirement, flash, flashType, vm.AuditLog)
	@requirementLinksSection(vm)
}

templ requirementLinksSection(vm RequirementEditVM) {
	<div class="mt-8 max-w-lg">
		<h2 class="text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3">{ locale.T(ctx, "label_measures") }</h2>
		if len(vm.LinkedMeasures) == 0 {
			<p class="text-[13px] text-sand-700 dark:text-zinc-400 mb-4">{ locale.T(ctx, "req_none_linked") }</p>
		} else {
			<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden mb-4">
				@ui.Table(ui.TableProps{}) {
					<caption class="sr-only">Linked measures</caption>
					@ui.THead(ui.THeadProps{
						Attrs: templ.Attributes{
							"class": "bg-sand-100 dark:bg-zinc-800",
						},
					}) {
						@ui.Tr(ui.TrProps{}) {
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { Measure }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Status }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Owner }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-right text-[11px]"}}) { <span class="sr-only">Actions</span> }
						}
					}
					<tbody>
						for _, m := range vm.LinkedMeasures {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4"}}) {
									<div class="font-medium">{ m.Name }</div>
									if m.Category != "" {
										<div class="text-[11px] text-sand-700">{ m.Category }</div>
									}
								}
								@ui.Td(ui.TdProps{}) {@ui.StatusBadge(m.Status)}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) { m.Owner }
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 text-right"}}) {
									<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/measures/" + m.ID.String() + "/delete") }>
										<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
										<button type="submit" aria-label={ "Remove measure " + m.Name } class="text-[11px] text-red-600 hover:text-red-800">remove</button>
									</form>
								}
							}
						}
					</tbody>
				}
			</div>
		}
		<div class="space-y-2">
			<label for="measure-link-search" class="block text-[12px] font-medium text-sand-700 dark:text-zinc-300">Search and link measure</label>
			@ui.Input(ui.InputProps{
				ID:          "measure-link-search",
				Type:        "search",
				Name:        "q",
				Placeholder: "Type measure name...",
				Attrs: templ.Attributes{
					"class":      "text-[13px]",
					"hx-get":     templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/measures/search"),
					"hx-trigger": "input changed delay:250ms, search",
					"hx-target":  "#requirement-measure-search-results-" + vm.Requirement.ID.String(),
					"hx-swap":    "innerHTML",
				},
			})
			@RequirementMeasureSearchResults(vm.Requirement.ID.String(), nil, "")
		</div>
	</div>
}

templ RequirementMeasureSearchResults(requirementID string, measures []db.Measure, query string) {
	<div id={ "requirement-measure-search-results-" + requirementID } class="space-y-2">
		if strings.TrimSpace(query) == "" {
			<p class="text-[12px] text-sand-700 dark:text-zinc-400">Start typing to find measures.</p>
		} else if len(measures) == 0 {
			<p class="text-[12px] text-sand-700 dark:text-zinc-400">No matching unlinked measures.</p>
		} else {
			<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
				@ui.Table(ui.TableProps{}) {
					<caption class="sr-only">Measure search results</caption>
					<tbody>
						for _, m := range measures {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "first:border-t-0 border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4"}}) {
									<div class="font-medium">{ m.Name }</div>
									if m.Category != "" {
										<div class="text-[11px] text-sand-700">{ m.Category }</div>
									}
								}
								@ui.Td(ui.TdProps{}) {@ui.StatusBadge(m.Status)}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 text-right"}}) {
									<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + requirementID + "/measures") }>
										<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
										<input type="hidden" name="measure_id" value={ m.ID.String() }/>
										<button type="submit" class="text-[11px] text-blue-700 hover:text-blue-900">{ locale.T(ctx, "action_link_measure") }</button>
									</form>
								}
							}
						}
					</tbody>
				}
			</div>
		}
	</div>
}

// ── Shared form helpers ──

templ inputField(labelKey, name, placeholder, value string, required bool) {
	@ui.Field(name, labelKey, required) {
		@ui.Input(ui.InputProps{
			ID:          name,
			Name:        name,
			Type:        "text",
			Value:       value,
			Placeholder: placeholder,
			Required:    required,
		})
	}
}

templ textareaField(labelKey, name, placeholder, value string) {
	@ui.Field(name, labelKey, false) {
		@ui.Textarea(ui.TextareaProps{
			ID:          name,
			Name:        name,
			Placeholder: placeholder,
			Value:       value,
			Class:       "resize-y min-h-0",
			Attrs: templ.Attributes{
				"rows": "3",
			},
		})
	}
}

// ── Framework detail ──

templ FrameworkDetail(vm FrameworkDetailVM) {
	<div class="flex justify-between items-center mb-6">
		<a href="/compliance" class="text-[13px] text-sand-700 hover:text-sand-800 flex items-center gap-1.5">
			@ui.IconSVG("chevron", 13)
			Compliance
		</a>
		if vm.CanEdit {
			<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Framework.ID.String() + "/edit") }
				class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-400 dark:border-zinc-600 hover:bg-sand-100 dark:hover:bg-zinc-800 transition-colors">
				Edit framework
			</a>
		} else {
			<span class="text-xs font-medium py-1.5 px-3.5 rounded-md border border-sand-300 dark:border-zinc-700 text-sand-700 dark:text-zinc-400 cursor-not-allowed select-none" title="You don't have permission to edit">
				Edit framework
			</span>
		}
	</div>

	<div class="grid grid-cols-[120px_1fr] gap-x-6 gap-y-3 mb-6 text-[13px] max-w-xl">
		<span class="text-[11px] uppercase tracking-wider text-sand-700 dark:text-zinc-400 font-medium pt-0.5">Type</span>
		<span class="text-sand-700 dark:text-zinc-300">{ vm.Framework.FrameworkType }</span>
		if vm.Framework.Version != "" {
			<span class="text-[11px] uppercase tracking-wider text-sand-700 dark:text-zinc-400 font-medium pt-0.5">Version</span>
			<span class="text-sand-700 dark:text-zinc-300">{ vm.Framework.Version }</span>
		}
		if vm.Framework.Description != "" {
			<span class="text-[11px] uppercase tracking-wider text-sand-700 dark:text-zinc-400 font-medium pt-0.5">Description</span>
			<span class="text-sand-700 dark:text-zinc-300">{ vm.Framework.Description }</span>
		}
		<span class="text-[11px] uppercase tracking-wider text-sand-700 dark:text-zinc-400 font-medium pt-0.5">{ locale.T(ctx, "label_coverage") }</span>
		<span class="flex items-center gap-3">
			<span class="text-sand-800 dark:text-zinc-200 font-medium">{ fmt.Sprint(vm.CoveredReqs) } / { fmt.Sprint(len(vm.Requirements)) } requirements covered</span>
			if len(vm.Requirements) > 0 {
				<span class="w-32">
					@ui.CoverageProgressBar(int(vm.CoveredReqs * 100 / int64(len(vm.Requirements))))
				</span>
			}
		</span>
	</div>
	if len(vm.Requirements) > 0 {
		<div class="mb-6 flex flex-wrap items-center gap-2 text-xs">
			<span class="text-sand-700 dark:text-zinc-400 font-medium uppercase tracking-wider">Quick links</span>
			<a href="#implementation-mapping" class="rounded-full border border-sand-300/70 dark:border-zinc-700 px-2.5 py-1 text-sand-700 dark:text-zinc-300 hover:bg-sand-100 dark:hover:bg-zinc-800">Implementation mapping</a>
			<a href="#statement-of-applicability" class="rounded-full border border-sand-300/70 dark:border-zinc-700 px-2.5 py-1 text-sand-700 dark:text-zinc-300 hover:bg-sand-100 dark:hover:bg-zinc-800">SOA</a>
		</div>
	}

	if len(vm.Requirements) > 0 {
		<div id="implementation-mapping" class="border-t border-sand-300/60 dark:border-zinc-700/60 pt-6 scroll-mt-24">
			<h2 class="text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3">
				Implementation mapping (requirements → measures)
			</h2>
			<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
				@ui.Table(ui.TableProps{}) {
					<caption class="sr-only">Requirement implementation mapping</caption>
					@ui.THead(ui.THeadProps{
						Attrs: templ.Attributes{
							"class": "bg-sand-100 dark:bg-zinc-800",
						},
					}) {
						@ui.Tr(ui.TrProps{}) {
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { Ref }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Requirement }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Measures }
						}
					}
					<tbody>
						for _, row := range vm.RequirementImplementations {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60 align-top",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-mono text-xs text-sand-700 dark:text-zinc-400"}}) { { row.Requirement.Ref } }
								@ui.Td(ui.TdProps{}) {
									<a href={ templ.SafeURL("/compliance/requirements/" + row.Requirement.ID.String()) } class="hover:text-blue-700 hover:underline">{ row.Requirement.Title }</a>
								}
								@ui.Td(ui.TdProps{}) {
									if len(row.Measures) == 0 {
										<span class="text-sand-700 dark:text-zinc-400">No measures linked</span>
									} else {
										<ul class="space-y-1">
											for _, m := range row.Measures {
												<li class="flex items-center gap-2">
													<a href={ templ.SafeURL("/measures/" + m.ID.String()) } class="hover:text-blue-700 hover:underline">{ m.Name }</a>
													@ui.StatusBadge(m.Status)
												</li>
											}
										</ul>
									}
								}
							}
						}
					</tbody>
				}
			</div>
		</div>
	}
	<div id="statement-of-applicability" class="border-t border-sand-300/60 dark:border-zinc-700/60 pt-6 scroll-mt-24">
		<h2 class="text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3">
			Statement of applicability (SOA)
			<span class="ml-1 text-[11px] font-normal text-sand-700 dark:text-zinc-400">({ fmt.Sprint(len(vm.Requirements)) })</span>
		</h2>
		if len(vm.Requirements) == 0 {
			<p class="text-[13px] text-sand-700 dark:text-zinc-400">No requirements yet.
				if vm.CanEdit {
					<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Framework.ID.String() + "/requirements/new") } class="text-blue-600 hover:underline">Add one →</a>
				}
			</p>
		} else {
			<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
				@ui.Table(ui.TableProps{}) {
					<caption class="sr-only">Statement of applicability</caption>
					@ui.THead(ui.THeadProps{
						Attrs: templ.Attributes{
							"class": "bg-sand-100 dark:bg-zinc-800",
						},
					}) {
						@ui.Tr(ui.TrProps{}) {
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px]"}}) { Ref }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Requirement }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Applicability }
							@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px]"}}) { Justification }
						}
					}
					<tbody>
						for _, req := range vm.Requirements {
							@ui.Tr(ui.TrProps{
								Attrs: templ.Attributes{
									"class": "border-sand-300/60 dark:border-zinc-700/60",
								},
							}) {
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-mono text-xs text-sand-700 dark:text-zinc-400"}}) { { req.Ref } }
								@ui.Td(ui.TdProps{}) {
									<a href={ templ.SafeURL("/compliance/requirements/" + req.ID.String()) } class="hover:text-blue-700 hover:underline">{ req.Title }</a>
									if req.Description != "" {
										<div class="text-[11px] text-sand-700 dark:text-zinc-400 mt-0.5 truncate max-w-md">{ req.Description }</div>
									}
								}
								@ui.Td(ui.TdProps{}) {
									if req.NotRelevant {
										@ui.Badge(ui.BadgeProps{
											Variant: "default",
											Class:   "text-[11px] px-1.5 rounded",
										}) { { locale.T(ctx, "label_not_relevant") } }
									} else {
										@ui.Badge(ui.BadgeProps{
											Variant: "success",
											Class:   "text-[11px] px-1.5 rounded",
										}) { Relevant }
									}
								}
								@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700 dark:text-zinc-400"}}) {
									if req.NotRelevant && req.NotRelevantReason != "" {
										{ req.NotRelevantReason }
									} else {
										N/A
									}
								}
							}
						}
					</tbody>
				}
			</div>
		}
	</div>
	@frameworkRecentChanges(vm.AuditLog, "border-t border-sand-300/60 dark:border-zinc-700/60 pt-6 mt-2")
}

templ requirementRecentChanges(auditLog []db.ListAuditLogForRequirementRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="cursor-pointer text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3 list-none">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
			@ui.Table(ui.TableProps{}) {
				<caption class="sr-only">{ locale.T(ctx, "label_recent_changes") }</caption>
				@ui.THead(ui.THeadProps{
					Attrs: templ.Attributes{
						"class": "bg-sand-100 dark:bg-zinc-800",
					},
				}) {
					@ui.Tr(ui.TrProps{}) {
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_event") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_by") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_when") } }
					}
				}
				<tbody>
					if len(auditLog) == 0 {
						@ui.Tr(ui.TrProps{
							Attrs: templ.Attributes{
								"class": "border-sand-300/60 dark:border-zinc-700/60",
							},
						}) {
							@ui.Td(ui.TdProps{
								Attrs: templ.Attributes{
									"colspan": "3",
									"class":   "px-4 text-sand-700",
								},
							}) { { locale.T(ctx, "label_no_changes_yet") } }
						}
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								@ui.Tr(ui.TrProps{
									Attrs: templ.Attributes{
										"class": "border-sand-300/60 dark:border-zinc-700/60",
									},
								}) {
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-medium"}}) { { complianceAuditEventLabel(entry.Event) } }
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) {
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="text-sand-700">—</span>
										}
									}
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700 font-mono text-[11px]"}}) { { entry.EventTime.Format("2 Jan 2006 15:04") } }
								}
							}
						}
					}
				</tbody>
			}
		</div>
	</details>
}

templ frameworkRecentChanges(auditLog []db.ListAuditLogForFrameworkRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="cursor-pointer text-sm font-semibold text-sand-800 dark:text-zinc-200 mb-3 list-none">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		<div class="border border-sand-300/60 dark:border-zinc-700/60 rounded-[10px] overflow-hidden">
			@ui.Table(ui.TableProps{}) {
				<caption class="sr-only">{ locale.T(ctx, "label_recent_changes") }</caption>
				@ui.THead(ui.THeadProps{
					Attrs: templ.Attributes{
						"class": "bg-sand-100 dark:bg-zinc-800",
					},
				}) {
					@ui.Tr(ui.TrProps{}) {
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "px-4 text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_event") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_by") } }
						@ui.Th(ui.ThProps{Attrs: templ.Attributes{"scope": "col", "class": "text-[11px] uppercase tracking-wider"}}) { { locale.T(ctx, "label_when") } }
					}
				}
				<tbody>
					if len(auditLog) == 0 {
						@ui.Tr(ui.TrProps{
							Attrs: templ.Attributes{
								"class": "border-sand-300/60 dark:border-zinc-700/60",
							},
						}) {
							@ui.Td(ui.TdProps{
								Attrs: templ.Attributes{
									"colspan": "3",
									"class":   "px-4 text-sand-700",
								},
							}) { { locale.T(ctx, "label_no_changes_yet") } }
						}
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								@ui.Tr(ui.TrProps{
									Attrs: templ.Attributes{
										"class": "border-sand-300/60 dark:border-zinc-700/60",
									},
								}) {
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "px-4 font-medium"}}) { { complianceAuditEventLabel(entry.Event) } }
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700"}}) {
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="text-sand-700">—</span>
										}
									}
									@ui.Td(ui.TdProps{Attrs: templ.Attributes{"class": "text-sand-700 font-mono text-[11px]"}}) { { entry.EventTime.Format("2 Jan 2006 15:04") } }
								}
							}
						}
					}
				</tbody>
			}
		</div>
	</details>
}
