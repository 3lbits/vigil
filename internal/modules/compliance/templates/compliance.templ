package compliancetemplates

import (
	"fmt"
	"strings"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
	"github.com/3lbits/vigil/internal/ui2"
)

// ── Framework list ──

templ FrameworkList(frameworks []FrameworkVM, expandID, flash, flashType string) {
	@ui2.Page("ui2-compliance") {
	@complianceFlash(flash, flashType)

	<div class="ops-toolbar">
		<p data-testid="framework-count" class="ops-muted">{ locale.TN(ctx, "fw_count", len(frameworks), map[string]any{"Count": len(frameworks)}) }</p>
		<div class="ops-inline">
			<a href="/compliance/frameworks/new" class="ops-button">
				@ui.IconSVG("plus", 13)
				{ locale.T(ctx, "action_add_framework") }
			</a>
		</div>
	</div>

	if len(frameworks) == 0 {
		<div data-testid="no-frameworks-empty" class="ops-card">
			<p class="ops-muted">{ locale.T(ctx, "frameworks_none_yet") }</p>
			<a href="/compliance/frameworks/new" class="ops-link">Add your first framework →</a>
		</div>
	} else {
		<ul class="ops-list">
			for _, fw := range frameworks {
				<li>@frameworkAccordion(fw, expandID)</li>
			}
		</ul>
	}
	}
}

templ frameworkAccordion(fw FrameworkVM, expandID string) {
	<article class="ui2-panel ops-card"
		id={ "fw-" + fw.Framework.ID.String() }
		aria-label={ fw.Framework.Name }
		x-data={ "{ expanded: " + fmt.Sprint(fw.Framework.ID.String() == expandID) + " }" }>
		<div class="ops-inline ops-fill">
			<button
				type="button"
				class="ops-link"
				@click="expanded = !expanded"
				:aria-expanded="expanded ? 'true' : 'false'"
				aria-controls={ "fw-reqs-" + fw.Framework.ID.String() }
			>
				<span
					class="ops-muted"
					:class="expanded ? 'ops-expanded' : ''"
					aria-hidden="true"
				>
					@ui.IconSVG("chevron", 14)
				</span>
				<span >
					<span >
						<strong >{ fw.Framework.Name }</strong>
						if fw.Framework.Version != "" {
							<span class="ops-muted">{ fw.Framework.Version }</span>
						}
						if fw.Framework.NotRelevant {
							@ui2.Badge("neutral") { { locale.T(ctx, "label_not_relevant") } }
						}
					</span>
					<span >
						<span >
							<progress max="100" class="ops-progress" value={ fmt.Sprint(fw.Coverage) } aria-label={ locale.T(ctx, "label_coverage") }>{ fmt.Sprintf("%d%%", fw.Coverage) }</progress>
						</span>
						<span class="ops-muted ops-align-end">{ fmt.Sprintf("%d%%", fw.Coverage) }</span>
					</span>
				</span>
			</button>
			<div class="ops-inline">
				<span class="ops-muted">{ fmt.Sprintf("%d reqs", fw.TotalReqs) }</span>
				<div class="ops-inline">
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String()) }
						class="ops-button">
						Open
					</a>
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/import") }
						class="ops-button">
						@ui.IconSVG("upload", 11)
						{ locale.T(ctx, "action_import") }
					</a>
					<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/edit") }
						class="ops-button">
						{ locale.T(ctx, "action_edit") }
					</a>
					<form method="POST" action={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/delete") }
						onsubmit="return confirm('Delete this framework and all its requirements?')">
						<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
						<button type="submit" data-tone="danger" class="ops-button">
							{ locale.T(ctx, "action_delete") }
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Requirements table (expanded) -->
		<div
			id={ "fw-reqs-" + fw.Framework.ID.String() }
			x-show="expanded"
			:aria-hidden="expanded ? 'false' : 'true'"
			class="ops-separated"
		>
			<header >
				<h2 class="ops-overline">{ locale.T(ctx, "section_requirements") }</h2>
				<a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/new") }
					class="ops-link">
					@ui.IconSVG("plus", 11)
					{ locale.T(ctx, "action_add_requirement") }
				</a>
			</header>
			if len(fw.Requirements) == 0 {
				<p class="ops-muted ops-align-center">
					No requirements yet. <a href={ templ.SafeURL("/compliance/frameworks/" + fw.Framework.ID.String() + "/requirements/import") } class="ops-link">Import from CSV</a> or add manually.
				</p>
			} else {
				@RequirementsTable(fw.Requirements)
			}
		</div>
	</article>
}

templ CoverageBadge(pct int) {
	if pct >= 80 {
		@ui2.Badge("success") { { fmt.Sprintf("%d%%", pct) } }
	} else if pct >= 50 {
		@ui2.Badge("info") { { fmt.Sprintf("%d%%", pct) } }
	} else {
		@ui2.Badge("warning") { { fmt.Sprintf("%d%%", pct) } }
	}
}

templ RequirementsTable(reqs []RequirementVM) {
	@ui2.Table("Requirements") {
		<thead class="ops-table-head">
			<tr>
				<th scope="col" > Ref </th>
				<th scope="col" > Title </th>
				<th scope="col" > Measures </th>
				<th scope="col" class="ops-align-end"> <span class="sr-only">Actions</span> </th>
			</tr>
		</thead>
		<tbody>
			for _, rvm := range reqs {
				<tr >
					<td class="ops-reference"> { rvm.Requirement.Ref } </td>
					<td>
						<a href={ templ.SafeURL("/compliance/requirements/" + rvm.Requirement.ID.String()) } class="ops-link">{ rvm.Requirement.Title }</a>
						if rvm.Requirement.NotRelevant {
							@ui2.Badge("neutral") { { locale.T(ctx, "label_not_relevant") } }
						}
					</td>
					<td>
						if rvm.Requirement.NotRelevant {
							<span class="ops-muted">—</span>
						} else if len(rvm.Measures) == 0 {
							<span class="ops-muted">none</span>
						} else {
							<div class="ops-inline">
								for _, m := range rvm.Measures {
									@measureStatusBadge(m.Status)
								}
							</div>
						}
					</td>
					<td class="ops-align-end">
						<a href={ templ.SafeURL("/compliance/requirements/" + rvm.Requirement.ID.String() + "/edit") }
							aria-label={ "Edit requirement " + rvm.Requirement.Ref + ": " + rvm.Requirement.Title }
							class="ops-link">edit</a>
					</td>
				</tr>
			}
		</tbody>
	}
}

// ── Framework form ──

templ FrameworkForm(fw *db.Framework, flash, flashType string, auditLog []db.ListAuditLogForFrameworkRow) {
	@ui2.Page("ui2-compliance") {
	@complianceFlash(flash, flashType)

	<div class="ops-stack ops-narrow">
		<form method="POST" action={ fwFormAction(fw) } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			@inputField("label_name", "name", "e.g. ISO 27001", fwFieldVal(fw, "name"), true)
			@inputField("label_short_name", "short_name", "e.g. ISO", fwFieldVal(fw, "short_name"), false)
			@inputField("label_version", "version", "e.g. 2022", fwFieldVal(fw, "version"), false)
			@textareaField("label_description", "description", "Optional description", fwFieldVal(fw, "description"))
			<div>
				<label for="framework_type" class="ops-label">{ locale.T(ctx, "label_type") }</label>
				<select id="framework_type" name="framework_type" class="ops-input">
					<option value="regulation" selected?={ fwFieldVal(fw, "framework_type") != "standard" && fwFieldVal(fw, "framework_type") != "directive" }>{ locale.T(ctx, "fw_type_regulation") }</option>
					<option value="standard" selected?={ fwFieldVal(fw, "framework_type") == "standard" }>{ locale.T(ctx, "fw_type_standard") }</option>
					<option value="directive" selected?={ fwFieldVal(fw, "framework_type") == "directive" }>{ locale.T(ctx, "fw_type_directive") }</option>
				</select>
			</div>

			<div class="ops-stack ops-separated">
				<label class="ops-check-label">
					<input type="checkbox" name="not_relevant" value="on" checked?={ fw != nil && fw.NotRelevant }
						class="ops-input"/>
					{ locale.T(ctx, "label_mark_not_relevant") }
				</label>
				@textareaField("label_reason_optional", "not_relevant_reason", "Explain why this framework does not apply", fwFieldVal(fw, "not_relevant_reason"))
			</div>

			<div class="ops-inline">
				<button type="submit">
					if fw == nil {
						{ locale.T(ctx, "action_create_framework") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				</button>
				<a href="/compliance" class="ops-button">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
		if fw != nil {
			@frameworkRecentChanges(auditLog, "ops-spaced")
		}
	</div>
	}
}

func fwFormAction(fw *db.Framework) templ.SafeURL {
	if fw == nil {
		return "/compliance/frameworks"
	}
	return templ.SafeURL("/compliance/frameworks/" + fw.ID.String())
}

func fwFieldVal(fw *db.Framework, field string) string {
	if fw == nil {
		return ""
	}
	switch field {
	case "name":
		return fw.Name
	case "short_name":
		return fw.ShortName
	case "version":
		return fw.Version
	case "description":
		return fw.Description
	case "framework_type":
		return fw.FrameworkType
	case "not_relevant_reason":
		return fw.NotRelevantReason
	}
	return ""
}

// ── Requirement form ──

templ RequirementForm(frameworkID string, req *db.Requirement, flash, flashType string, auditLog []db.ListAuditLogForRequirementRow) {
	@ui2.Page("ui2-compliance") {
		@requirementFormContent(frameworkID, req, flash, flashType, auditLog)
	}
}

templ requirementFormContent(frameworkID string, req *db.Requirement, flash, flashType string, auditLog []db.ListAuditLogForRequirementRow) {
	@complianceFlash(flash, flashType)

	<div class="ops-stack ops-narrow">
		<form method="POST" action={ reqFormAction(frameworkID, req) } class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			@inputField("label_reference", "ref", "e.g. A.5.1 or Art.21", reqFieldVal(req, "ref"), true)
			@inputField("label_title", "title", "Short title of the requirement", reqFieldVal(req, "title"), true)
			@textareaField("label_description", "description", "Optional detailed description", reqFieldVal(req, "description"))
			@inputField("label_sort_order", "sort_order", "0", reqFieldVal(req, "sort_order"), false)

			<div class="ops-stack ops-separated">
				<label class="ops-check-label">
					<input type="checkbox" name="not_relevant" value="on" checked?={ req != nil && req.NotRelevant }
						class="ops-input"/>
					{ locale.T(ctx, "label_mark_not_relevant") }
				</label>
				@textareaField("label_reason_required_if_not_relevant", "not_relevant_reason", "Explain why this requirement does not apply", reqFieldVal(req, "not_relevant_reason"))
			</div>

			<div class="ops-inline">
				<button type="submit">
					if req == nil {
						{ locale.T(ctx, "action_add_requirement") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				</button>
				<a href="/compliance" class="ops-button">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
		if req != nil {
			@requirementRecentChanges(auditLog, "ops-spaced")
		}
	</div>
}

func reqFormAction(frameworkID string, req *db.Requirement) templ.SafeURL {
	if req == nil {
		return templ.SafeURL("/compliance/frameworks/" + frameworkID + "/requirements")
	}
	return templ.SafeURL("/compliance/requirements/" + req.ID.String())
}

func reqFieldVal(req *db.Requirement, field string) string {
	if req == nil {
		return ""
	}
	switch field {
	case "ref":
		return req.Ref
	case "title":
		return req.Title
	case "description":
		return req.Description
	case "sort_order":
		return fmt.Sprint(req.SortOrder)
	case "not_relevant_reason":
		return req.NotRelevantReason
	}
	return ""
}

// ── CSV import form ──

templ ImportForm(frameworkID string, flash, flashType string, result *ImportResult) {
	@ui2.Page("ui2-compliance") {
	@complianceFlash(flash, flashType)

	<div class="ops-stack ops-narrow">
		if result != nil && result.Count > 0 {
			<p role="status" class="ops-success-text">
				{ fmt.Sprintf("✓ Imported %d requirements successfully.", result.Count) }
			</p>
		}
		if result != nil && len(result.Errors) > 0 {
			<section role="alert" class="ops-card">
				<h2 class="ops-heading">Import errors:</h2>
				for _, e := range result.Errors {
					<p class="ops-error">{ e }</p>
				}
			</section>
		}

		<section class="ops-card">
			<h2 class="ops-heading">CSV format</h2>
			<p class="ops-muted">The file must have a header row with these columns:</p>
			<code class="ops-reference">ref, title, description, sort_order</code>
			<p class="ops-muted">Only <code class="ops-reference">ref</code> and <code class="ops-reference">title</code> are required.</p>
		</section>

		<form method="POST" action={ templ.SafeURL("/compliance/frameworks/" + frameworkID + "/requirements/import") } enctype="multipart/form-data" class="ops-form-inline">
			<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
			<div>
				<label for="csv_file" class="ops-label">
					CSV file <span aria-hidden="true" class="ops-error">*</span>
				</label>
				<input type="file" id="csv_file" name="csv_file" accept=".csv,text/csv" required
					class="ops-input ops-file"/>
			</div>
			<div class="ops-inline">
				<button type="submit">
					@ui.IconSVG("upload", 13)
					{ locale.T(ctx, "action_import_requirements") }
				</button>
				<a href="/compliance" class="ops-button">
					{ locale.T(ctx, "action_cancel") }
				</a>
			</div>
		</form>
	</div>
	}
}

// ── Requirement detail ──

templ RequirementDetail(vm RequirementDetailVM) {
	@ui2.Page("ui2-compliance") {
	<div class="ops-toolbar ops-spaced">
		<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Requirement.FrameworkID.String()) } class="ops-link">
			@ui.IconSVG("chevron", 13)
			{ vm.FrameworkShort }
		</a>
		if vm.CanEdit {
			<div class="ops-inline">
				<a href={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/edit") }
					class="ops-button">
					Edit requirement
				</a>
				<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/delete") }
					onsubmit="return confirm('Delete this requirement?')">
					<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
					<button type="submit" data-tone="danger" class="ops-button">
						{ locale.T(ctx, "action_delete") }
					</button>
				</form>
			</div>
		} else {
			<span class="ops-muted" title="You don't have permission to edit">
				Edit requirement
			</span>
		}
	</div>

	<dl class="ops-medium ops-spaced">
		<dt class="ops-muted">Framework</dt>
		<dd class="ops-muted">
			@ui2.Badge("neutral") { { vm.FrameworkShort } }
			<span class="ops-muted">{ vm.FrameworkName }</span>
		</dd>
		<dt class="ops-muted">Reference</dt>
		<dd class="ops-muted ops-reference">{ vm.Requirement.Ref }</dd>
		<dt class="ops-muted">Status</dt>
		<dd>
		if vm.Requirement.NotRelevant {
			@ui2.Badge("neutral") { { locale.T(ctx, "label_not_relevant") } }
		} else {
			@ui2.Badge("success") { Relevant }
		}
		</dd>
		if vm.Requirement.Description != "" {
			<dt class="ops-muted">Description</dt>
			<dd class="ops-muted">{ vm.Requirement.Description }</dd>
		}
		if vm.Requirement.NotRelevant {
			if vm.Requirement.NotRelevantReason != "" {
				<dt class="ops-muted">Reason</dt>
				<dd class="ops-muted">{ vm.Requirement.NotRelevantReason }</dd>
			}
		}
	</dl>

	<section class="ops-separated">
		<h2 class="ops-heading">
			Measures
			<span class="ops-muted">({ fmt.Sprint(len(vm.Measures)) })</span>
		</h2>
		if len(vm.Measures) == 0 {
			<p class="ops-muted">{ locale.T(ctx, "req_none_linked") }</p>
		} else {
			<div class="ops-card">
				@ui2.Table("Linked measures") {
					<thead class="ops-table-head">
						<tr>
							<th scope="col" > Measure </th>
							<th scope="col" > Status </th>
							<th scope="col" > Owner </th>
						</tr>
					</thead>
					<tbody>
						for _, m := range vm.Measures {
							<tr >
								<td >
									<a href={ templ.SafeURL("/measures/" + m.ID.String()) } class="ops-link">{ m.Name }</a>
									if m.Category != "" {
										<p class="ops-muted">{ m.Category }</p>
									}
								</td>
								<td>@measureStatusBadge(m.Status)</td>
								<td > m.Owner </td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
	</section>

	@requirementRecentChanges(vm.AuditLog, "ops-history-separated")
	}
}

func complianceAuditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

// ── Requirement edit page (form + links) ──

templ RequirementEditPage(vm RequirementEditVM, flash, flashType string) {
	@ui2.Page("ui2-compliance") {
		@requirementFormContent(vm.Requirement.FrameworkID.String(), &vm.Requirement, flash, flashType, vm.AuditLog)
		@requirementLinksSection(vm)
	}
}

templ requirementLinksSection(vm RequirementEditVM) {
	<section class="ops-stack ops-narrow ops-spaced">
		<h2 class="ops-heading">{ locale.T(ctx, "label_measures") }</h2>
		if len(vm.LinkedMeasures) == 0 {
			<p class="ops-muted">{ locale.T(ctx, "req_none_linked") }</p>
		} else {
			<div class="ops-card">
				@ui2.Table("Linked measures") {
					<thead class="ops-table-head">
						<tr>
							<th scope="col" > Measure </th>
							<th scope="col" > Status </th>
							<th scope="col" > Owner </th>
							<th scope="col" class="ops-align-end"> <span class="sr-only">Actions</span> </th>
						</tr>
					</thead>
					<tbody>
						for _, m := range vm.LinkedMeasures {
							<tr >
								<td >
									<strong >{ m.Name }</strong>
									if m.Category != "" {
										<p class="ops-muted">{ m.Category }</p>
									}
								</td>
								<td>@measureStatusBadge(m.Status)</td>
								<td > m.Owner </td>
								<td class="ops-align-end">
									<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + vm.Requirement.ID.String() + "/measures/" + m.ID.String() + "/delete") }>
										<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
										<button type="submit" data-tone="danger" aria-label={ "Remove measure " + m.Name } class="ops-danger-link">remove</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
		<div class="ops-stack">
			<label for="measure-link-search" class="ops-label">Search and link measure</label>
			<input id="measure-link-search" type="text" name="q" placeholder="Type measure name..." class="ops-input"
				hx-get={ "/compliance/requirements/" + vm.Requirement.ID.String() + "/measures/search" }
				hx-trigger="input delay:250ms, search"
				hx-target={ "#requirement-measure-search-results-" + vm.Requirement.ID.String() }
				hx-swap="innerHTML"/>
			@RequirementMeasureSearchResults(vm.Requirement.ID.String(), nil, "")
		</div>
	</section>
}

templ RequirementMeasureSearchResults(requirementID string, measures []db.Measure, query string) {
	<div id={ "requirement-measure-search-results-" + requirementID } class="ops-stack">
		if strings.TrimSpace(query) == "" {
			<p class="ops-muted">Start typing to find measures.</p>
		} else if len(measures) == 0 {
			<p class="ops-muted">No matching unlinked measures.</p>
		} else {
			<div class="ops-card">
				@ui2.Table("Measure search results") {
					<tbody>
						for _, m := range measures {
							<tr class="ops-separated">
								<td >
									<strong >{ m.Name }</strong>
									if m.Category != "" {
										<p class="ops-muted">{ m.Category }</p>
									}
								</td>
								<td>@measureStatusBadge(m.Status)</td>
								<td class="ops-align-end">
									<form method="POST" action={ templ.SafeURL("/compliance/requirements/" + requirementID + "/measures") }>
										<input type="hidden" name="_csrf" value={ csrf.TokenFromContext(ctx) }/>
										<input type="hidden" name="measure_id" value={ m.ID.String() }/>
										<button type="submit" class="ops-link">{ locale.T(ctx, "action_link_measure") }</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
	</div>
}

// ── Shared form helpers ──

templ inputField(labelKey, name, placeholder, value string, required bool) {
	<div>
		<label for={ name } class="ops-label">
			{ locale.T(ctx, labelKey) }
			if required {
				<span aria-hidden="true">*</span>
			}
		</label>
		<input id={ name } name={ name } type="text" value={ value } placeholder={ placeholder } required?={ required } class="ops-input"/>
	</div>
}

templ textareaField(labelKey, name, placeholder, value string) {
	<div>
		<label for={ name } class="ops-label">{ locale.T(ctx, labelKey) }</label>
		<textarea id={ name } name={ name } placeholder={ placeholder } rows="3" class="ops-input">{ value }</textarea>
	</div>
}

templ complianceFlash(flash, flashType string) {
	if flash != "" {
		if flashType == "error" {
			<p role="alert" class="ui2-notice ops-muted" data-tone="danger">{ flash }</p>
		} else if flashType == "success" {
			<p role="status" class="ui2-notice ops-muted" data-tone="success">{ flash }</p>
		} else {
			<p role="status" class="ui2-notice ops-muted">{ flash }</p>
		}
	}
}

templ measureStatusBadge(status string) {
	@ui2.Badge(measureStatusTone(status)) {
		switch status {
			case "implemented":
				{ locale.T(ctx, "status_implemented") }
			case "in_progress":
				{ locale.T(ctx, "status_in_progress") }
			case "planned":
				{ locale.T(ctx, "status_planned") }
			case "deprecated":
				{ locale.T(ctx, "status_deprecated") }
			default:
				{ status }
		}
	}
}

func measureStatusTone(status string) string {
	switch status {
	case "implemented":
		return "success"
	case "in_progress":
		return "warning"
	case "deprecated":
		return "danger"
	default:
		return "neutral"
	}
}

// ── Framework detail ──

templ FrameworkDetail(vm FrameworkDetailVM) {
	@ui2.Page("ui2-compliance") {
	<div class="ops-toolbar ops-spaced">
		<a href="/compliance" class="ops-link">
			@ui.IconSVG("chevron", 13)
			Compliance
		</a>
		if vm.CanEdit {
			<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Framework.ID.String() + "/edit") }
				class="ops-button">
				Edit framework
			</a>
		} else {
			<span class="ops-muted" title="You don't have permission to edit">
				Edit framework
			</span>
		}
	</div>

	<dl class="ops-medium ops-spaced">
		<dt class="ops-muted">Type</dt>
		<dd class="ops-muted">{ vm.Framework.FrameworkType }</dd>
		if vm.Framework.Version != "" {
			<dt class="ops-muted">Version</dt>
			<dd class="ops-muted">{ vm.Framework.Version }</dd>
		}
		if vm.Framework.Description != "" {
			<dt class="ops-muted">Description</dt>
			<dd class="ops-muted">{ vm.Framework.Description }</dd>
		}
		<dt class="ops-muted">{ locale.T(ctx, "label_coverage") }</dt>
		<dd class="ops-muted">
			<span class="ops-muted">{ fmt.Sprint(vm.CoveredReqs) } / { fmt.Sprint(len(vm.Requirements)) } requirements covered</span>
			if len(vm.Requirements) > 0 {
				<span >
					<progress max="100" class="ops-progress" value={ fmt.Sprint(int(vm.CoveredReqs * 100 / int64(len(vm.Requirements)))) } aria-label={ locale.T(ctx, "label_coverage") }>{ fmt.Sprintf("%d%%", int(vm.CoveredReqs * 100 / int64(len(vm.Requirements)))) }</progress>
				</span>
			}
		</dd>
	</dl>
	if len(vm.Requirements) > 0 {
		<nav aria-label="Framework sections" class="ops-spaced">
			<span class="ops-overline">Quick links</span>
			<a href="#implementation-mapping" class="ops-button">Implementation mapping</a>
			<a href="#statement-of-applicability" class="ops-button">SOA</a>
		</nav>
	}

	if len(vm.Requirements) > 0 {
		<section id="implementation-mapping" class="ops-separated">
			<h2 class="ops-heading">
				Implementation mapping (requirements → measures)
			</h2>
			<div class="ops-card">
				@ui2.Table("Requirement implementation mapping") {
					<thead class="ops-table-head">
						<tr>
							<th scope="col" > Ref </th>
							<th scope="col" > Requirement </th>
							<th scope="col" > Measures </th>
						</tr>
					</thead>
					<tbody>
						for _, row := range vm.RequirementImplementations {
							<tr >
								<td class="ops-reference"> { row.Requirement.Ref } </td>
								<td>
									<a href={ templ.SafeURL("/compliance/requirements/" + row.Requirement.ID.String()) } class="ops-link">{ row.Requirement.Title }</a>
								</td>
								<td>
									if len(row.Measures) == 0 {
										<span class="ops-muted">No measures linked</span>
									} else {
										<ul class="ops-list">
											for _, m := range row.Measures {
												<li class="ops-list-item">
													<a href={ templ.SafeURL("/measures/" + m.ID.String()) } class="ops-link">{ m.Name }</a>
													@measureStatusBadge(m.Status)
												</li>
											}
										</ul>
									}
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		</section>
	}
	<section id="statement-of-applicability" class="ops-separated">
		<h2 class="ops-heading">
			Statement of applicability (SOA)
			<span class="ops-muted">({ fmt.Sprint(len(vm.Requirements)) })</span>
		</h2>
		if len(vm.Requirements) == 0 {
			<p class="ops-muted">No requirements yet.
				if vm.CanEdit {
					<a href={ templ.SafeURL("/compliance/frameworks/" + vm.Framework.ID.String() + "/requirements/new") } class="ops-link">Add one →</a>
				}
			</p>
		} else {
			<div class="ops-card">
				@ui2.Table("Statement of applicability") {
					<thead class="ops-table-head">
						<tr>
							<th scope="col" > Ref </th>
							<th scope="col" > Requirement </th>
							<th scope="col" > Applicability </th>
							<th scope="col" > Justification </th>
						</tr>
					</thead>
					<tbody>
						for _, req := range vm.Requirements {
							<tr >
								<td class="ops-reference"> { req.Ref } </td>
								<td>
									<a href={ templ.SafeURL("/compliance/requirements/" + req.ID.String()) } class="ops-link">{ req.Title }</a>
									if req.Description != "" {
										<p class="ops-muted ops-truncate">{ req.Description }</p>
									}
								</td>
								<td>
									if req.NotRelevant {
										@ui2.Badge("neutral") { { locale.T(ctx, "label_not_relevant") } }
									} else {
										@ui2.Badge("success") { Relevant }
									}
								</td>
								<td >
									if req.NotRelevant && req.NotRelevantReason != "" {
										{ req.NotRelevantReason }
									} else {
										N/A
									}
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
	</section>
	@frameworkRecentChanges(vm.AuditLog, "ops-history-separated")
	}
}

templ requirementRecentChanges(auditLog []db.ListAuditLogForRequirementRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		<div class="ops-card">
			@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead class="ops-table-head">
					<tr>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_event") } </th>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_by") } </th>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_when") } </th>
					</tr>
				</thead>
				<tbody>
					if len(auditLog) == 0 {
						<tr >
							<td colspan="3" > { locale.T(ctx, "label_no_changes_yet") } </td>
						</tr>
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								<tr >
									<td > { complianceAuditEventLabel(entry.Event) } </td>
									<td >
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="ops-muted">—</span>
										}
									</td>
									<td class="ops-reference"> { entry.EventTime.Format("2 Jan 2006 15:04") } </td>
								</tr>
							}
						}
					}
				</tbody>
			}
		</div>
	</details>
}

templ frameworkRecentChanges(auditLog []db.ListAuditLogForFrameworkRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		<div class="ops-card">
			@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead class="ops-table-head">
					<tr>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_event") } </th>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_by") } </th>
						<th scope="col" class="ops-overline"> { locale.T(ctx, "label_when") } </th>
					</tr>
				</thead>
				<tbody>
					if len(auditLog) == 0 {
						<tr >
							<td colspan="3" > { locale.T(ctx, "label_no_changes_yet") } </td>
						</tr>
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								<tr >
									<td > { complianceAuditEventLabel(entry.Event) } </td>
									<td >
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="ops-muted">—</span>
										}
									</td>
									<td class="ops-reference"> { entry.EventTime.Format("2 Jan 2006 15:04") } </td>
								</tr>
							}
						}
					}
				</tbody>
			}
		</div>
	</details>
}
