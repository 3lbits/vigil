package abouttemplates

import (
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

templ About() {
	@ui2.Page("ui2-about") {
		@ui2.Panel() {
			<h2>{ locale.T(ctx, "about_open_source_badge") }</h2>
			<p>{ locale.T(ctx, "about_intro") }</p>
			<a href="https://github.com/3lbits/vigil" target="_blank" rel="noopener noreferrer">https://github.com/3lbits/vigil</a>
		}

		<section>
			<h2>{ locale.T(ctx, "about_section_includes") }</h2>
			<ul>
				<li>{ locale.T(ctx, "about_include_1") }</li>
				<li>{ locale.T(ctx, "about_include_2") }</li>
				<li>{ locale.T(ctx, "about_include_3") }</li>
				<li>{ locale.T(ctx, "about_include_4") }</li>
				<li>{ locale.T(ctx, "about_include_5") }</li>
				<li>{ locale.T(ctx, "about_include_6") }</li>
			</ul>
			<p>
				{ locale.T(ctx, "about_issues_intro") }
				<a href="https://github.com/3lbits/vigil/issues" target="_blank" rel="noopener noreferrer">https://github.com/3lbits/vigil/issues</a>.
			</p>
		</section>

		<section>
			<h2>{ locale.T(ctx, "about_section_approach") }</h2>
			<ul>
				<li>{ locale.T(ctx, "about_approach_1") }</li>
				<li>{ locale.T(ctx, "about_approach_2") }</li>
				<li>{ locale.T(ctx, "about_approach_3") }</li>
				<li>{ locale.T(ctx, "about_approach_4") }</li>
				<li>{ locale.T(ctx, "about_approach_5") }</li>
			</ul>
			<p>{ locale.T(ctx, "about_approach_closing") }</p>
		</section>

		<section>
			<h2>{ locale.T(ctx, "about_section_security") }</h2>
			<ul>
				<li>
					{ locale.T(ctx, "about_security_1_intro") }
					<a href="https://github.com/3lbits/vigil/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">SECURITY.md</a>.
				</li>
				<li>{ locale.T(ctx, "about_security_2") }</li>
				<li>{ locale.T(ctx, "about_security_3") }</li>
				<li>{ locale.T(ctx, "about_security_4") }</li>
			</ul>
		</section>

		<section>
			<h2>{ locale.T(ctx, "about_section_contributing") }</h2>
			<p>
				{ locale.T(ctx, "about_contributing_1_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">CONTRIBUTING.md</a>.
			</p>
			<p>
				{ locale.T(ctx, "about_contributing_2_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/AGENTS.md" target="_blank" rel="noopener noreferrer">AGENTS.md</a>.
			</p>
		</section>

		@ui2.Panel() {
			<h2>{ locale.T(ctx, "about_section_posture") }</h2>
			<p>
				{ locale.T(ctx, "about_posture_1_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">LICENSE</a>.
				{ locale.T(ctx, "about_posture_1_outro") }
			</p>
			<p>{ locale.T(ctx, "about_posture_2") }</p>
		}
	}
}
