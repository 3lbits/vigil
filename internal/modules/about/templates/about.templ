package abouttemplates

import "github.com/3lbits/vigil/internal/locale"

templ About() {
	<div class="w-full max-w-4xl px-1 sm:px-0">
		<div class="rounded-[10px] border border-sand-300/60 bg-white p-4 sm:p-5">
			<div class="text-[12px] text-sand-700">{ locale.T(ctx, "about_open_source_badge") }</div>
			<p class="mt-3 text-[13px] text-sand-800 leading-relaxed">{ locale.T(ctx, "about_intro") }</p>
			<a href="https://github.com/3lbits/vigil" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-[13px] text-sand-800 underline underline-offset-2 hover:text-sand-900">https://github.com/3lbits/vigil</a>
		</div>

		<section class="mt-6">
			<h2 class="text-[14px] font-semibold text-sand-900">{ locale.T(ctx, "about_section_includes") }</h2>
			<ul class="mt-3 space-y-2 list-disc pl-5 text-[13px] text-sand-800 leading-relaxed">
				<li>{ locale.T(ctx, "about_include_1") }</li>
				<li>{ locale.T(ctx, "about_include_2") }</li>
				<li>{ locale.T(ctx, "about_include_3") }</li>
				<li>{ locale.T(ctx, "about_include_4") }</li>
				<li>{ locale.T(ctx, "about_include_5") }</li>
				<li>{ locale.T(ctx, "about_include_6") }</li>
			</ul>
			<p class="mt-3 text-[13px] text-sand-700 leading-relaxed">
				{ locale.T(ctx, "about_issues_intro") }
				<a href="https://github.com/3lbits/vigil/issues" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-sand-900">https://github.com/3lbits/vigil/issues</a>.
			</p>
		</section>

		<section class="mt-6">
			<h2 class="text-[14px] font-semibold text-sand-900">{ locale.T(ctx, "about_section_approach") }</h2>
			<ul class="mt-3 space-y-2 list-disc pl-5 text-[13px] text-sand-800 leading-relaxed">
				<li>{ locale.T(ctx, "about_approach_1") }</li>
				<li>{ locale.T(ctx, "about_approach_2") }</li>
				<li>{ locale.T(ctx, "about_approach_3") }</li>
				<li>{ locale.T(ctx, "about_approach_4") }</li>
				<li>{ locale.T(ctx, "about_approach_5") }</li>
			</ul>
			<p class="mt-3 text-[13px] text-sand-700 leading-relaxed">{ locale.T(ctx, "about_approach_closing") }</p>
		</section>

		<section class="mt-6">
			<h2 class="text-[14px] font-semibold text-sand-900">{ locale.T(ctx, "about_section_security") }</h2>
			<ul class="mt-3 space-y-2 list-disc pl-5 text-[13px] text-sand-800 leading-relaxed">
				<li>
					{ locale.T(ctx, "about_security_1_intro") }
					<a href="https://github.com/3lbits/vigil/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-sand-900">SECURITY.md</a>.
				</li>
				<li>{ locale.T(ctx, "about_security_2") }</li>
				<li>{ locale.T(ctx, "about_security_3") }</li>
				<li>{ locale.T(ctx, "about_security_4") }</li>
			</ul>
		</section>

		<section class="mt-6">
			<h2 class="text-[14px] font-semibold text-sand-900">{ locale.T(ctx, "about_section_contributing") }</h2>
			<p class="mt-3 text-[13px] text-sand-800 leading-relaxed">
				{ locale.T(ctx, "about_contributing_1_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-sand-900">CONTRIBUTING.md</a>.
			</p>
			<p class="mt-2 text-[13px] text-sand-800 leading-relaxed">
				{ locale.T(ctx, "about_contributing_2_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/AGENTS.md" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-sand-900">AGENTS.md</a>.
			</p>
		</section>

		<section class="mt-6 rounded-[10px] border border-sand-300/60 bg-sand-50 p-4 sm:p-5">
			<h2 class="text-[14px] font-semibold text-sand-900">{ locale.T(ctx, "about_section_posture") }</h2>
			<p class="mt-3 text-[13px] text-sand-800 leading-relaxed">
				{ locale.T(ctx, "about_posture_1_intro") }
				<a href="https://github.com/3lbits/vigil/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-sand-900">LICENSE</a>.
				{ locale.T(ctx, "about_posture_1_outro") }
			</p>
			<p class="mt-2 text-[13px] text-sand-800 leading-relaxed">{ locale.T(ctx, "about_posture_2") }</p>
		</section>
	</div>
}
