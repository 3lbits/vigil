package activitiestemplates

import (
	"database/sql"
	"fmt"
	"strings"
	"github.com/google/uuid"
	"github.com/3lbits/vigil/internal/csrf"
	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui"
	"github.com/3lbits/vigil/internal/ui2"
	formstemplates "github.com/3lbits/vigil/internal/ui2/forms"
)

func activityRef(n sql.NullInt32) string {
	if !n.Valid { return "" }
	return fmt.Sprintf("A-%03d", n.Int32)
}

// ── Status / type helpers ─────────────────────────────────────────────────────

templ statusBadge(status string) {
	switch status {
		case "completed":
			@ui2.Badge("success") { { locale.T(ctx, "status_completed") } }
		case "in_progress":
			@ui2.Badge("info") { { locale.T(ctx, "status_in_progress") } }
		case "overdue":
			@ui2.Badge("danger") { { locale.T(ctx, "status_overdue") } }
		default:
			@ui2.Badge("neutral") { { locale.T(ctx, "status_planned") } }
	}
}

templ recurrenceBadge(recurrence string) {
	if recurrence != "none" {
		<span class="ops-kind">{ locale.T(ctx, "recurrence_" + recurrence) }</span>
	}
}

func recurrenceLabel(r string) string {
	switch r {
	case "monthly":
		return "Monthly"
	case "tertially":
		return "Tertially"
	case "annual":
		return "Annual"
	case "ad_hoc":
		return "Ad-hoc"
	default:
		return ""
	}
}

templ priorityBadge(priority string) {
	switch priority {
		case "high":
			@ui2.Badge("danger") { { locale.T(ctx, "priority_high") } }
		case "low":
			@ui2.Badge("neutral") { { locale.T(ctx, "priority_low") } }
		default:
			@ui2.Badge("warning") { { locale.T(ctx, "priority_medium") } }
	}
}

templ kindBadge(kind string) {
	<span class={ "ops-kind", kindBadgeClass(kind) }>{ locale.T(ctx, "kind_" + kind) }</span>
}

func flashRole(tone string) string {
	if tone == "error" {
		return "alert"
	}
	return "status"
}

func flashTone(tone string) string {
	switch tone {
	case "error":
		return "danger"
	case "success":
		return "success"
	default:
		return "neutral"
	}
}

func kindBadgeClass(kind string) string {
	switch kind {
	case "training":
		return "ops-kind-training"
	case "exercise":
		return "ops-kind-exercise"
	case "assessment":
		return "ops-kind-assessment"
	case "audit":
		return "ops-kind-audit"
	case "remediation":
		return "ops-kind-remediation"
	default:
		return "ops-kind-review"
	}
}

func kindLabel(k string) string {
	switch k {
	case "training":
		return "Training"
	case "exercise":
		return "Exercise"
	case "assessment":
		return "Assessment"
	case "audit":
		return "Audit"
	case "remediation":
		return "Remediation"
	default:
		return "Review"
	}
}

// ── Activity list ─────────────────────────────────────────────────────────────

templ ActivityList(rows []db.FilterActivitiesRow, filter, kind, q, sort, dir string, mine bool, flash, flashType string, hasMore bool, pageSize int32) {
	@ui2.Page("ui2-activities") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-toolbar">
		<p class="ops-muted">{ locale.T(ctx, "nav_activities") }</p>
		@ui2.Link("/activities/new", templ.Attributes{"class": "ops-button"}) {
			@ui.IconSVG("plus", 13)
			{ locale.T(ctx, "action_add_activity") }
		}
	</div>

	@ui2.FilterBar(ui2.FilterBarProps{ID: "activity-filters", Action: "/activities", Target: "#activities-table"}) {
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "sort", "value": sort})
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "dir", "value": dir})
		@ui2.FilterSearch(ui2.FilterSearchProps{
			Value:   q,
			Columns: []string{"label_activity", "label_owner"},
			Action:  "/activities",
			Target:  "#activities-table",
		})
		@ui2.FilterSelect("filter", locale.T(ctx, "filter_all_statuses")) {
			<option value="" selected?={ filter == "" || filter == "all" }>{ locale.T(ctx, "filter_all_statuses") }</option>
			<option value="planned" selected?={ filter == "planned" }>{ locale.T(ctx, "status_planned") }</option>
			<option value="in_progress" selected?={ filter == "in_progress" }>{ locale.T(ctx, "status_in_progress") }</option>
			<option value="overdue" selected?={ filter == "overdue" }>{ locale.T(ctx, "status_overdue") }</option>
			<option value="completed" selected?={ filter == "completed" }>{ locale.T(ctx, "status_completed") }</option>
		}
		@ui2.FilterSelect("kind", locale.T(ctx, "filter_all_kinds")) {
			<option value="" selected?={ kind == "" || kind == "all" }>{ locale.T(ctx, "filter_all_kinds") }</option>
			<option value="training" selected?={ kind == "training" }>{ locale.T(ctx, "kind_training") }</option>
			<option value="exercise" selected?={ kind == "exercise" }>{ locale.T(ctx, "kind_exercise") }</option>
			<option value="assessment" selected?={ kind == "assessment" }>{ locale.T(ctx, "kind_assessment") }</option>
			<option value="audit" selected?={ kind == "audit" }>{ locale.T(ctx, "kind_audit") }</option>
			<option value="remediation" selected?={ kind == "remediation" }>{ locale.T(ctx, "kind_remediation") }</option>
			<option value="review" selected?={ kind == "review" }>{ locale.T(ctx, "kind_review") }</option>
		}
		@ui2.FilterMine(mine, "label_mine_only")
	}

	<div id="activities-table" aria-live="polite" aria-atomic="false">
		@ActivityTable(rows, hasMore, pageSize, filter, kind, q, sort, dir, mine)
	</div>
	}
}

templ ActivityTable(rows []db.FilterActivitiesRow, hasMore bool, pageSize int32, filter, kind, q, sort, dir string, mine bool) {
	if len(rows) == 0 {
		<p>{ locale.T(ctx, "activities_none_found") } @ui2.Link("/activities/new", nil) { Add your first activity → }</p>
	} else {
		@ui2.Table(locale.T(ctx, "nav_activities")) {
					<thead>
						<tr>
							@ui2.SortTh(locale.T(ctx, "label_activity"), "title", ui2.SortState{Col: sort, Dir: dir}, "/activities", "#activities-table", "activity-filters", "ops-sort-heading")
							<th scope="col" >{ locale.T(ctx, "label_measure") }</th>
							@ui2.SortTh(locale.T(ctx, "label_kind"), "kind", ui2.SortState{Col: sort, Dir: dir}, "/activities", "#activities-table", "activity-filters", "ops-sort-heading")
							<th scope="col" >{ locale.T(ctx, "label_priority") }</th>
							<th scope="col" >{ locale.T(ctx, "label_recurrence") }</th>
							@ui2.SortTh(locale.T(ctx, "label_owner"), "owner", ui2.SortState{Col: sort, Dir: dir}, "/activities", "#activities-table", "activity-filters", "ops-sort-heading")
							@ui2.SortTh(locale.T(ctx, "label_due"), "due_date", ui2.SortState{Col: sort, Dir: dir}, "/activities", "#activities-table", "activity-filters", "ops-sort-heading")
							@ui2.SortTh(locale.T(ctx, "label_status"), "status", ui2.SortState{Col: sort, Dir: dir}, "/activities", "#activities-table", "activity-filters", "ops-sort-heading")
							<th scope="col" ><span class="sr-only">{ locale.T(ctx, "label_actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						@ActivityRows(rows, hasMore, pageSize, filter, kind, q, sort, dir, mine)
					</tbody>
		}
	}
}

templ ActivityRows(rows []db.FilterActivitiesRow, hasMore bool, nextOffset int32, filter, kind, q, sort, dir string, mine bool) {
	for _, a := range rows {
		<tr>
			<td >
				<div class="ops-inline">
					if a.RefNum.Valid {
						<span class="ops-reference">{ activityRef(a.RefNum) }</span>
					}
					@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()), templ.Attributes{"class": "ops-link ops-truncate"}) { { a.Title } }
				</div>
			</td>
			<td class="ops-truncate">
				if a.MeasureName == "" {
					<span class="ops-muted">—</span>
				} else {
					{ a.MeasureName }
				}
			</td>
			<td>
				@kindBadge(a.Kind)
			</td>
			<td>
				@priorityBadge(a.Priority)
			</td>
			<td>
				@recurrenceBadge(a.Recurrence)
				if a.Recurrence == "none" {
					<span class="ops-muted">{ locale.T(ctx, "label_one_off") }</span>
				}
			</td>
			<td>
				if a.Owner == "" {
					<span class="ops-muted">—</span>
				} else {
					{ a.Owner }
				}
			</td>
			<td >
				if IsOverdue(a.Status, a.DueDate) && a.Status != "completed" {
					<span class="ops-error"><span aria-hidden="true">⚠ </span>{ FormatDate(a.DueDate) }</span>
				} else {
					<span class="ops-muted">{ FormatDate(a.DueDate) }</span>
				}
			</td>
			<td>
				@statusBadge(a.Status)
			</td>
			<td class="ops-align-end">
				@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()), templ.Attributes{"aria-label": "View activity: " + a.Title, "class": "ops-link"}) { view }
			</td>
		</tr>
	}
	if hasMore {
		<tr id="load-more-row">
			<td colspan="9" class="ops-align-center">
				@ui2.Link(templ.SafeURL("/activities?offset="+fmt.Sprint(nextOffset)+"&filter="+filter+"&kind="+kind+"&q="+q+"&sort="+sort+"&dir="+dir+"&mine="+listMineQueryValue(mine)), templ.Attributes{"hx-get": "/activities", "hx-include": "#activity-filters", "hx-vals": fmt.Sprintf(`{"offset":"%d"}`, nextOffset), "hx-target": "#load-more-row", "hx-swap": "outerHTML", "class": "ops-button"}) { Load more }
			</td>
		</tr>
	}
}

func listMineQueryValue(mine bool) string {
	if mine {
		return "on"
	}
	return ""
}

// ── Activity form (new / edit) ────────────────────────────────────────────────

templ ActivityForm(measures []db.Measure, users []db.User, a *db.GetActivityRow, preselectedMeasureID string, flash, flashType string, auditLog []db.ListAuditLogForActivityRow) {
	@ui2.Page("ui2-activities") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-stack ops-narrow">
		<form method="POST" action={ activityFormAction(a) } class="ops-form-inline">
			@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
			if a == nil {
				@formstemplates.ActivityCreateFields(measures, users, "activity-create", "")
			} else {
				<!-- Measure selector (optional) -->
				<div class="ops-stack">
					<label for="measure_id" class="ops-label">Measure</label>
					@ui2.Select(templ.Attributes{"id": "measure_id", "name": "measure_id", "class": "ops-input"}) {
						<option value="">— none —</option>
						for _, m := range measures {
							<option
								value={ m.ID.String() }
								selected?={ selectedMeasure(a, m.ID.String(), preselectedMeasureID) }
							>{ m.Name }</option>
						}
					}
				</div>

				@activityInputField("Title", "title", "e.g. Annual penetration test", activityFieldVal(a, "title"), true)
				@activityTextareaField("Description", "description", "Optional context or scope", activityFieldVal(a, "description"))

				<div class="ops-fields">
				<!-- Type -->
					<div class="ops-stack">
					<label for="activity_type" class="ops-label">{ locale.T(ctx, "label_type") }</label>
					@ui2.Select(templ.Attributes{"id": "activity_type", "name": "activity_type", "class": "ops-input"}) {
						<option value="one_off" selected?={ activityFieldVal(a, "activity_type") != "recurring" }>{ locale.T(ctx, "label_one_off") }</option>
						<option value="recurring" selected?={ activityFieldVal(a, "activity_type") == "recurring" }>{ locale.T(ctx, "type_recurring") }</option>
					}
					</div>

					<!-- Recurrence -->
					<div class="ops-stack">
					<label for="recurrence" class="ops-label">{ locale.T(ctx, "label_recurrence") }</label>
					@ui2.Select(templ.Attributes{"id": "recurrence", "name": "recurrence", "class": "ops-input"}) {
						<option value="none" selected?={ activityFieldVal(a, "recurrence") == "none" || activityFieldVal(a, "recurrence") == "" }>{ locale.T(ctx, "recurrence_none") }</option>
						<option value="monthly" selected?={ activityFieldVal(a, "recurrence") == "monthly" }>{ locale.T(ctx, "recurrence_monthly") }</option>
						<option value="tertially" selected?={ activityFieldVal(a, "recurrence") == "tertially" }>{ locale.T(ctx, "recurrence_tertially") }</option>
						<option value="annual" selected?={ activityFieldVal(a, "recurrence") == "annual" }>{ locale.T(ctx, "recurrence_annual") }</option>
						<option value="ad_hoc" selected?={ activityFieldVal(a, "recurrence") == "ad_hoc" }>{ locale.T(ctx, "recurrence_ad_hoc") }</option>
					}
					</div>
				</div>

				<div class="ops-fields">
				<!-- Kind -->
					<div class="ops-stack">
					<label for="kind" class="ops-label">{ locale.T(ctx, "label_kind") }</label>
					@ui2.Select(templ.Attributes{"id": "kind", "name": "kind", "class": "ops-input"}) {
						<option value="training" selected?={ activityFieldVal(a, "kind") == "training" }>{ locale.T(ctx, "kind_training") }</option>
						<option value="exercise" selected?={ activityFieldVal(a, "kind") == "exercise" }>{ locale.T(ctx, "kind_exercise") }</option>
						<option value="assessment" selected?={ activityFieldVal(a, "kind") == "assessment" }>{ locale.T(ctx, "kind_assessment") }</option>
						<option value="audit" selected?={ activityFieldVal(a, "kind") == "audit" }>{ locale.T(ctx, "kind_audit") }</option>
						<option value="remediation" selected?={ activityFieldVal(a, "kind") == "remediation" }>{ locale.T(ctx, "kind_remediation") }</option>
						<option value="review" selected?={ activityFieldVal(a, "kind") == "review" || activityFieldVal(a, "kind") == "" }>{ locale.T(ctx, "kind_review") }</option>
					}
					</div>

					<!-- Priority -->
					<div class="ops-stack">
					<label for="priority" class="ops-label">{ locale.T(ctx, "label_priority") }</label>
					@ui2.Select(templ.Attributes{"id": "priority", "name": "priority", "class": "ops-input"}) {
						<option value="low" selected?={ activityFieldVal(a, "priority") == "low" }>{ locale.T(ctx, "priority_low") }</option>
						<option value="medium" selected?={ activityFieldVal(a, "priority") == "medium" || activityFieldVal(a, "priority") == "" }>{ locale.T(ctx, "priority_medium") }</option>
						<option value="high" selected?={ activityFieldVal(a, "priority") == "high" }>{ locale.T(ctx, "priority_high") }</option>
					}
					</div>
				</div>

				@activityAssigneePicker(a, users)

				<div class="ops-stack">
					@activityInputField("Due date", "due_date", "", activityFieldVal(a, "due_date"), false)
				</div>
			}

			<div class="ops-inline">
				@ui2.Button(templ.Attributes{"type": "submit"}) {
					if a == nil {
						{ locale.T(ctx, "action_create_activity") }
					} else {
						{ locale.T(ctx, "action_save_changes") }
					}
				}
				@ui2.Link("/activities", templ.Attributes{"class": "ops-button"}) { { locale.T(ctx, "action_cancel") } }
			</div>
		</form>
		if a != nil {
			@activityRecentChanges(auditLog, "ops-spaced")
		}
	</div>
	}
}

func activityFormAction(a *db.GetActivityRow) templ.SafeURL {
	if a == nil {
		return "/activities"
	}
	return templ.SafeURL("/activities/" + a.ID.String())
}

func activityFieldVal(a *db.GetActivityRow, field string) string {
	if a == nil {
		return ""
	}
	switch field {
	case "title":
		return a.Title
	case "description":
		return a.Description
	case "activity_type":
		return a.ActivityType
	case "recurrence":
		return a.Recurrence
	case "priority":
		return a.Priority
	case "kind":
		return a.Kind
	case "owner":
		return a.Owner
	case "due_date":
		return DateInputVal(a.DueDate)
	case "measure_id":
		if a.MeasureID.Valid {
			return a.MeasureID.UUID.String()
		}
		return ""
	}
	return ""
}

func selectedMeasure(a *db.GetActivityRow, measureID, preselected string) bool {
	if a != nil {
		if !a.MeasureID.Valid {
			return false
		}
		return a.MeasureID.UUID.String() == measureID
	}
	return preselected == measureID
}

templ activityInputField(label, name, placeholder, value string, required bool) {
	<div class="ops-stack">
		<label for={ name } class="ops-label">
			{ label }
			if required {
				<span class="ops-error">*</span>
			}
		</label>
		@ui2.Input(templ.Attributes{"id": name, "name": name, "type": inputType(name), "placeholder": placeholder, "value": value, "required": required, "class": "ops-input"})
	</div>
}

func inputType(name string) string {
	if name == "due_date" {
		return "date"
	}
	return "text"
}

templ activityAssigneePicker(a *db.GetActivityRow, users []db.User) {
	<div
		x-data={ activityAssigneePickerData(a) }
		class="ops-stack"
	>
		<div class="ops-stack">
			<label for="assignee_id" class="ops-label">Assignee (registered user)</label>
			@ui2.Select(templ.Attributes{"id": "assignee_id", "name": "assignee_id", "x-model": "assigneeID", "@change": "if (assigneeID !== '') { owner = $el.options[$el.selectedIndex].dataset.name } else { owner = '' }", "class": "ops-input"}) {
				<option value="">— or enter name below —</option>
				for _, u := range users {
					<option value={ u.ID.String() } data-name={ u.Name } selected?={ activityAssigneeSelected(a, u.ID) }>{ u.Name } ({ u.Email })</option>
				}
			}
		</div>
		<div class="ops-stack">
			<label for="owner" class="ops-label">Owner / free-text name</label>
			@ui2.Input(templ.Attributes{"id": "owner", "name": "owner", "type": "text", "x-model": "owner", ":disabled": "assigneeID !== ''", "value": activityFieldVal(a, "owner"), "placeholder": "e.g. security team", "class": "ops-input"})
		</div>
	</div>
}

func activityAssigneeSelected(a *db.GetActivityRow, id uuid.UUID) bool {
	if a == nil || !a.AssigneeID.Valid {
		return false
	}
	return a.AssigneeID.UUID == id
}

func activityAssigneePickerData(a *db.GetActivityRow) string {
	if a != nil && a.AssigneeID.Valid {
		return fmt.Sprintf(`{ assigneeID: '%s', owner: '%s' }`, a.AssigneeID.UUID.String(), a.Owner)
	}
	return `{ assigneeID: '', owner: '' }`
}

templ activityTextareaField(label, name, placeholder, value string) {
	<div class="ops-stack">
		<label for={ name } class="ops-label">{ label }</label>
		@ui2.Textarea(templ.Attributes{"id": name, "name": name, "placeholder": placeholder, "rows": "3", "class": "ops-input"}) { { value } }
	</div>
}

templ completedByField(users []db.User) {
	<div
		x-data="{ selectedUser: '', completedBy: '' }"
		class="ops-stack"
	>
		@ui2.Input(templ.Attributes{"type": "hidden", "name": "completed_by", ":value": "completedBy"})
		<div class="ops-stack">
			<label for="completed_by_user" class="ops-label">Completed by (registered user)</label>
			@ui2.Select(templ.Attributes{"id": "completed_by_user", "x-model": "selectedUser", "@change": "if (selectedUser !== '') { completedBy = $el.options[$el.selectedIndex].dataset.name } else { completedBy = '' }", "class": "ops-input"}) {
				<option value="">— or enter name below —</option>
				for _, u := range users {
					<option value={ u.ID.String() } data-name={ u.Name }>{ u.Name } ({ u.Email })</option>
				}
			}
		</div>
		<div class="ops-stack">
			<label for="completed_by" class="ops-label">Name / free-text</label>
			@ui2.Input(templ.Attributes{"id": "completed_by", "type": "text", "x-model": "completedBy", ":disabled": "selectedUser !== ''", "placeholder": "Your name or team", "class": "ops-input"})
		</div>
	</div>
}

// ── Activity detail ───────────────────────────────────────────────────────────

templ ActivityDetail(a db.GetActivityRow, canEdit bool, flash, flashType string, users []db.User, auditLog []db.ListAuditLogForActivityRow, linkedRisks []db.Risk, lowMax, highMin int) {
	@ui2.Page("ui2-activities") {
	if flash != "" {
		<p role={ flashRole(flashType) } data-tone={ flashTone(flashType) }>{ flash }</p>
	}

	<div class="ops-toolbar">
		@ui2.Link("/activities", templ.Attributes{"class": "ops-link"}) {
			@ui.IconSVG("chevron", 13)
			Activities
		}
		if canEdit {
			@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()+"/edit"), templ.Attributes{"class": "ops-button"}) {
				Edit activity
			}
		} else {
			<span class="ops-muted" title="You don't have permission to edit">
				Edit activity
			</span>
		}
	</div>

	<div class="ops-stack ops-wide">
		<!-- Header card -->
		<section class="ops-card">
			<header >
				<div>
					<div class="ops-inline">
						@statusBadge(a.Status)
						@kindBadge(a.Kind)
						@priorityBadge(a.Priority)
						@recurrenceBadge(a.Recurrence)
						if a.Recurrence == "none" {
							<span class="ops-muted">{ locale.T(ctx, "label_one_off") }</span>
						}
					</div>
					<h2 class="ops-heading">{ a.Title }</h2>
					if a.MeasureName != "" {
						<p class="ops-muted">Measure: { a.MeasureName }</p>
					}
				</div>
			</header>

			<div class="ops-fields ops-fields-three">
				<dl >
					<dt class="ops-muted">Due date</dt>
					<dd class={ dueDateClass(a.Status) }>{ FormatDate(a.DueDate) }</dd>
				</dl>
				<dl >
					<dt class="ops-muted">Owner</dt>
					<dd>
						if a.Owner == "" {
							<span class="ops-muted">—</span>
						} else {
							{ a.Owner }
						}
					</dd>
				</dl>
				<dl >
					<dt class="ops-muted">Created</dt>
					<dd>{ a.CreatedAt.Format("2 Jan 2006") }</dd>
				</dl>
			</div>

			if a.Description != "" {
				<p class="ops-muted ops-separated">{ a.Description }</p>
			}
		</section>

		<!-- Completion info (if completed) -->
		if a.Status == "completed" {
			<section class="ops-success-panel">
				<h2 class="ops-heading">{ locale.T(ctx, "status_completed") }</h2>
				<div class="ops-fields">
					<dl >
						<dt class="ops-success-text">{ locale.T(ctx, "label_completed_at") }</dt>
						<dd>{ FormatDateTime(a.CompletedAt) }</dd>
					</dl>
					<dl >
						<dt class="ops-success-text">{ locale.T(ctx, "label_completed_by") }</dt>
						<dd>
							if a.CompletedBy == "" {
								<span>—</span>
							} else {
								{ a.CompletedBy }
							}
						</dd>
					</dl>
				</div>
				if a.Notes != "" {
					<div>
						<h3 class="ops-heading">Notes</h3>
						<p class="ops-success-text">{ a.Notes }</p>
					</div>
				}
				if a.EvidenceUrl != "" {
					<div>
						<h3 class="ops-heading">Evidence</h3>
						@ui2.UntrustedLink(a.EvidenceUrl, templ.Attributes{"class": "ops-link ops-break", "target": "_blank", "rel": "noopener noreferrer"}) { { a.EvidenceUrl } }
					</div>
				}
				if canEdit {
					<div>
						<form method="POST" action={ templ.SafeURL("/activities/" + a.ID.String() + "/reopen") } onsubmit="return confirm('Reopen this activity?')">
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
							@ui2.Button(templ.Attributes{"type": "submit", "class": "ops-button"}) {{ locale.T(ctx, "action_reopen") }}
						</form>
					</div>
				}
			</section>
		}

		<!-- Actions -->
		if canEdit && a.Status != "completed" {
			<div x-data="activityComplete" @keydown.escape.window="showComplete = false" class="ops-card">
				<div class="ops-inline">
					if a.Status == "planned" {
						<form method="POST" action={ templ.SafeURL("/activities/" + a.ID.String() + "/start") }>
							@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
							@ui2.Button(templ.Attributes{"type": "submit", "class": "ops-button"}) { { locale.T(ctx, "action_mark_in_progress") } }
						</form>
					}
					@ui2.Button(templ.Attributes{"type": "button", "aria-controls": "complete-form-panel", ":aria-expanded": "showComplete ? 'true' : 'false'", "@click": "toggle()", "class": "ops-confirm"}) { { locale.T(ctx, "action_mark_complete") } }
					<form
						method="POST"
						action={ templ.SafeURL("/activities/" + a.ID.String() + "/delete") }
						onsubmit="return confirm('Delete this activity?')"
						class="ops-form-inline"
					>
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
						@ui2.Button(templ.Attributes{"type": "submit", "data-tone": "danger", "class": "ops-button"}) { { locale.T(ctx, "action_delete") } }
					</form>
				</div>

				<!-- Completion form (toggled) -->
				<div
					id="complete-form-panel"
					x-show="showComplete"
					:aria-hidden="showComplete ? 'false' : 'true'"
					x-cloak
					class="ops-separated ops-spaced"
				>
					<h2 class="ops-heading">{ locale.T(ctx, "section_complete_activity") }</h2>
					<form method="POST" action={ templ.SafeURL("/activities/" + a.ID.String() + "/complete") } class="ops-form-inline">
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "_csrf", "value": csrf.TokenFromContext(ctx)})
						@completedByField(users)
						@activityTextareaField("Notes", "notes", "What was done, any findings…", "")
						@activityInputField("Evidence URL", "evidence_url", "https://… or file path", "", false)
						<div class="ops-inline">
							@ui2.Button(templ.Attributes{"type": "submit", "class": "ops-confirm"}) { { locale.T(ctx, "action_confirm_completion") } }
							@ui2.Button(templ.Attributes{"type": "button", "@click": "showComplete = false", "class": "ops-button"}) { { locale.T(ctx, "action_cancel") } }
						</div>
					</form>
				</div>
			</div>
		}

		@activityRecentChanges(auditLog, "")

		if len(linkedRisks) > 0 {
			<section class="ops-card">
				<h2 class="ops-overline">
					{ locale.T(ctx, "section_linked_risks") } ({ fmt.Sprint(len(linkedRisks)) })
				</h2>
				<ul>
				for i, risk := range linkedRisks {
					<li>
					@ui2.Link(templ.SafeURL("/risks/"+risk.AssessmentID.String()+"/risks/"+risk.ID.String()), templ.Attributes{"class": activityRiskLinkClass(i)}) {
						<span class="ops-muted ops-truncate">{ risk.Name }</span>
						<div class="ops-inline">
							if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
								<div class="ops-risk-score" data-tone={ ui2.Tone(int(risk.LikelihoodCurrent.Int32)*int(risk.ConsequenceCurrent.Int32), lowMax, highMin) }>
									<span>{ fmt.Sprint(int(risk.LikelihoodCurrent.Int32)*int(risk.ConsequenceCurrent.Int32)) }</span>
									<span >now</span>
								</div>
							}
							if risk.LikelihoodTarget.Valid && risk.ConsequenceTarget.Valid {
								<span class="ops-muted">→</span>
								<div class="ops-risk-score" data-tone={ ui2.Tone(int(risk.LikelihoodTarget.Int32)*int(risk.ConsequenceTarget.Int32), lowMax, highMin) }>
									<span>{ fmt.Sprint(int(risk.LikelihoodTarget.Int32)*int(risk.ConsequenceTarget.Int32)) }</span>
									<span >target</span>
								</div>
							}
						</div>
					}
					</li>
				}
				</ul>
			</section>
		}

	</div>
	}
}

func auditEventLabel(event string) string {
	parts := strings.Split(event, ".")
	label := parts[len(parts)-1]
	if label == "" {
		return event
	}
	return strings.ToUpper(label[:1]) + strings.ReplaceAll(label[1:], "_", " ")
}

templ activityRecentChanges(auditLog []db.ListAuditLogForActivityRow, wrapperClass string) {
	<details class={ wrapperClass }>
		<summary class="ops-summary">{ locale.T(ctx, "label_recent_changes_toggle") }</summary>
		@ui2.Table(locale.T(ctx, "label_recent_changes")) {
				<thead>
					<tr>
						<th scope="col">{ locale.T(ctx, "label_event") }</th>
						<th scope="col">{ locale.T(ctx, "label_by") }</th>
						<th scope="col">{ locale.T(ctx, "label_when") }</th>
					</tr>
				</thead>
				<tbody>
					if len(auditLog) == 0 {
						<tr><td colspan="3">{ locale.T(ctx, "label_no_changes_yet") }</td></tr>
					} else {
						for i, entry := range auditLog {
							if i < 5 {
								<tr>
									<td>{ auditEventLabel(entry.Event) }</td>
									<td>
										if entry.UserName != "" {
											{ entry.UserName }
										} else {
											<span class="ops-muted">—</span>
										}
									</td>
									<td>{ entry.EventTime.Format("2 Jan 2006 15:04") }</td>
								</tr>
							}
						}
					}
				</tbody>
		}
	</details>
}

func dueDateClass(status string) string {
	if status == "overdue" {
		return "ops-due-overdue"
	}
	return "ops-due"
}

func activityRiskLinkClass(index int) string {
	if index > 0 {
		return "ops-risk-link ops-risk-next"
	}
	return "ops-risk-link"
}
