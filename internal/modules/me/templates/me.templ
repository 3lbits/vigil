package metemplates

import (
	"fmt"

	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/ui2"
)

type ProfileVM struct {
	Name     string
	Email    string
	Role     string
	Provider string
	OrgName  string
}

type PageVM struct {
	Profile    ProfileVM
	Activities []db.ListOwnedActivitiesRow
	Measures   []db.ListOwnedMeasuresRow
	Risks      []db.ListOwnedRisksRow
}

templ Page(vm PageVM) {
	@ui2.Page("ui2-me") {
		@ui2.Panel() {
			<h2>{ locale.T(ctx, "my_profile_heading") }</h2>
			<dl>
				<dt>{ locale.T(ctx, "label_name") }</dt><dd>{ vm.Profile.Name }</dd>
				<dt>{ locale.T(ctx, "label_email") }</dt><dd>{ vm.Profile.Email }</dd>
				<dt>{ locale.T(ctx, "label_role") }</dt><dd>{ vm.Profile.Role }</dd>
				<dt>{ locale.T(ctx, "my_org_label") }</dt><dd>{ vm.Profile.OrgName }</dd>
				<dt>{ locale.T(ctx, "my_provider_label") }</dt><dd>{ vm.Profile.Provider }</dd>
			</dl>
		}
		@ui2.Grid() {
			@ownedActivitiesCard(vm.Activities)
			@ownedMeasuresCard(vm.Measures)
			@ownedRisksCard(vm.Risks)
		}
	}
}

templ ownedActivitiesCard(rows []db.ListOwnedActivitiesRow) {
	@ui2.Panel() {
		<h2>{ locale.T(ctx, "my_owned_activities_heading") }</h2>
		if len(rows) == 0 {
			<p>{ locale.T(ctx, "my_empty_activities") }</p>
		} else {
			<ul>
				for _, row := range rows {
					<li>
						@ui2.Link(templ.SafeURL("/activities/"+row.ID.String()), nil) { { row.Title } }
						<small>{ row.Status } · { row.Priority }</small>
						if row.MeasureName != "" {
							<small>{ row.MeasureName }</small>
						}
						if row.DueDate != "" {
							<small>{ locale.T(ctx, "my_due_label") }: { row.DueDate }</small>
						}
					</li>
				}
			</ul>
		}
	}
}

templ ownedMeasuresCard(rows []db.ListOwnedMeasuresRow) {
	@ui2.Panel() {
		<h2>{ locale.T(ctx, "my_owned_measures_heading") }</h2>
		if len(rows) == 0 {
			<p>{ locale.T(ctx, "my_empty_measures") }</p>
		} else {
			<ul>
				for _, row := range rows {
					<li>
						@ui2.Link(templ.SafeURL("/measures/"+row.ID.String()), nil) { { row.Name } }
						<small>{ row.Status }</small>
						<small>{ locale.T(ctx, "my_last_changed_label") }: { row.UpdatedAt }</small>
					</li>
				}
			</ul>
		}
	}
}

templ ownedRisksCard(rows []db.ListOwnedRisksRow) {
	@ui2.Panel() {
		<h2>{ locale.T(ctx, "my_owned_risks_heading") }</h2>
		if len(rows) == 0 {
			<p>{ locale.T(ctx, "my_empty_risks") }</p>
		} else {
			<ul>
				for _, row := range rows {
					<li>
						@ui2.Link(templ.SafeURL("/risks/"+row.AssessmentID.String()+"/risks/"+row.ID.String()), nil) { { row.Name } }
						<small>{ fmt.Sprintf("%s #%03d", row.AssessmentName, row.AssessmentRefNum) }</small>
						<small>{ locale.T(ctx, "my_risk_score_label") }: { fmt.Sprint(row.LikelihoodCurrent*row.ConsequenceCurrent) }</small>
						<small>{ locale.T(ctx, "my_last_changed_label") }: { row.UpdatedAt }</small>
					</li>
				}
			</ul>
		}
	}
}
