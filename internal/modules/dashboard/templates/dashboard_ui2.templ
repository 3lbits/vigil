package dashboardtemplates

import (
	"fmt"

	"github.com/3lbits/vigil/internal/db"
	"github.com/3lbits/vigil/internal/locale"
	"github.com/3lbits/vigil/internal/middleware"
	"github.com/3lbits/vigil/internal/ui2"
)

func frameworkFilterAttrs(selected bool) templ.Attributes {
	if selected {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

templ dashboardDecision(decision string) {
	switch decision {
		case "accept":
			@ui2.Badge("success") {
				{ locale.T(ctx, "decision_accept") }
			}
		case "treat":
			@ui2.Badge("info") {
				{ locale.T(ctx, "decision_treat") }
			}
		case "escalate":
			@ui2.Badge("danger") {
				{ locale.T(ctx, "decision_escalate") }
			}
		case "":
			@ui2.Badge("warning") {
				{ locale.T(ctx, "dash_decision_missing") }
			}
		default:
			<span>—</span>
	}
}

templ DashboardUI2(stats Stats, frameworks []FrameworkSummary, frameworkFilter string, frameworkTotal, frameworkRegCount, frameworkStdCount, frameworkDirCount int, recentActivities []db.ListRecentActivitiesRow, myActivities []db.ListActivitiesForUserRow, myMeasures []db.Measure, riskStats RiskStats, flags middleware.ModuleFlags) {
	@ui2.Page("ui2-dashboard") {
		if (flags.ActivitiesEnabled && stats.OverdueActivitiesCount > 0) || (flags.ComplianceEnabled && zeroFrameworkCount(frameworks) > 0) {
			@ui2.Panel() {
				<h2>{ locale.T(ctx, "dash_action_required") }</h2>
				<div class="ui2-dashboard-actions">
					if flags.ActivitiesEnabled && stats.OverdueActivitiesCount > 0 {
						@ui2.Notice("danger") {
							<strong>{ locale.TN(ctx, "label_overdue_count", int(stats.OverdueActivitiesCount), map[string]any{"Count": stats.OverdueActivitiesCount}) }</strong>
							<span>{ locale.T(ctx, "dash_overdue_desc") }</span>
							@ui2.Link("/activities?filter=overdue", nil) {
								{ locale.T(ctx, "action_view") }
							}
						}
					}
					if flags.ComplianceEnabled && zeroFrameworkCount(frameworks) > 0 {
						@ui2.Notice("warning") {
							<strong>{ locale.TN(ctx, "dash_zero_coverage_count", zeroFrameworkCount(frameworks), map[string]any{"Count": zeroFrameworkCount(frameworks), "Total": len(frameworks)}) }</strong>
							<span>{ locale.T(ctx, "dash_zero_coverage_hint") }</span>
							@ui2.Link("/compliance", nil) {
								{ locale.T(ctx, "action_view") }
							}
						}
					}
				</div>
			}
		}
		<div class="ui2-dashboard-metrics">
			if flags.RiskEnabled {
				@ui2.Metric(locale.T(ctx, "dash_kpi_high_risks"), riskStats.RedCount,
					locale.T(ctx, "dash_kpi_of_total", map[string]any{"Total": riskStats.Total}))
			}
			@ui2.Metric(locale.T(ctx, "kpi_requirements_covered"), stats.CoveredRequirementsCount,
				locale.T(ctx, "dash_kpi_coverage", map[string]any{"Total": stats.RequirementsCount, "Pct": stats.CoveredPct()}))
			@ui2.Metric(locale.T(ctx, "dash_kpi_measures_implemented"), stats.ImplementedCount,
				locale.T(ctx, "dash_kpi_of_total", map[string]any{"Total": stats.MeasuresCount}))
		</div>
		if (flags.ActivitiesEnabled && len(myActivities) > 0) || len(myMeasures) > 0 {
			@ui2.Grid() {
				if flags.ActivitiesEnabled {
					@ui2.Panel() {
						<header class="ui2-dashboard-heading">
							<h2>{ locale.T(ctx, "section_my_activities") }</h2>@ui2.Link("/activities", nil) {
	{ locale.T(ctx, "action_view_all") }
}
						</header>
						if len(myActivities) == 0 {
							<p>{ locale.T(ctx, "activities_none_assigned") }</p>
						} else {
							<ul class="ui2-dashboard-list">
								for _, a := range myActivities {
									<li>
										@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()), nil) {
											{ a.Title }
										}
										if a.Status == "overdue" {
											@ui2.Badge("danger") {
												{ locale.T(ctx, "status_overdue") }
											}
										}
										if a.MeasureName != "" {
											<small>{ a.MeasureName }</small>
										}
										if a.DueDate.Valid {
											<time datetime={ a.DueDate.Time.Format("2006-01-02") }>{ formatActivityTime(a.DueDate.Time) }</time>
										}
									</li>
								}
							</ul>
						}
					}
				}
				@ui2.Panel() {
					<header class="ui2-dashboard-heading">
						<h2>{ locale.T(ctx, "section_my_measures") }</h2>@ui2.Link("/measures", nil) {
	{ locale.T(ctx, "action_view_all") }
}
					</header>
					if len(myMeasures) == 0 {
						<p>{ locale.T(ctx, "measures_none_assigned") }</p>
					} else {
						<ul class="ui2-dashboard-list">
							for _, m := range myMeasures {
								<li>
									@ui2.Link(templ.SafeURL("/measures/"+m.ID.String()), nil) {
										{ m.Name }
									}
									if m.Category != "" {
										<small>{ m.Category }</small>
									}
									@ui2.Badge("") {
										{ locale.T(ctx, "status_"+m.Status) }
									}
								</li>
							}
						</ul>
					}
				}
			}
		}
		if flags.RiskEnabled {
			@ui2.Grid() {
				@ui2.Panel() {
					<header class="ui2-dashboard-heading">
						<h2>{ locale.T(ctx, "dash_current_risk_map") }</h2>
						@ui2.Link("/risks", nil) {
							{ locale.T(ctx, "nav_risk_register") }
						}
					</header>
					<form class="ui2-dashboard-filter" method="GET" action="/">
						@ui2.Input(templ.Attributes{"type": "hidden", "name": "framework_type", "value": frameworkFilter})
						<label for="ui2-risk-org">{ locale.T(ctx, "label_organisation") }</label>
						@ui2.Select(templ.Attributes{"id": "ui2-risk-org", "name": "risk_org_id"}) {
							<option value="">{ locale.T(ctx, "dash_risk_org_filter_all") }</option>
							for _, opt := range riskStats.OrgOptions {
								<option value={ opt.ID } selected?={ riskStats.OrgSelected == opt.ID }>{ orgFilterOptionLabel(opt) }</option>
							}
						}
						@ui2.Button(templ.Attributes{"type": "submit"}) {
							{ locale.T(ctx, "action_search") }
						}
					</form>
					if riskStats.OrgName != "" {
						<p>{ locale.T(ctx, "dash_risk_org_filter_selected", map[string]any{"Org": riskStats.OrgName}) }</p>
					}
					if riskStats.Total == 0 {
						<p>
							{ locale.T(ctx, "risk_none_assessed") } @ui2.Link("/risks/new", nil) {
	{ locale.T(ctx, "dash_start_first_assessment") }
}
						</p>
					} else {
						@ui2.Matrix(locale.T(ctx, "dash_current_risk_map"), riskStats.Matrix, riskStats.LowMax, riskStats.HighMin)
						<p class="ui2-legend">
							@ui2.Badge("danger") {
								{ fmt.Sprintf("%s (≥%d)", locale.T(ctx, "risk_level_high"), riskStats.HighMin) }
							}
							@ui2.Badge("warning") {
								{ fmt.Sprintf("%s (%d–%d)", locale.T(ctx, "risk_level_medium"), riskStats.LowMax+1, riskStats.HighMin-1) }
							}
							@ui2.Badge("success") {
								{ fmt.Sprintf("%s (≤%d)", locale.T(ctx, "risk_level_low"), riskStats.LowMax) }
							}
						</p>
					}
					if riskStats.ReviewNeededCount > 0 {
						<section>
							<h3>{ locale.TN(ctx, "dash_risk_reassessment_count", int(riskStats.ReviewNeededCount), map[string]any{"Count": riskStats.ReviewNeededCount}) }</h3>
							<ul>
								for _, item := range riskStats.ReviewQueue {
									<li>
										@ui2.Link(templ.SafeURL("/risks/"+item.AssessmentID+"/risks/"+item.RiskID+"/reassess"), nil) {
											{ item.Name } · { item.AssessmentName }
										}
										if item.HasCurrentScore {
											<data value={ fmt.Sprint(item.CurrentScore) }>{ fmt.Sprint(item.CurrentScore) }</data>
										}
										if item.HasReviewDue {
											<time datetime={ item.ReviewDue.Format("2006-01-02") }>{ item.ReviewDue.Format("2 Jan") }</time>
										}
									</li>
								}
							</ul>
							@ui2.Link("/risks", nil) {
								{ locale.T(ctx, "action_view_all") }
							}
						</section>
					}
				}
				@ui2.Panel() {
					<h2>{ locale.T(ctx, "dash_top_risks_title") }</h2>
					if len(riskStats.TopRisks) == 0 {
						<p>{ locale.T(ctx, "risk_none_scored") }</p>
					} else {
						<ul class="ui2-dashboard-list">
							for _, risk := range riskStats.TopRisks {
								<li>
									<span>
										@ui2.Link(templ.SafeURL("/risks/"+risk.AssessmentID.String()+"/risks/"+risk.ID.String()), nil) {
											{ riskDisplayName(risk.Name, risk.AssessmentName) }
										}
										<small>{ risk.AssessmentName }</small>
									</span>
									<span class="ui2-dashboard-risk-score">
										if risk.LikelihoodCurrent.Valid && risk.ConsequenceCurrent.Valid {
											@ui2.RiskLevel(int(risk.LikelihoodCurrent.Int32*risk.ConsequenceCurrent.Int32), riskStats.LowMax, riskStats.HighMin)
										}
										@dashboardDecision(risk.RiskDecision)
									</span>
								</li>
							}
						</ul>
					}
				}
			}
		}
		if flags.ComplianceEnabled {
			@ui2.Panel() {
				<header class="ui2-dashboard-heading">
					<h2>{ locale.T(ctx, "section_regulations_standards") }</h2>
					@ui2.Link("/compliance", nil) {
						{ locale.T(ctx, "action_view_all") }
					}
				</header>
				<nav aria-label={ locale.T(ctx, "section_regulations_standards") } class="ui2-dashboard-filters">
					@ui2.Link("/", frameworkFilterAttrs(frameworkFilter == "all")) {
						{ locale.T(ctx, "fw_filter_all") } ({ fmt.Sprint(frameworkTotal) })
					}
					if frameworkRegCount > 0 || frameworkFilter == "regulation" {
						@ui2.Link("/?framework_type=regulation", frameworkFilterAttrs(frameworkFilter == "regulation")) {
							{ locale.T(ctx, "dash_filter_regulations") } ({ fmt.Sprint(frameworkRegCount) })
						}
					}
					if frameworkStdCount > 0 || frameworkFilter == "standard" {
						@ui2.Link("/?framework_type=standard", frameworkFilterAttrs(frameworkFilter == "standard")) {
							{ locale.T(ctx, "dash_filter_standards") } ({ fmt.Sprint(frameworkStdCount) })
						}
					}
					if frameworkDirCount > 0 || frameworkFilter == "directive" {
						@ui2.Link("/?framework_type=directive", frameworkFilterAttrs(frameworkFilter == "directive")) {
							{ locale.T(ctx, "dash_filter_directives") } ({ fmt.Sprint(frameworkDirCount) })
						}
					}
				</nav>
				if len(frameworks) == 0 {
					<p data-testid="no-frameworks-message">
						if frameworkTotal == 0 {
							{ locale.T(ctx, "frameworks_none_yet") }
							@ui2.Link("/compliance/frameworks/new", nil) {
								{ locale.T(ctx, "action_add") }
							}
						} else {
							{ locale.T(ctx, "dash_no_frameworks_match") }
							@ui2.Link("/", nil) {
								{ locale.T(ctx, "fw_filter_all") }
							}
						}
					</p>
				} else {
					<ul class="ui2-dashboard-frameworks">
						for _, fw := range frameworks {
							<li data-testid="framework-coverage-row">
								<span>
									@ui2.Link(templ.SafeURL("/compliance?expand="+fw.ID), nil) {
										{ fw.Name }
									}
									<small>
										if fw.Ref != "" {
											{ fw.Ref } ·
										}
										{ locale.TN(ctx, "dash_framework_requirement_count", int(fw.Total), map[string]any{"Count": fw.Total}) }
									</small>
								</span>
								@ui2.CoverageGauge(fw.Name, fw.Coverage)
								<data value={ fmt.Sprint(fw.Coverage) }>{ fmt.Sprintf("%d %%", fw.Coverage) }</data>
							</li>
						}
					</ul>
				}
			}
		}
		if flags.ActivitiesEnabled {
			@ui2.Panel() {
				<details>
					<summary>{ locale.T(ctx, "section_recent_activity") }</summary>
					if len(recentActivities) == 0 {
						<p>
							{ locale.T(ctx, "dash_activities_none_yet") } @ui2.Link("/activities/new", nil) {
	{ locale.T(ctx, "dash_add_one") }
}
						</p>
					} else {
						<ul class="ui2-dashboard-list">
							for _, a := range recentActivities {
								<li>
									@ui2.Link(templ.SafeURL("/activities/"+a.ID.String()), nil) {
										{ a.Title }
									}
									if a.Status == "overdue" {
										@ui2.Badge("danger") {
											{ locale.T(ctx, "status_overdue") }
										}
									} else {
										@ui2.Badge("") {
											{ locale.T(ctx, "status_"+a.Status) }
										}
									}
									if a.MeasureName != "" {
										<small>{ a.MeasureName }</small>
									}
									if a.Owner != "" {
										<small>{ a.Owner }</small>
									}
									<time datetime={ a.UpdatedAt.Format("2006-01-02") }>{ formatActivityTime(a.UpdatedAt) }</time>
								</li>
							}
						</ul>
					}
					<p>@ui2.Link("/activities", nil) {{ locale.T(ctx, "action_view_all") }}</p>
				</details>
			}
		}
	}
}
